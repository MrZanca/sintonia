            SwitchRow { label: T.epg-start; detail: T.epg-start-d; on: true; }
            Rectangle { height: 6px; }
            Field { label: T.useragent; placeholder: T.useragent-ph; }
        }
    }
}

// ───────────── Player con elenco canali (clic destro) ─────────────

component PlayerScreen inherits Rectangle {
    in property <[Channel]> channels;
    in-out property <int> selected;
    callback back();
    callback home();
    callback pip();
    callback toggle-fullscreen();
    property <Channel> c: root.channels[root.selected];
    property <bool> overlay: true;
    property <bool> drawer: false;
    property <int> cursor: 0;
    property <int> category: 0;
    background: #000000;

    function ensure-visible() {
        if (root.cursor * 52px + dl.content-y < 0px) {
            dl.content-y = -root.cursor * 52px;
        } else if ((root.cursor + 1) * 52px + dl.content-y > dl.height) {
            dl.content-y = dl.height - (root.cursor + 1) * 52px;
        }
    }
    function toggle-drawer() {
        root.drawer = !root.drawer;
        if (root.drawer) {
            root.cursor = root.selected;
            root.ensure-visible();
        }
    }
    init => { fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                if (root.drawer) {
                    root.cursor = max(0, root.cursor - 1);
                    root.ensure-visible();
                } else {
                    root.selected = max(0, root.selected - 1);
                    root.overlay = true;
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.drawer) {
                    root.cursor = min(root.channels.length - 1, root.cursor + 1);
                    root.ensure-visible();
                } else {
                    root.selected = min(root.channels.length - 1, root.selected + 1);
                    root.overlay = true;
                }
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.drawer) { root.selected = root.cursor; } else { root.toggle-drawer(); }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.drawer) { root.drawer = false; } else { root.back(); }
                return accept;
            }
            if (event.text == "p" || event.text == "P") {
                root.pip();
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == " ") {
                root.overlay = !root.overlay;
                return accept;
            }
            reject
        }
    }

    // il video; sotto, il segnaposto finché non arriva il primo fotogramma
    Rectangle {
        background: @linear-gradient(160deg, root.c.tint.darker(0.45) 0%, #05060f 80%);
    }
    if !Video.ready && T.status(Video.state) == "": Text {
        text: root.c.num;
        color: #ffffff14;
        font-size: 300px;
        font-weight: 200;
    }
    VideoView { }
    if T.status(Video.state) != "": StatusPill { }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.toggle-drawer();
                fs.focus();
            }
        }
        clicked => {
            if (root.drawer) { root.drawer = false; } else { root.overlay = !root.overlay; }
            fs.focus();
        }
        double-clicked => { root.back(); }
    }

    // in alto a sinistra: indietro e home
    HorizontalLayout {
        x: 36px;
        y: 28px;
        spacing: 10px;
        opacity: root.overlay && !root.drawer ? 1 : 0;
        animate opacity { duration: 200ms; }
        IconBtn { icon: Icons.back; clicked => { root.back(); } }
        IconBtn { icon: Icons.home; clicked => { root.home(); } }
    }
    Text {
        x: 36px;
        y: 88px;
        text: T.hint-video;
        color: #ffffff80;
        font-size: 13px;
        opacity: root.overlay && !root.drawer ? 1 : 0;
        animate opacity { duration: 200ms; }
    }

    // barra in basso
    Rectangle {
        y: parent.height - self.height;
        height: 190px;
        opacity: root.overlay ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(180deg, #00000000 0%, #000000d0 100%);
        HorizontalLayout {
            padding: 40px;
            padding-bottom: 30px;
            spacing: 24px;
            alignment: stretch;
            Text {
                text: root.c.num;
                color: Theme.ink;
                font-size: 56px;
                font-weight: 200;
                vertical-alignment: bottom;
            }
            VerticalLayout {
                alignment: end;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "● " + T.live;
                    color: Theme.live;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: root.c.name + "  ·  " + root.c.now;
                    color: Theme.ink;
                    font-size: 22px;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 14px;
                    Text {
                        text: root.c.start;
                        color: Theme.dim;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Progress { value: root.c.progress; }
                    }
                    Text {
                        text: root.c.end;
                        color: Theme.dim;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: end;
                HorizontalLayout {
                    spacing: 10px;
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                    Btn { label: T.audio; }
                    Btn { label: T.subtitles; }
                    Btn { label: "16:9"; }
                }
            }
        }
    }

    // l'elenco canali che scorre da sinistra
    Rectangle {
        x: root.drawer ? 16px : -self.width - 30px;
        y: 16px;
        width: 540px;
        height: parent.height - 32px;
        animate x { duration: 240ms; easing: ease-out; }
        Sq {
            r: 36px;
            fill: #14151cf4;
            stroke: #ffffff22;
            stroke-width: 1px;
        }
        TouchArea { }
        VerticalLayout {
            padding-top: 26px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            VerticalLayout {
                padding-left: 14px;
                spacing: 8px;
                Title { text: T.channels-title; }
                Tabs {
                    options: T.cats;
                    current <=> root.category;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                dl := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: root.channels.length * 52px;
                    for ch[i] in root.channels: ChannelLine {
                        y: i * 52px;
                        width: dl.width;
                        c: ch;
                        active: i == root.cursor;
                        playing: i == root.selected;
                        clicked => {
                            root.cursor = i;
                            root.selected = i;
                            fs.focus();
                        }
                    }
                }
            }
            Text {
                text: T.hint-list;
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
                height: 44px;
            }
        }
    }
}

// ───────────── Mini player: finestra a parte, sopra le altre applicazioni ─────────────

export component PipWindow inherits Window {
    in property <string> num;
    in property <string> name;
    in property <string> now;
    in property <color> tint: #3b82f6;
    callback expand();
    callback dismiss();
    callback moved(length, length);
    title: "Sintonia mini player";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 360px;
    preferred-height: 203px;
    min-width: 360px;
    max-width: 360px;
    min-height: 203px;
    max-height: 203px;

    Sq { r: 24px; fill: @linear-gradient(145deg, root.tint.darker(0.2) 0%, #090a10 90%); }
    Sq { r: 24px; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    if !Video.ready: Text {
        text: root.name;
        color: #ffffff22;
        font-size: 40px;
        font-weight: 800;
    }
    VideoView { r: 24px; }
    Sq { r: 24px; fill: @linear-gradient(180deg, #00000000 50%, #000000b0 100%); }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
    Rectangle {
        x: 16px;
        y: 14px;
        height: 26px;
        width: pl.preferred-width + 32px;
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        pl := Text {
            x: 24px;
            text: root.num + " · " + root.name;
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
        }
    }
    HorizontalLayout {
        x: root.width - 92px;
        y: 10px;
        width: 80px;
        spacing: 6px;
        alignment: end;
        IconBtn { icon: Icons.expand; size: 34px; clicked => { root.expand(); } }
        IconBtn { icon: Icons.close; size: 34px; clicked => { root.dismiss(); } }
    }
    Text {
        x: 18px;
        y: root.height - self.height - 16px;
        text: root.now;
        color: Theme.ink;
        font-size: 15px;
        font-weight: 600;
    }
}

// ───────────── Finestra principale ─────────────

export component MainWindow inherits Window {
    title: "Sintonia";
    preferred-width: 1320px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 700px;
    background: Theme.bg;
    default-font-family: "Bahnschrift";

    callback request-pip(Channel);
    callback close-pip();
    // il canale da riprodurre è cambiato (Rust aspetta un attimo prima di aprirlo: zapping veloce)
    callback tune(int);
    callback toggle-fullscreen();

    in-out property <int> page <=> Theme.page;
    in-out property <bool> playing: false;
    in-out property <int> selected: 1;
    // c'è un riquadro video sullo schermo (Home, Live o player)
    out property <bool> video-visible: root.playing || root.page <= 1;
    changed selected => { root.tune(root.selected); }
    // aprendo il player si riprende il canale se era fermo (Rust ignora il canale già in onda)
    changed playing => {
        if (root.playing) {
            root.tune(root.selected);
        }
    }

    in property <[Channel]> channels: [
        { num: "001", name: "Canale Uno", tint: #3b82f6, now: "Quiz: La Grande Sfida", start: "20:35", end: "21:40", progress: 0.6, next: "Film: Il Faro d'Inverno", next-time: "21:40", desc: "Sei concorrenti, dieci domande, un montepremi che cresce a ogni risposta giusta.", hd: true, fav: true },
        { num: "002", name: "Canale Due", tint: #8b5cf6, now: "Distretto Nord, ep. 3", start: "20:30", end: "21:30", progress: 0.73, next: "Talk: Fuori Onda", next-time: "21:30", desc: "Un furto in porto riapre un caso chiuso da anni. La squadra si divide.", hd: true },
        { num: "003", name: "Notizie 24", tint: #ef4444, now: "Edizione straordinaria", start: "21:00", end: "21:30", progress: 0.47, next: "Meteo e traffico", next-time: "21:30", desc: "Aggiornamenti in diretta dalla redazione.", hd: true, fav: true },
        { num: "010", name: "Sport Arena", tint: #22c55e, now: "Calcio, campionato: 2° tempo", start: "20:45", end: "22:45", progress: 0.24, next: "Post partita", next-time: "22:45", desc: "Diretta dallo stadio, con commento e statistiche in tempo reale.", hd: true, fav: true },
        { num: "011", name: "Sport Arena 2", tint: #16a34a, now: "Tennis: finale del torneo", start: "20:00", end: "22:00", progress: 0.62, next: "Basket notte", next-time: "22:00", desc: "Il terzo set decide il torneo.", hd: true },
        { num: "020", name: "Cinema Prime", tint: #f59e0b, now: "Film: Codice Aurora", start: "21:00", end: "23:05", progress: 0.11, next: "Film: Onde Corte", next-time: "23:05", desc: "Una crittografa scopre un messaggio nascosto in una vecchia trasmissione radio.", hd: true, fav: true },
        { num: "021", name: "Cinema Classic", tint: #d97706, now: "Film: Mezzanotte a Trieste", start: "20:15", end: "22:10", progress: 0.51, next: "Speciale registi", next-time: "22:10", desc: "Un classico noir in bianco e nero.", fav: true },
        { num: "030", name: "Documenta", tint: #14b8a6, now: "Oceani profondi", start: "21:05", end: "22:00", progress: 0.16, next: "Il pianeta di notte", next-time: "22:00", desc: "Dieci chilometri sotto la superficie.", hd: true },
        { num: "040", name: "Kids Planet", tint: #ec4899, now: "Cartoni: Missione Luna", start: "21:00", end: "21:25", progress: 0.56, next: "Buonanotte storie", next-time: "21:25", desc: "Canale protetto da PIN.", fav: true },
        { num: "050", name: "Musica Live", tint: #a855f7, now: "Concerto in diretta", start: "21:00", end: "23:00", progress: 0.12, next: "Classifica della settimana", next-time: "23:00", desc: "Dal palco, senza pubblicità.", hd: true, fav: true },
        { num: "060", name: "Viaggi HD", tint: #0ea5e9, now: "Islanda in sette giorni", start: "20:50", end: "21:45", progress: 0.44, next: "Strade d'Europa", next-time: "21:45", desc: "Un viaggio tra ghiacciai e vulcani.", hd: true },
        { num: "070", name: "Cucina+", tint: #f97316, now: "Sfida ai fornelli", start: "20:30", end: "21:30", progress: 0.73, next: "Dolci di casa", next-time: "21:30", desc: "Due cuochi, un solo ingrediente." },
        { num: "080", name: "Storia", tint: #78716c, now: "Le grandi esplorazioni", start: "21:00", end: "22:00", progress: 0.23, next: "Archivi segreti", next-time: "22:00", desc: "Le rotte che hanno cambiato la mappa del mondo." },
        { num: "090", name: "Meteo", tint: #64748b, now: "Previsioni nazionali", start: "21:00", end: "21:15", progress: 0.93, next: "Previsioni della notte", next-time: "21:15", desc: "Tempo stabile al nord, nuvole al sud." },
    ];

    in property <[Film]> films: [
        { title: "Codice Aurora", meta: "2024 · 2h 05m · Thriller", rating: "7.4", tint: #1e40af },
        { title: "Il Giardino di Vetro", meta: "2023 · 1h 52m · Dramma", rating: "7.9", tint: #0f766e, progress: 0.62 },
        { title: "Onde Corte", meta: "2022 · 1h 41m · Commedia", rating: "6.8", tint: #c2410c },
        { title: "Mezzanotte a Trieste", meta: "2021 · 1h 58m · Noir", rating: "7.2", tint: #475569 },
        { title: "L'Ultimo Segnale", meta: "2024 · 2h 12m · Fantascienza", rating: "8.1", tint: #6d28d9 },
        { title: "Il Faro d'Inverno", meta: "2020 · 1h 47m · Dramma", rating: "7.0", tint: #0369a1 },
        { title: "Strade di Ferro", meta: "2023 · 2h 20m · Azione", rating: "6.5", tint: #b91c1c },
        { title: "Nord Est", meta: "2022 · 1h 36m · Commedia", rating: "6.9", tint: #a16207 },
        { title: "La Cartografa", meta: "2024 · 1h 55m · Avventura", rating: "7.6", tint: #15803d },
        { title: "Sotto la Pioggia", meta: "2019 · 1h 44m · Romantico", rating: "6.7", tint: #be185d },
    ];

    in property <[Film]> series: [
        { title: "Frequenza Zero", meta: "3 stagioni · Fantascienza", rating: "8.4", tint: #b45309, progress: 0.35 },
        { title: "Distretto Nord", meta: "5 stagioni · Poliziesco", rating: "7.7", tint: #4338ca },
        { title: "Casa Moretti", meta: "2 stagioni · Commedia", rating: "7.0", tint: #be123c },
        { title: "Le Isole", meta: "1 stagione · Dramma", rating: "7.9", tint: #0e7490 },
        { title: "Turno di Notte", meta: "4 stagioni · Medico", rating: "7.3", tint: #334155 },
        { title: "Il Cantiere", meta: "2 stagioni · Thriller", rating: "7.5", tint: #a16207 },
        { title: "Radio Libera", meta: "1 stagione · Storico", rating: "8.0", tint: #7e22ce },
        { title: "Alta Quota", meta: "3 stagioni · Avventura", rating: "6.9", tint: #15803d },
    ];

    in property <[GuideRow]> guide: [
        { num: "001", name: "Canale Uno", progs: [
            { title: "Telegiornale", start: 0, dur: 35 },
            { title: "Quiz: La Grande Sfida", start: 35, dur: 65 },
            { title: "Film: Il Faro d'Inverno", start: 100, dur: 80 } ] },
        { num: "002", name: "Canale Due", progs: [
            { title: "Distretto Nord, ep. 2", start: 0, dur: 30 },
            { title: "Distretto Nord, ep. 3", start: 30, dur: 60 },
            { title: "Talk: Fuori Onda", start: 90, dur: 60 },
            { title: "Notizie", start: 150, dur: 30 } ] },
        { num: "003", name: "Notizie 24", progs: [
            { title: "Notiziario", start: 0, dur: 30 },
            { title: "Approfondimento", start: 30, dur: 30 },
            { title: "Edizione straordinaria", start: 60, dur: 30 },
            { title: "Meteo", start: 90, dur: 15 },
            { title: "Il punto della sera", start: 105, dur: 75 } ] },
        { num: "010", name: "Sport Arena", progs: [
            { title: "Pre partita", start: 0, dur: 45 },
            { title: "Calcio, campionato", start: 45, dur: 120 },
            { title: "Post", start: 165, dur: 15 } ] },
        { num: "020", name: "Cinema Prime", progs: [
            { title: "Prossimamente", start: 0, dur: 15 },
            { title: "Corto d'autore", start: 15, dur: 45 },
            { title: "Film: Codice Aurora", start: 60, dur: 120 } ] },
        { num: "030", name: "Documenta", progs: [
            { title: "Animali in città", start: 0, dur: 65 },
            { title: "Oceani profondi", start: 65, dur: 55 },
            { title: "Il pianeta di notte", start: 120, dur: 60 } ] },
        { num: "050", name: "Musica Live", progs: [
            { title: "Videoclip", start: 0, dur: 60 },
            { title: "Concerto in diretta", start: 60, dur: 120 } ] },
    ];

    in property <[Resume]> resume: [
        { title: "Canale Due", kind: 0, mins: 0, detail: "Distretto Nord", progress: 0.73 },
        { title: "Il Giardino di Vetro", kind: 1, mins: 48, detail: "", progress: 0.62 },
        { title: "Frequenza Zero", kind: 2, mins: 31, detail: "S2 · E4", progress: 0.35 },
    ];

    // il bagliore di sfondo prende il colore della sezione
    if !root.playing: Rectangle {
        x: root.width - 760px;
        y: -380px;
        width: 1100px;
        height: 800px;
        background: @radial-gradient(circle, Theme.base.with-alpha(0.5) 0%, transparent 46%);
    }
    if !root.playing: Rectangle {
        x: -300px;
        y: root.height - 380px;
        width: 900px;
        height: 700px;
        background: @radial-gradient(circle, Theme.base.with-alpha(0.28) 0%, transparent 46%);
    }

    if !root.playing: VerticalLayout {
        TopBar { page <=> root.page; }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.page == 0: HomeScreen {
                channels: root.channels;
                resume: root.resume;
                current: root.selected;
                play(i) => {
                    root.selected = i;
                    root.close-pip();
                    root.playing = true;
                }
                pip(i) => { root.request-pip(root.channels[i]); }
            }
            if root.page == 1: LiveScreen {
                channels: root.channels;
                selected <=> root.selected;
                play => {
                    root.close-pip();
                    root.playing = true;
                }
                pip => { root.request-pip(root.channels[root.selected]); }
            }
            if root.page == 2: GuideScreen { rows: root.guide; }
            if root.page == 3: PosterScreen {
                films: root.films;
                series: root.series;
            }
            if root.page == 4: SettingsScreen { }
        }
        Dock { current <=> root.page; }
    }

    if root.playing: PlayerScreen {
        channels: root.channels;
        selected <=> root.selected;
        back => {
            root.playing = false;
            root.page = 1;
        }
        home => {
            root.playing = false;
            root.page = 0;
        }
        pip => {
            root.request-pip(root.channels[root.selected]);
            root.playing = false;
            root.page = 1;
        }
        toggle-fullscreen => { root.toggle-fullscreen(); }
    }
}
