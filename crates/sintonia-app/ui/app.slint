// Sintonia: interfaccia (dalla bozza grafica v3 approvata).
// Le stringhe sono in inglese con @tr(); le traduzioni stanno in lang/<lingua>/LC_MESSAGES/sintonia-app.po.
// I dati arrivano da Rust: qui non c'è nessun canale.

import { ChannelItem, CategoryItem, SourceItem, TrackItem, SourceStatus, Theme, Video, Texts, Nav, Keys, Press, ChoiceList, Sq, VideoView, Icon, Icons, IconBtn, Btn, Tabs, Title, Ring, Toggle, StatusPill, Logo, EmptyState, CategoryList, HomeItem, PosterItem, EpisodeItem, DetailInfo, NowNext } from "common.slint";
import { MediaScreen } from "media.slint";
import { GuideScreen, GuideRow, DayItem } from "guide.slint";
export { Video, Texts, Nav, Keys, Theme, ChannelItem, CategoryItem, SourceItem, TrackItem, SourceStatus, HomeItem, PosterItem, EpisodeItem, DetailInfo } from "common.slint";
export { GuideRow, GuideBlock, DayItem } from "guide.slint";

// ───────────── Sfondo ─────────────

// La scala della radio: tacche sottili come quelle del menu in basso, una lancetta e un bagliore del
// colore della sezione. `dx`/`dy` la spostano verso il mouse (la scala solo in orizzontale).
component Backdrop inherits Rectangle {
    in property <color> tint;
    in property <length> dx;
    in property <length> dy;
    clip: true;
    Rectangle {
        x: root.width - 700px + root.dx;
        y: -360px + root.dy;
        width: 1000px;
        height: 760px;
        background: @radial-gradient(circle, root.tint.with-alpha(0.38) 0%, transparent 46%);
    }
    Rectangle {
        x: -300px - root.dx * 0.6;
        y: root.height - 380px - root.dy * 0.6;
        width: 900px;
        height: 700px;
        background: @radial-gradient(circle, root.tint.with-alpha(0.2) 0%, transparent 46%);
    }
    Rectangle {
        x: -140px + root.dx * 0.5;
        y: root.height * 0.18;
        width: root.width + 280px;
        height: 120px;
        for i in 130: Rectangle {
            x: i * 14px;
            y: Math.mod(i, 10) == 0 ? 0px : (Math.mod(i, 5) == 0 ? 30px : 50px);
            width: 1px;
            height: Math.mod(i, 10) == 0 ? 120px : (Math.mod(i, 5) == 0 ? 60px : 30px);
            background: Theme.ink.with-alpha(Math.mod(i, 10) == 0 ? 0.07 : 0.04);
        }
        // la lancetta va nel verso opposto: sembra di sintonizzare
        Rectangle {
            x: 140px + root.width * 0.62 - root.dx * 0.8;
            width: 2px;
            height: 120px;
            background: root.tint.brighter(0.9).with-alpha(0.35);
        }
    }
}

// ───────────── Barra in alto e fascia di lancio ─────────────

component TopBar inherits HorizontalLayout {
    in-out property <int> page;
    // cresce quando il fuoco deve andare alla ricerca (tasto «Cerca»)
    in property <int> focus-tick;
    changed focus-tick => { si.focus(); }
    in property <string> clock;
    in-out property <string> search;
    // a schermo intero, accanto all'ingranaggio c'è il pulsante per uscirne
    in property <bool> fullscreen;
    // versione nuova disponibile ("" = nessuna)
    in property <string> update-version;
    callback open-update();
    callback dismiss-update();
    callback search-edited(string);
    callback search-done();
    callback toggle-fullscreen();
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 22px;
    height: 70px;
    spacing: 16px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../assets/logo/sintonia-logo-64.png");
                width: 32px;
                height: 32px;
            }
        }
        Text {
            text: "Sintonia";
            color: Theme.ink;
            font-size: 24px * Theme.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    Rectangle { horizontal-stretch: 1; }
    if root.update-version != "": VerticalLayout {
        alignment: start;
        Rectangle {
            height: 40px;
            width: ul.preferred-width;
            Sq { r: 20px; fill: uta.has-hover ? Theme.base.brighter(0.5) : Theme.base.brighter(0.2); }
            ul := HorizontalLayout {
                padding-left: 18px;
                padding-right: 6px;
                spacing: 10px;
                Text {
                    text: @tr("Sintonia {} is out · Download", root.update-version);
                    color: Theme.ink;
                    font-size: 13px * Theme.text-scale;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        Sq { r: 14px; fill: xta.has-hover ? #00000060 : #00000030; }
                        Icon { commands: Icons.close; width: 12px; height: 12px; }
                        xta := TouchArea { clicked => { root.dismiss-update(); } }
                    }
                }
            }
            // con il telecomando OK apre la pagina (la crocetta resta per il mouse)
            Press { r: 20px; activate => { root.open-update(); } }
            // la zona del testo apre la pagina; la crocetta (sopra) la nasconde
            uta := TouchArea {
                width: parent.width - 40px;
                x: 0;
                clicked => { root.open-update(); }
            }
        }
    }
    Rectangle {
        width: 300px;
        height: 40px;
        Sq {
            r: 20px;
            fill: Theme.glass;
            stroke: si.has-focus ? Theme.ink : transparent;
            stroke-width: 2px;
        }
        Icon { x: 14px; commands: Icons.search; width: 16px; height: 16px; tint: Theme.faint; }
        // i tasti che la casella non usa (Esc, ↓) salgono a questo FocusScope
        FocusScope {
            x: 40px;
            width: parent.width - 54px;
            height: parent.height;
            // raccoglie solo i tasti: il fuoco va alla casella
            focus-on-tab-navigation: false;
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.search = "";
                    root.search-edited("");
                    root.search-done();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.search-done();
                    return accept;
                }
                reject
            }
            si := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.search;
                color: Theme.ink;
                font-size: 14px * Theme.text-scale;
                vertical-alignment: center;
                single-line: true;
                edited => { root.search-edited(self.text); }
                accepted => { root.search-done(); }
                // ↓ passa all'elenco (la casella userebbe il tasto per andare in fondo al testo)
                // con il telecomando, a casella vuota, ← → passano ai pulsanti vicini (l'ingranaggio)
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        root.search-done();
                        return accept;
                    }
                    if (Nav.tv && self.text == "" && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                        Nav.step(event.text == Key.RightArrow);
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.search == "": Text {
            x: 40px;
            text: @tr("Search channels");
            color: Theme.faint;
            font-size: 14px * Theme.text-scale;
        }
    }
    Text {
        text: root.clock;
        color: Theme.ink;
        font-size: 26px * Theme.text-scale;
        font-weight: 300;
        vertical-alignment: center;
    }
    if root.fullscreen: VerticalLayout {
        alignment: start;
        Rectangle {
            width: 40px;
            height: 40px;
            Sq { r: 20px; fill: fta.has-hover ? #ffffff30 : Theme.glass; }
            Icon { commands: Icons.shrink; width: 20px; height: 20px; }
            Press { r: 20px; activate => { root.toggle-fullscreen(); } }
            fta := TouchArea { clicked => { root.toggle-fullscreen(); } }
        }
    }
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 40px;
            height: 40px;
            Sq { r: 20px; fill: root.page == 4 ? Theme.cat(4) : (gta.has-hover ? #ffffff30 : Theme.glass); }
            Icon { commands: Icons.gear; width: 22px; height: 22px; }
            Press { r: 20px; activate => { root.page = 4; } }
            gta := TouchArea { clicked => { root.page = 4; } }
        }
    }
}

// Con il telecomando è il menu: ← → scelgono la voce, OK apre la pagina (o ci entra, se è già
// aperta), ↑ entra nella pagina.
component Dock inherits Rectangle {
    in-out property <int> current;
    in property <[string]> labels;
    out property <bool> focused: fs.has-focus;
    // cresce quando il fuoco deve tornare qui
    in property <int> focus-tick;
    // il fuoco va dentro la pagina aperta
    callback enter();
    forward-focus: fs;
    changed focus-tick => { fs.focus(); }
    property <int> kc;
    height: 88px;
    fs := FocusScope {
        focus-on-click: false;
        focus-gained => { root.kc = min(root.current, root.labels.length - 1); }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.kc = max(0, root.kc - 1); return accept; }
            if (event.text == Key.RightArrow) { root.kc = min(root.labels.length - 1, root.kc + 1); return accept; }
            if (event.text == Key.UpArrow) { root.enter(); return accept; }
            if (event.text == Key.Return || event.text == " ") {
                if (root.kc == root.current) { root.enter(); } else { root.current = root.kc; }
                return accept;
            }
            reject
        }
    }
    property <length> dw: 640px * Theme.grow;
    property <length> sw: root.dw / 4;
    Rectangle {
        width: root.dw + 40px;
        height: 66px;
        y: parent.height - self.height - 14px;
        Sq {
            r: 33px;
            fill: #1b1c26ec;
            stroke: #ffffff1c;
            stroke-width: 1px;
        }
        // scala: dieci intervalli per voce; tacca lunga al centro di ogni voce (dove si ferma la
        // lancetta), media sul confine tra due voci, corte in mezzo
        for i in 41: Rectangle {
            x: 20px + i * root.dw / 40 - 0.5px;
            y: parent.height - self.height - 9px;
            width: 1px;
            height: Math.mod(i, 10) == 5 ? 7px : (Math.mod(i, 10) == 0 ? 4px : 2px);
            background: Math.mod(i, 10) == 5 ? Theme.dim : Theme.faint;
        }
        Rectangle {
            x: 20px + root.current * root.sw + root.sw / 2 - 11px;
            y: parent.height - 13px;
            width: 22px;
            height: 4px;
            border-radius: 2px;
            background: Theme.needle;
            opacity: root.current < 4 ? 1 : 0;
            animate x { duration: 260ms; easing: ease-out; }
        }
        for it[i] in root.labels: Rectangle {
            x: 20px + i * root.sw + 4px;
            y: 8px;
            width: root.sw - 8px;
            height: 38px;
            Sq {
                r: 19px;
                fill: root.current == i ? Theme.cat(i) : (ta.has-hover ? #ffffff14 : transparent);
                stroke: Nav.tv && fs.has-focus && i == root.kc ? Theme.ink : transparent;
                stroke-width: 3px;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                if root.current != i: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.cat(i).brighter(0.7);
                    }
                }
                Text {
                    text: it;
                    color: root.current == i ? Theme.ink : Theme.dim;
                    font-size: 15px * Theme.text-scale;
                    font-weight: root.current == i ? 700 : 400;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea { clicked => { root.current = i; } }
        }
    }
}

// ───────────── Elenchi ─────────────

component ChannelLine inherits Rectangle {
    in property <ChannelItem> c;
    in property <bool> active;
    // il bordo bianco solo se l'elenco ha il fuoco (con il telecomando l'anello è uno solo)
    in property <bool> ring: true;
    in property <bool> playing;
    callback clicked;
    callback activated;
    height: 52px * Theme.grow;
    Sq {
        r: 16px;
        fill: root.active ? #ffffff26 : (ta.has-hover ? #ffffff10 : transparent);
        stroke: root.active && root.ring ? Theme.ink : transparent;
        stroke-width: 2px;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            text: root.c.num;
            width: 46px;
            color: root.playing ? Theme.needle : (root.active ? Theme.ink : Theme.faint);
            // dalle 5 cifre in su più piccolo, se no esce dalla colonna
            font-size: (root.c.num.character-count > 4 ? 15px : 20px) * Theme.text-scale;
            font-weight: 300;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Logo { c: root.c; width: 48px; height: 32px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.c.name;
                color: Theme.ink;
                font-size: 15px * Theme.text-scale;
                font-weight: 600;
                overflow: elide;
            }
            // con la guida: il programma in onda al posto della categoria
            Text {
                text: root.c.now-title != "" ? root.c.now-title : root.c.group;
                color: Theme.dim;
                font-size: 12px * Theme.text-scale;
                overflow: elide;
            }
        }
        Text {
            text: root.playing ? "●" : (root.c.fav ? "★" : "");
            width: 14px;
            color: root.playing ? Theme.live : Theme.needle;
            font-size: (root.playing ? 12px : 14px) * Theme.text-scale;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
}

// Elenco virtualizzato: disegna solo le righe visibili, quindi regge decine di migliaia di canali.
component ChannelList inherits Rectangle {
    in property <[ChannelItem]> model;
    in-out property <int> cursor;
    in property <int> playing-id: -1;
    in property <bool> focused: true;
    callback clicked(int);
    callback activated(int);
    property <length> row-h: (Nav.tv ? 60px : 52px) * Theme.grow;
    property <int> count: root.model.length;
    clip: true;

    public function ensure-visible() {
        if (root.cursor * root.row-h + fl.content-y < 0px) {
            fl.content-y = -root.cursor * root.row-h;
        } else if ((root.cursor + 1) * root.row-h + fl.content-y > fl.height) {
            fl.content-y = fl.height - (root.cursor + 1) * root.row-h;
        }
    }
    // porta la riga del cursore al centro (quando si apre l'elenco)
    public function center() {
        let target = root.cursor * root.row-h - (fl.height - root.row-h) / 2;
        fl.content-y = -max(0px, min(target, root.count * root.row-h - fl.height));
    }
    public function to-top() {
        fl.content-y = 0px;
    }

    fl := Flickable {
        content-height: root.count * root.row-h;
        property <int> first: max(0, floor(-self.content-y / root.row-h));
        property <int> shown: min(root.count, ceil(self.height / root.row-h) + 1);
        for i in fl.shown: ChannelLine {
            property <int> index: fl.first + i;
            x: 0px;
            y: self.index * root.row-h;
            width: fl.width;
            height: root.row-h;
            visible: self.index < root.count;
            c: root.model[self.index];
            active: self.index == root.cursor;
            ring: root.focused;
            playing: root.model[self.index].id == root.playing-id;
            clicked => { root.clicked(self.index); }
            activated => { root.activated(self.index); }
        }
    }
}

// Anteprima del canale: il video vero quando c'è, altrimenti il segnaposto colorato
component Preview inherits Rectangle {
    in property <ChannelItem> c;
    in property <bool> badge: true;
    in property <length> r: 22px;
    in property <bool> live-video: true;
    // al passaggio del mouse la sfumatura chiara scorre dall'angolo in alto a sinistra a quello in
    // basso a destra, poi torna subito al suo posto
    callback clicked;
    property <bool> hover: hover-ta.has-hover;
    property <duration> sweep-start;
    property <bool> sweeping;
    changed hover => {
        if (self.hover && !root.sweeping) {
            root.sweep-start = animation-tick();
            root.sweeping = true;
        }
    }
    Timer {
        interval: 900ms;
        running: root.sweeping;
        triggered => { root.sweeping = false; }
    }
    // da 0 (in alto a sinistra) a 1 (in basso a destra); fermo, al centro come prima
    property <float> sweep: root.sweeping ? min(1, (animation-tick() - root.sweep-start) / 900ms) : 0.5;
    clip: true;
    // sotto a tutto: sente il passaggio del mouse (sopra c'è solo il pulsante del muto)
    hover-ta := TouchArea { clicked => { root.clicked(); } }
    Sq { r: root.r; fill: @linear-gradient(145deg, root.c.tint.darker(0.2) 0%, #090a10 90%); }
    Rectangle {
        x: (root.sweep - 0.5) * root.width * 1.4;
        y: (root.sweep - 0.5) * root.height * 1.4;
        Sq { r: root.r; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    }
    if !(root.live-video && (Video.ready || Texts.status(Video.state, Video.attempt) != "")): Logo {
        c: root.c;
        width: min(parent.width * 0.4, 220px);
        height: self.width * 0.6;
        r: 16px;
    }
    if root.live-video: VideoView { r: root.r; }
    Sq { r: root.r; fill: @linear-gradient(180deg, #00000000 55%, #000000b0 100%); }
    if root.live-video && Texts.status(Video.state, Video.attempt) != "": StatusPill { small: true; }
    if root.live-video && (Video.ready || Video.state != 0): IconBtn {
        x: parent.width - self.width - 12px;
        y: 12px;
        size: 34px;
        icon: Video.muted ? Icons.muted : Icons.sound;
        // con il telecomando da ← → si va dritti ai pulsanti sotto l'anteprima
        tab-stop: false;
        clicked => { Video.toggle-mute(); }
    }
    if root.badge: Rectangle {
        x: 16px;
        y: 16px;
        height: 26px;
        width: lt.preferred-width + 30px;
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        lt := Text {
            x: 24px;
            text: @tr("On air") + " · " + root.c.num;
            color: Theme.ink;
            font-size: 12px * Theme.text-scale;
            font-weight: 600;
        }
    }
    Text {
        x: 18px;
        y: parent.height - self.height - 16px;
        width: parent.width - 36px;
        text: root.c.name;
        color: Theme.ink;
        font-size: 16px * Theme.text-scale;
        font-weight: 600;
        overflow: elide;
    }
}

// ───────────── Home ─────────────

// Miniatura di una voce della Home: locandina (già ritagliata da Rust) o logo del canale
component HomeThumb inherits Rectangle {
    in property <HomeItem> item;
    Sq { r: 12px; fill: root.item.kind == 0 ? #ffffff12 : root.item.tint.darker(0.3); }
    if root.item.has-image: Image {
        x: root.item.kind == 0 ? parent.width * 0.12 : 0px;
        y: root.item.kind == 0 ? parent.height * 0.2 : 0px;
        width: root.item.kind == 0 ? parent.width * 0.76 : parent.width;
        height: root.item.kind == 0 ? parent.height * 0.6 : parent.height;
        source: root.item.image;
        image-fit: root.item.kind == 0 ? ImageFit.contain : ImageFit.fill;
    }
    if !root.item.has-image && root.item.kind == 0: Text {
        text: root.item.num;
        color: #ffffffb0;
        font-size: 18px * Theme.text-scale;
        font-weight: 300;
    }
}

// Una riga orizzontale scorrevole di schede
component HomeRow inherits Rectangle {
    in property <[HomeItem]> model;
    in property <length> card-w: 290px;
    in property <bool> resume;
    out property <bool> focused: fs.has-focus;
    callback open(int);
    forward-focus: fs;
    property <length> gap: 14px;
    // la scheda evidenziata con le frecce
    property <int> kc;
    clip: true;
    function show(i: int) {
        root.kc = max(0, min(root.model.length - 1, i));
        let left = root.kc * (root.card-w + root.gap);
        if (left + fl.content-x < 0px) {
            fl.content-x = -left;
        } else if (left + root.card-w + fl.content-x > fl.width) {
            fl.content-x = fl.width - left - root.card-w;
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        focus-gained => { root.show(root.kc); }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.show(root.kc - 1); return accept; }
            if (event.text == Key.RightArrow) { root.show(root.kc + 1); return accept; }
            if (event.text == Key.Return && root.model.length > 0) { root.open(root.kc); return accept; }
            reject
        }
    }
    fl := Flickable {
        content-width: root.model.length * (root.card-w + root.gap);
        for item[i] in root.model: Rectangle {
            x: i * (root.card-w + root.gap);
            width: root.card-w;
            height: root.height;
            Sq { r: 22px; fill: @linear-gradient(135deg, Theme.panel.brighter(0.25) 0%, Theme.panel 100%); }
            HorizontalLayout {
                padding: 12px;
                spacing: 14px;
                HomeThumb {
                    item: item;
                    width: item.kind == 0 ? 76px : (root.height - 24px) * 2 / 3;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: item.title;
                        color: Theme.ink;
                        font-size: 16px * Theme.text-scale;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: item.subtitle;
                        color: Theme.dim;
                        font-size: 12px * Theme.text-scale;
                        overflow: elide;
                    }
                    if root.resume && item.progress > 0: Rectangle {
                        height: 4px;
                        Sq { r: 2px; fill: #ffffff2a; }
                        Sq {
                            x: 0px;
                            width: max(4px, parent.width * min(1.0, item.progress));
                            height: parent.height;
                            r: 2px;
                            fill: Theme.needle;
                        }
                    }
                }
            }
            Ring { on: ta.has-hover || (Nav.tv && fs.has-focus && i == root.kc); }
            ta := TouchArea { clicked => { root.open(i); } }
        }
    }
}

// Le categorie della Home, in fila (poche: un `for` basta)
component HomeCats inherits Rectangle {
    in property <[CategoryItem]> model;
    out property <bool> focused: fs.has-focus;
    callback open(int);
    forward-focus: fs;
    property <int> kc;
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.kc = max(0, root.kc - 1); return accept; }
            if (event.text == Key.RightArrow) { root.kc = min(root.model.length - 1, root.kc + 1); return accept; }
            if (event.text == Key.Return && root.model.length > 0) { root.open(root.kc); return accept; }
            reject
        }
    }
    HorizontalLayout {
        spacing: 14px;
        alignment: start;
        for c[i] in root.model: Rectangle {
            width: 200px;
            Sq { r: 22px; fill: Theme.glass; }
            VerticalLayout {
                padding-left: 18px;
                padding-right: 14px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: Texts.category(c);
                    color: Theme.ink;
                    font-size: 15px * Theme.text-scale;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Texts.channels(c.count);
                    color: Theme.dim;
                    font-size: 12px * Theme.text-scale;
                }
            }
            if c.locked: Icon {
                x: parent.width - self.width - 16px;
                y: 14px;
                commands: Icons.lock;
                width: 16px;
                height: 16px;
                tint: Theme.dim;
            }
            Ring { on: fta.has-hover || (Nav.tv && fs.has-focus && i == root.kc); }
            fta := TouchArea { clicked => { root.open(i); } }
        }
    }
}

component HomeScreen inherits Rectangle {
    in property <ChannelItem> hero;
    in property <bool> has-hero;
    in property <bool> no-source;
    in property <[CategoryItem]> categories;
    // indice nella lista completa della prima categoria mostrata qui
    in property <int> top-offset: 2;
    in property <[HomeItem]> resume;
    in property <[HomeItem]> favorites;
    // cresce quando il fuoco deve tornare qui (dal menu in basso o dalla ricerca)
    in property <int> focus-tick;
    callback play();
    callback pip();
    // indice nella lista completa delle categorie (0 è «Tutti»)
    callback open-category(int);
    callback open-resume(int);
    callback open-favorite(int);
    callback add-source();
    property <bool> first-use: root.resume.length == 0 && root.favorites.length == 0;

    if root.no-source: EmptyState {
        icon: Icons.plus;
        title: @tr("Welcome to Sintonia");
        body: @tr("Sintonia doesn't provide channels: add your own M3U playlist or Xtream Codes account to start.");
        action: @tr("Add a source");
        act => { root.add-source(); }
    }
    // raccoglie le frecce che le righe non usano: ↑ ↓ passano da una riga all'altra
    if !root.no-source: hk := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        property <int> tick: root.focus-tick;
        init => { watch.focus(); }
        changed tick => { watch.focus(); }
        function first-row() -> bool {
            if (rr.visible) {
                rr.focus();
                return true;
            }
            if (fr.visible) {
                fr.focus();
                return true;
            }
            if (cr.visible) {
                cr.focus();
                return true;
            }
            return false;
        }
        key-pressed(event) => {
            if (watch.focused || pip-btn.focused) {
                if (event.text == Key.RightArrow) { pip-btn.focus(); return accept; }
                if (event.text == Key.LeftArrow) { watch.focus(); return accept; }
                if (event.text == Key.DownArrow) { return self.first-row() ? accept : reject; }
            }
            if (event.text == Key.UpArrow) {
                if (rr.focused || cr.focused) { watch.focus(); return accept; }
                if (fr.focused) {
                    if (rr.visible) { rr.focus(); } else { watch.focus(); }
                    return accept;
                }
            }
            if (event.text == Key.DownArrow && rr.focused && fr.visible) {
                fr.focus();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding-left: 44px;
            padding-right: 44px;
            padding-top: 6px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 34px;
                alignment: start;
                height: 262px * Theme.grow;
                Rectangle {
                    width: 466px;
                    // sotto l'anteprima, così il suo pulsante muto riceve i clic
                    hta := TouchArea { clicked => { root.play(); } }
                    Preview { c: root.hero; clicked => { root.play(); } }
                }
                VerticalLayout {
                    width: 440px;
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: @tr("On now");
                        color: Theme.dim;
                        font-size: 14px * Theme.text-scale;
                    }
                    Text {
                        text: root.hero.name;
                        color: Theme.ink;
                        font-size: 36px * Theme.text-scale;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.hero.group;
                        color: Theme.ink;
                        font-size: 18px * Theme.text-scale;
                    }
                    if root.hero.now-title != "": Rectangle { height: 4px; }
                    if root.hero.now-title != "": NowNext { c: root.hero; bar-width: 300px; label: false; }
                    Text {
                        text: @tr("Channel {}", root.hero.num);
                        color: Theme.dim;
                        font-size: 13px * Theme.text-scale;
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        watch := Btn { label: @tr("Watch"); primary: true; clicked => { root.play(); } }
                        pip-btn := IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                    }
                }
            }
            // le righe restano (nascoste e alte zero quando sono vuote) per poterle chiamare per nome
            if root.resume.length > 0: Rectangle { height: 8px; }
            if root.resume.length > 0: Title { text: @tr("Continue watching"); }
            rr := HomeRow {
                visible: root.resume.length > 0;
                height: self.visible ? 120px * Theme.grow : 0px;
                model: root.resume;
                resume: true;
                open(i) => { root.open-resume(i); }
            }
            if root.favorites.length > 0: Rectangle { height: 6px; }
            if root.favorites.length > 0: Title { text: @tr("Favorites"); }
            fr := HomeRow {
                visible: root.favorites.length > 0;
                height: self.visible ? 96px * Theme.grow : 0px;
                card-w: 240px;
                model: root.favorites;
                open(i) => { root.open-favorite(i); }
            }
            // al primo uso, finché Riprendi e Preferiti sono vuoti, le categorie
            if root.first-use: Rectangle { height: 12px; }
            if root.first-use: Title { text: @tr("Categories"); }
            // le categorie della Home sono quelle della lista completa dopo «Tutti», «Preferiti»
            // e la categoria personalizzata
            cr := HomeCats {
                visible: root.first-use;
                height: self.visible ? 84px * Theme.grow : 0px;
                model: root.categories;
                open(i) => { root.open-category(i + root.top-offset); }
            }
        }
    }
}

// ───────────── Live ─────────────

// Muto e volume: la barra verticale compare sopra il pulsante passandoci con il mouse (o quando il
// pulsante ha il fuoco: allora ↑ ↓ cambiano il volume). Si trascina, si clicca o si usa la rotellina.
component VolumeBtn inherits Rectangle {
    out property <bool> hovered: btn.hovered || bar-ta.has-hover;
    out property <bool> focused: press.has-focus;
    out property <bool> dragging: bar-ta.pressed;
    forward-focus: press;
    width: 38px;
    height: 38px;
    property <bool> open: self.hovered || self.focused || self.dragging;
    function step(delta: int) {
        Video.set-volume(max(0, min(100, Video.volume + delta)));
    }
    btn := IconBtn {
        icon: Video.muted || Video.volume == 0 ? Icons.muted : Icons.sound;
        size: 38px;
        tab-stop: false;
        clicked => { Video.toggle-mute(); }
    }
    press := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.step(5); return accept; }
            if (event.text == Key.DownArrow) { root.step(-5); return accept; }
            if (event.text == Key.Return || event.text == " ") { Video.toggle-mute(); return accept; }
            reject
        }
        if Nav.tv && press.has-focus: Sq {
            x: -5px;
            y: -5px;
            width: root.width + 10px;
            height: root.height + 10px;
            r: 24px;
            stroke: Theme.ink;
            stroke-width: 3px;
        }
    }
    // la barra, sopra il pulsante; la sua zona sensibile arriva fino al pulsante, così passando
    // dall'uno all'altra non si chiude
    if root.open: Rectangle {
        x: (root.width - self.width) / 2;
        y: -self.height - 2px;
        width: 46px;
        height: 170px;
        Sq { r: 23px; fill: #14151cf0; stroke: #ffffff22; stroke-width: 1px; }
        Text {
            y: 10px;
            text: Video.muted ? "0" : Video.volume;
            color: Theme.ink;
            font-size: 12px * Theme.text-scale;
            font-weight: 600;
            horizontal-alignment: center;
            width: parent.width;
        }
        track := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 34px;
            width: 6px;
            height: parent.height - 50px;
            Sq { r: 3px; fill: #ffffff2a; }
            Sq {
                y: parent.height - self.height;
                width: parent.width;
                height: Video.muted ? 0px : parent.height * Video.volume / 100;
                r: 3px;
                fill: Theme.needle;
            }
        }
    }
    bar-ta := TouchArea {
        x: (root.width - 46px) / 2;
        y: -172px;
        width: root.open ? 46px : 0px;
        height: 172px;
        function set-from(y: length) {
            // la barra va da 34 px a 154 px dall'alto del riquadro (che parte 2 px sopra)
            let top = 34px;
            let len = 120px;
            Video.set-volume(round(max(0, min(1, 1 - (y - top) / len)) * 100));
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set-from(self.mouse-y); }
        }
        moved => {
            if (self.pressed) { self.set-from(self.mouse-y); }
        }
        scroll-event(e) => {
            root.step(e.delta-y > 0 ? 5 : -5);
            accept
        }
    }
}

// Pulsante rotondo con un simbolo, acceso o spento (preferito, «I miei canali»)
component MarkBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> on;
    // da acceso il simbolo è pieno (la stella)
    in property <bool> solid;
    callback clicked;
    forward-focus: press;
    width: 38px;
    height: 38px;
    Sq { r: 19px; fill: root.on ? Theme.ink : (ta.has-hover ? #ffffff30 : Theme.glass); }
    Icon {
        commands: root.icon;
        width: 18px;
        height: 18px;
        tint: root.on ? Theme.bg : Theme.ink;
        fill: root.on && root.solid ? Theme.bg : transparent;
    }
    press := Press { r: 19px; activate => { root.clicked(); } }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component LiveScreen inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <int> category;
    in property <string> search;
    in-out property <int> cursor;
    in property <int> playing-id;
    in property <bool> no-source;
    callback play(int);
    callback pip(int);
    callback pick-category(int);
    callback cursor-moved(int);
    callback add-source();
    callback toggle-fav(int);
    callback toggle-custom(int);
    // cambia quando la ricerca in alto passa il controllo all'elenco
    in property <int> focus-tick;
    // cambia quando l'elenco deve mostrare al centro il canale in riproduzione
    in property <int> reveal-tick;
    property <ChannelItem> cur: root.channels[root.cursor];

    changed focus-tick => { fs.focus(); }
    changed reveal-tick => { list.center(); }
    function move(delta: int) {
        if (root.channels.length == 0) { return; }
        root.cursor = max(0, min(root.channels.length - 1, root.cursor + delta));
        list.ensure-visible();
        root.cursor-moved(root.cursor);
    }
    init => { fs.focus(); }
    changed category => { list.to-top(); }
    changed search => { list.to-top(); }

    if root.no-source: EmptyState {
        icon: Icons.plus;
        title: @tr("No source yet");
        body: @tr("Add your M3U playlist or Xtream Codes account in Settings to see your channels here.");
        action: @tr("Add a source");
        act => { root.add-source(); }
    }
    HorizontalLayout {
        visible: !root.no-source;
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 8px;
        spacing: 24px;
        VerticalLayout {
            width: 230px;
            spacing: 10px;
            Title { text: @tr("Categories"); }
            CategoryList {
                vertical-stretch: 1;
                model: root.categories;
                current: root.category;
                searching: root.search != "";
                picked(i) => {
                    root.pick-category(i);
                    fs.focus();
                }
            }
        }
        VerticalLayout {
            width: 440px;
            spacing: 10px;
            Title {
                text: root.search != "" ? @tr("Results for “{}”: {}", root.search, root.channels.length)
                    : Texts.channels(root.channels.length);
            }
            fs := FocusScope {
                vertical-stretch: 1;
                enabled: !root.no-source;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) { root.move(-1); return accept; }
                    if (event.text == Key.DownArrow) { root.move(1); return accept; }
                    if (event.text == Key.PageUp) { root.move(-10); return accept; }
                    if (event.text == Key.PageDown) { root.move(10); return accept; }
                    if (event.text == Key.Return && root.channels.length > 0) { root.play(root.cursor); return accept; }
                    if (Keys.is(5, event.text) && root.channels.length > 0) { root.toggle-fav(root.cursor); return accept; }
                    reject
                }
                list := ChannelList {
                    width: parent.width;
                    height: parent.height;
                    model: root.channels;
                    cursor <=> root.cursor;
                    playing-id: root.playing-id;
                    focused: !Nav.tv || fs.has-focus;
                    clicked(i) => {
                        root.cursor = i;
                        root.cursor-moved(i);
                        fs.focus();
                    }
                    activated(i) => {
                        root.cursor = i;
                        root.play(i);
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 6px;
            if root.channels.length > 0: Preview {
                height: 250px;
                c: root.cur;
                live-video: root.cur.id == root.playing-id;
            }
            if root.channels.length > 0: Rectangle { height: 10px; }
            if root.channels.length > 0: Text {
                text: root.cur.name;
                color: Theme.ink;
                font-size: 30px * Theme.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.channels.length > 0: Text {
                text: root.cur.group;
                color: Theme.dim;
                font-size: 15px * Theme.text-scale;
            }
            if root.channels.length > 0 && root.cur.now-title != "": Rectangle { height: 6px; }
            if root.channels.length > 0 && root.cur.now-title != "": NowNext {
                c: root.cur;
                bar-width: 320px;
                title-size: 17px;
            }
            if root.cur.drm && root.channels.length > 0: Text {
                text: @tr("This channel declares a DRM protection: it may not play.");
                color: Theme.faint;
                font-size: 13px * Theme.text-scale;
                wrap: word-wrap;
            }
            if root.channels.length > 0: Rectangle { height: 12px; }
            if root.channels.length > 0: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Btn { label: @tr("Watch"); primary: true; clicked => { root.play(root.cursor); } }
                IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(root.cursor); } }
                MarkBtn {
                    icon: Icons.star;
                    solid: true;
                    on: root.cur.fav;
                    clicked => { root.toggle-fav(root.cursor); }
                }
                MarkBtn {
                    icon: Icons.lock;
                    on: root.cur.custom;
                    clicked => { root.toggle-custom(root.cursor); }
                }
            }
            if root.channels.length == 0 && root.search != "": Text {
                text: @tr("No channels match your search.");
                color: Theme.dim;
                font-size: 15px * Theme.text-scale;
            }
            // 2: la categoria personalizzata
            if root.channels.length == 0 && root.search == "" && root.category == 2: Text {
                text: @tr("No channels here yet: choose a channel in another category and press the lock button.");
                color: Theme.dim;
                font-size: 15px * Theme.text-scale;
                wrap: word-wrap;
            }
            if root.channels.length == 0 && root.search == "" && root.category == 1: Text {
                text: @tr("No favorite channels yet: choose a channel and press the star.");
                color: Theme.dim;
                font-size: 15px * Theme.text-scale;
                wrap: word-wrap;
            }
        }
    }
}

// ───────────── Impostazioni ─────────────

// Riquadro con lo sfondo leggermente più chiaro: una colonna delle Impostazioni
component Panel inherits Rectangle {
    Sq { r: 28px; fill: Theme.panel.with-alpha(0.9); stroke: #ffffff14; stroke-width: 1px; }
    @children
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> value;
    callback edited(string);
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 13px * Theme.text-scale;
        color: Theme.dim;
    }
    Rectangle {
        height: 44px * Theme.grow;
        Sq {
            r: 22px;
            fill: Theme.glass;
            stroke: ti.has-focus ? Theme.ink : transparent;
            stroke-width: 2px;
        }
        ti := TextInput {
            x: 18px;
            width: parent.width - 36px;
            height: parent.height;
            text <=> root.value;
            color: Theme.ink;
            font-size: 15px * Theme.text-scale;
            vertical-alignment: center;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            edited => { root.edited(self.text); }
            // con il telecomando ↑ ↓ passano al campo precedente o seguente
            key-pressed(event) => {
                if (Nav.tv && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                    Nav.step(event.text == Key.DownArrow);
                    return accept;
                }
                reject
            }
        }
        if root.value == "": Text {
            x: 18px;
            width: parent.width - 36px;
            overflow: elide;
            text: root.placeholder;
            color: Theme.faint;
            font-size: 15px * Theme.text-scale;
        }
    }
}

component SetRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    // con il telecomando: il menu ha il fuoco e questa è la voce aperta
    in property <bool> focused;
    callback clicked;
    height: 52px * Theme.grow;
    Sq {
        r: 18px;
        fill: root.active ? #ffffff26 : (ta.has-hover ? #ffffff10 : transparent);
        stroke: root.focused || (root.active && !Nav.tv) ? Theme.ink : transparent;
        stroke-width: root.focused ? 3px : 2px;
    }
    Text {
        x: 22px;
        text: root.label;
        color: root.active ? Theme.ink : Theme.dim;
        font-size: 16px * Theme.text-scale;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: left;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SourceRow inherits Rectangle {
    in property <SourceItem> s;
    in property <bool> working;
    callback activate();
    callback refresh();
    callback remove();
    // guida scelta dall'utente ("" = quella della playlist o del server)
    callback set-epg(string);
    property <bool> confirm: false;
    property <bool> editing: false;
    property <string> epg;
    height: inner.preferred-height;
    Sq {
        r: 20px;
        fill: root.s.active ? #ffffff1c : Theme.glass;
        stroke: root.s.active ? Theme.needle : transparent;
        // 2 px: con 1,5 px il bordo cade a metà pixel e un tratto in alto spariva
        stroke-width: 2px;
    }
    inner := VerticalLayout {
        padding-left: 20px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.s.name;
                color: Theme.ink;
                font-size: 16px * Theme.text-scale;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.s.active ? @tr("In use") : "";
                color: Theme.needle;
                font-size: 13px * Theme.text-scale;
                font-weight: 700;
            }
        }
        Text {
            text: (root.s.kind == 1 ? @tr("File") : (root.s.kind == 2 ? "Xtream Codes" : @tr("M3U link")))
                + " · " + root.s.detail + " · " + Texts.channels(root.s.count)
                + (root.s.kind == 2 ? " · " + @tr("{n} movie" | "{n} movies" % root.s.movies) + " · " + @tr("{n} series" | "{n} series" % root.s.series) : "")
                + (root.s.expires != "" ? " · " + @tr("expires {}", root.s.expires) : "");
            color: Theme.dim;
            font-size: 12px * Theme.text-scale;
            overflow: elide;
        }
        if Texts.source-epg(root.s) != "": Text {
            text: Texts.source-epg(root.s);
            color: root.s.epg-state == 3 ? Theme.live : Theme.faint;
            font-size: 12px * Theme.text-scale;
            overflow: elide;
        }
        Rectangle { height: 4px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            // durante la conferma dell'eliminazione restano solo «Conferma» e «Annulla»
            // (con tutti i pulsanti la riga non starebbe nella colonna)
            if !root.s.active && !root.confirm: Btn {
                label: @tr("Use");
                height: 30px * Theme.grow;
                compact: true;
                enabled: !root.working;
                clicked => { root.activate(); }
            }
            if !root.confirm: Btn {
                label: @tr("Refresh");
                height: 30px * Theme.grow;
                compact: true;
                enabled: !root.working;
                clicked => { root.refresh(); }
            }
            if !root.confirm: Btn {
                label: @tr("Guide");
                height: 30px * Theme.grow;
                compact: true;
                enabled: !root.working;
                clicked => {
                    root.editing = !root.editing;
                    root.epg = "";
                }
            }
            Btn {
                label: root.confirm ? @tr("Confirm delete") : @tr("Delete");
                height: 30px * Theme.grow;
                compact: true;
                danger: root.confirm;
                enabled: !root.working;
                clicked => {
                    if (root.confirm) {
                        root.remove();
                        root.confirm = false;
                    } else {
                        root.confirm = true;
                        root.editing = false;
                    }
                }
            }
            if root.confirm: Btn {
                label: @tr("Cancel");
                height: 30px * Theme.grow;
                compact: true;
                clicked => { root.confirm = false; }
            }
        }
        if root.editing: Rectangle { height: 4px; }
        if root.editing: Field {
            label: @tr("XMLTV address or file (empty: the source's own)");
            placeholder: "http://…/guide.xml.gz";
            value <=> root.epg;
        }
        if root.editing: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn {
                label: @tr("Use this guide");
                height: 30px * Theme.grow;
                compact: true;
                primary: true;
                clicked => {
                    root.set-epg(root.epg);
                    root.editing = false;
                }
            }
            Btn {
                label: @tr("Cancel");
                height: 30px * Theme.grow;
                compact: true;
                clicked => { root.editing = false; }
            }
        }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> on;
    callback toggled(bool);
    // la spiegazione va a capo nei riquadri stretti: la riga si allunga, l'interruttore resta dentro
    height: max(66px, row.preferred-height);
    Sq { r: 22px; fill: Theme.glass; }
    row := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 16px * Theme.text-scale;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.dim;
                font-size: 12px * Theme.text-scale;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on <=> root.on;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component SettingsScreen inherits Rectangle {
    in-out property <int> section: 0;
    in property <[SourceItem]> sources;
    in property <bool> working;
    in property <SourceStatus> status;
    in property <int> language;
    in-out property <bool> reconnect;
    in-out property <bool> fullscreen-start;
    in-out property <bool> live-preview;
    in-out property <bool> update-check;
    in-out property <bool> bg-motion;
    in-out property <bool> media-volume;
    in-out property <string> user-agent;
    in-out property <string> picked-file;
    // cresce dopo un salvataggio riuscito: il modulo si svuota (password compresa)
    in property <int> form-reset;
    // aggiornamento automatico: posizione nell'elenco di `interval-options`
    in property <int> playlist-interval;
    in property <int> epg-interval;
    // controllo genitori
    in property <bool> pin-set;
    in property <bool> pin-unlocked;
    // 0 niente, 1 i due PIN non coincidono, 2 PIN non valido, 3 PIN impostato, 4 PIN tolto
    in property <int> pin-message;
    in property <[CategoryItem]> lock-live;
    in property <[CategoryItem]> lock-movies;
    in property <[CategoryItem]> lock-series;
    in-out property <string> custom-name;
    // cresce quando il fuoco deve tornare qui (dal menu in basso o dalla ricerca)
    in property <int> focus-tick;
    // il telecomando ha già fatto «Insegna il telecomando» una volta
    in property <bool> remote-taught;
    callback teach();
    callback set-interval(int, int);
    callback pin-create(string, string);
    callback pin-remove();
    callback pin-lock-now();
    callback pin-unlock();
    // tipo (0 canali, 1 film, 2 serie), posizione nell'elenco, bloccata sì o no
    callback toggle-lock(int, int, bool);
    // tipo, nome, indirizzo o file o server, utente, password, user-agent, guida
    callback verify(int, string, string, string, string, string, string);
    callback save(int, string, string, string, string, string, string);
    callback pick-file();
    callback activate-source(int);
    callback refresh-source(int);
    callback delete-source(int);
    callback set-source-epg(int, string);
    callback set-language(int);
    callback setting-changed(string, string);

    // 0 link M3U, 1 file, 2 Xtream Codes
    property <int> kind: 0;
    property <string> name;
    property <string> link;
    property <string> server;
    property <string> username;
    property <string> password;
    property <string> source-ua;
    property <string> epg;
    property <string> new-pin;
    property <string> new-pin-again;
    property <int> lock-kind: 0;
    // Tasti: l'azione che aspetta il suo tasto (-1 nessuna)
    property <int> capturing: -1;
    // dopo la scelta di un tasto il fuoco torna al suo «Cambia» (non al menu)
    property <int> refocus-row: -1;
    property <int> refocus-tick;
    // Rust intanto non deve dare ai tasti speciali del telecomando la loro funzione fissa
    changed capturing => { Keys.capturing = self.capturing >= 0; }
    function captured(row: int) {
        root.capturing = -1;
        root.refocus-row = row;
        root.refocus-tick += 1;
    }
    property <[CategoryItem]> lock-shown: root.lock-kind == 1 ? root.lock-movies : (root.lock-kind == 2 ? root.lock-series : root.lock-live);
    changed pin-set => {
        root.new-pin = "";
        root.new-pin-again = "";
        // il pulsante che aveva il fuoco è sparito: il fuoco torna al menu delle sezioni
        menu.focus();
    }
    changed pin-unlocked => { menu.focus(); }
    changed form-reset => {
        root.epg = "";
        root.name = "";
        root.link = "";
        root.server = "";
        root.username = "";
        root.password = "";
        root.source-ua = "";
        root.picked-file = "";
    }
    function location() -> string {
        return root.kind == 0 ? root.link : (root.kind == 1 ? root.picked-file : root.server);
    }
    init => { menu.focus(); }
    changed focus-tick => { menu.focus(); }

    HorizontalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 20px;
        // a schermo intero le colonne non si allungano: lo spazio in più resta a destra
        alignment: start;
        Panel {
            width: 260px + (Theme.grow - 1) * 90px;
            VerticalLayout {
                padding: 10px;
                alignment: start;
                spacing: 6px;
                // il menu delle sezioni: ↑ ↓ cambiano sezione, → (o OK) va al contenuto
                menu := FocusScope {
                    height: 0px;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.UpArrow) {
                            root.section = max(0, root.section - 1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.section = min(5, root.section + 1);
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            Nav.step(true);
                            return accept;
                        }
                        reject
                    }
                }
                for s[i] in [@tr("Sources"), @tr("Language"), @tr("Playback"), @tr("Updates"), @tr("Parental control"), @tr("Navigation")]: SetRow {
                    label: s;
                    active: root.section == i;
                    focused: Nav.tv && menu.has-focus && root.section == i;
                    clicked => { root.section = i; }
                }
            }
        }
        // sorgenti
        if root.section == 0: HorizontalLayout {
            spacing: 20px;
            alignment: start;
            Panel {
                width: 440px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Title { text: @tr("Your sources"); }
                    source-fl := Flickable {
                        vertical-stretch: 1;
                        content-height: source-list.preferred-height;
                        source-list := VerticalLayout {
                            // senza x esplicita il contenuto finiva 2 px a destra, tagliando il bordo
                            x: 0;
                            width: source-fl.width;
                            padding-top: 2px;
                            alignment: start;
                            spacing: 8px;
                            for s[i] in root.sources: SourceRow {
                                s: s;
                                working: root.working;
                                activate => { root.activate-source(s.id); }
                                refresh => { root.refresh-source(s.id); }
                                remove => { root.delete-source(s.id); }
                                set-epg(url) => { root.set-source-epg(s.id, url); }
                            }
                        }
                    }
                    Text {
                        text: @tr("Sintonia doesn't provide channels: add your own playlist or account.");
                        color: Theme.faint;
                        font-size: 13px * Theme.text-scale;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 12px; }
                }
            }
            Panel {
                width: 460px;
                VerticalLayout {
                    padding: 20px;
                    alignment: start;
                    spacing: 14px;
                    Title { text: @tr("Add a source"); }
                    Tabs {
                        options: [@tr("M3U link"), @tr("File"), "Xtream Codes"];
                        current <=> root.kind;
                    }
                    Field { label: @tr("Name"); placeholder: @tr("My playlist"); value <=> root.name; }
                    if root.kind == 2: Field {
                        label: @tr("Server");
                        placeholder: "http://server:8080";
                        value <=> root.server;
                    }
                    if root.kind == 2: HorizontalLayout {
                        spacing: 14px;
                        Field { label: @tr("Username"); placeholder: @tr("username"); value <=> root.username; }
                        Field { label: @tr("Password"); placeholder: "••••••••"; password: true; value <=> root.password; }
                    }
                    if root.kind == 0: Field {
                        label: @tr("Playlist address");
                        placeholder: "http://…/playlist.m3u8";
                        value <=> root.link;
                    }
                    if root.kind == 1: HorizontalLayout {
                        spacing: 10px;
                        Field {
                            label: @tr("File");
                            placeholder: @tr("Choose an .m3u or .m3u8 file");
                            value <=> root.picked-file;
                        }
                        VerticalLayout {
                            alignment: end;
                            Btn { label: @tr("Choose…"); height: 44px * Theme.grow; clicked => { root.pick-file(); } }
                        }
                    }
                    Field {
                        label: @tr("Program guide (optional)");
                        placeholder: root.kind == 2 ? @tr("automatic from the server") : @tr("XMLTV address or file, if the playlist doesn't give one");
                        value <=> root.epg;
                    }
                    Field {
                        label: @tr("User-agent (optional)");
                        placeholder: @tr("only if your provider asks for one");
                        value <=> root.source-ua;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Btn {
                            label: @tr("Verify");
                            enabled: !root.working;
                            clicked => { root.verify(root.kind, root.name, root.location(), root.username, root.password, root.source-ua, root.epg); }
                        }
                        Btn {
                            label: @tr("Save");
                            primary: true;
                            enabled: !root.working;
                            clicked => { root.save(root.kind, root.name, root.location(), root.username, root.password, root.source-ua, root.epg); }
                        }
                    }
                    if root.status.state != 0: Text {
                        text: Texts.source-result(root.status);
                        color: root.status.state == 4 ? Theme.live : (root.status.state == 1 ? Theme.dim : Theme.ok);
                        font-size: 14px * Theme.text-scale;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // lingua
        if root.section == 1: Panel {
            width: 680px;
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 12px;
                Title { text: @tr("Interface language"); }
                ChoiceList {
                    options: ["Italiano", "English"];
                    current: root.language;
                    picked(i) => { root.set-language(i); }
                }
                Rectangle { height: 8px; }
                Title { text: @tr("Text size"); }
                Tabs {
                    options: [@tr("Normal"), @tr("Large")];
                    current: Theme.text-scale >= 1.1 ? 1 : 0;
                    clicked(i) => {
                        Theme.text-scale = i == 1 ? 1.25 : 1;
                        root.setting-changed("text_size", i == 1 ? "1" : "0");
                    }
                }
                Text {
                    text: @tr("Changes immediately, no restart needed.");
                    color: Theme.faint;
                    font-size: 13px * Theme.text-scale;
                }
            }
        }
        // riproduzione
        if root.section == 2: Panel {
            width: 680px;
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 10px;
                Title { text: @tr("Playback"); }
                SwitchRow {
                    label: @tr("Reconnect automatically");
                    detail: @tr("If the stream drops, retry with growing delays.");
                    on <=> root.reconnect;
                    toggled(v) => { root.setting-changed("reconnect", v ? "1" : "0"); }
                }
                SwitchRow {
                    label: @tr("Start in full screen");
                    detail: @tr("The player opens full screen.");
                    on <=> root.fullscreen-start;
                    toggled(v) => { root.setting-changed("fullscreen_start", v ? "1" : "0"); }
                }
                SwitchRow {
                    label: @tr("Preview in the Live list");
                    detail: @tr("The highlighted channel starts after a moment. Turn it off if your account allows only one connection.");
                    on <=> root.live-preview;
                    toggled(v) => { root.setting-changed("live_preview", v ? "1" : "0"); }
                }
                Rectangle { height: 6px; }
                Field {
                    label: @tr("Custom user-agent");
                    placeholder: @tr("leave empty for the default");
                    value <=> root.user-agent;
                    edited(v) => { root.setting-changed("user_agent", v); }
                }
            }
        }
        // aggiornamenti
        if root.section == 3: Panel {
            width: 680px;
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 12px;
                Title { text: @tr("Automatic updates"); }
                Text {
                    text: @tr("Sintonia downloads the playlist and the program guide of the source in use again when they are older than this. It checks at startup and every 10 minutes.");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                Text { text: @tr("Playlist (channels, movies and series)"); color: Theme.ink; font-size: 16px * Theme.text-scale; font-weight: 600; }
                Tabs {
                    options: [@tr("Never"), @tr("6 hours"), @tr("12 hours"), @tr("1 day"), @tr("3 days"), @tr("1 week")];
                    current: root.playlist-interval;
                    clicked(i) => { root.set-interval(0, i); }
                }
                Rectangle { height: 8px; }
                Text { text: @tr("Program guide"); color: Theme.ink; font-size: 16px * Theme.text-scale; font-weight: 600; }
                Tabs {
                    options: [@tr("Never"), @tr("6 hours"), @tr("12 hours"), @tr("1 day"), @tr("3 days"), @tr("1 week")];
                    current: root.epg-interval;
                    clicked(i) => { root.set-interval(1, i); }
                }
                Rectangle { height: 8px; }
                SwitchRow {
                    label: @tr("Tell me when a new version of Sintonia is out");
                    on <=> root.update-check;
                    toggled(v) => { root.setting-changed("update_check", v ? "1" : "0"); }
                }
            }
        }
        // controllo genitori
        if root.section == 4: Panel {
            width: 680px;
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 12px;
                Title { text: @tr("Parental control"); }
                Text {
                    text: @tr("Locked categories disappear from every list, from search and from the Home until the PIN is entered. The PIN is asked again every time Sintonia starts.");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    wrap: word-wrap;
                }
                if !root.pin-set: HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Rectangle {
                        width: 200px;
                        height: f1.preferred-height;
                        f1 := Field { width: parent.width; label: @tr("New PIN (4 to 8 digits)"); placeholder: "••••"; password: true; value <=> root.new-pin; }
                    }
                    Rectangle {
                        width: 200px;
                        height: f2.preferred-height;
                        f2 := Field { width: parent.width; label: @tr("Repeat the PIN"); placeholder: "••••"; password: true; value <=> root.new-pin-again; }
                    }
                    VerticalLayout {
                        alignment: end;
                        Btn {
                            label: @tr("Set PIN");
                            primary: true;
                            height: 44px;
                            clicked => { root.pin-create(root.new-pin, root.new-pin-again); }
                        }
                    }
                }
                if root.pin-message != 0: Text {
                    text: root.pin-message == 1 ? @tr("The two PINs are different.")
                        : (root.pin-message == 2 ? @tr("The PIN must have 4 to 8 digits, numbers only.")
                        : (root.pin-message == 3 ? @tr("PIN set. Now choose the categories to lock.") : @tr("PIN removed: nothing is locked any more.")));
                    color: root.pin-message <= 2 ? Theme.live : Theme.ok;
                    font-size: 14px * Theme.text-scale;
                    wrap: word-wrap;
                }
                if root.pin-set && !root.pin-unlocked: HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: @tr("Enter the PIN to choose the locked categories.");
                        color: Theme.ink;
                        font-size: 15px * Theme.text-scale;
                        vertical-alignment: center;
                    }
                    Btn { label: @tr("Enter PIN"); primary: true; clicked => { root.pin-unlock(); } }
                }
                if root.pin-set && root.pin-unlocked: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn { label: @tr("Lock now"); primary: true; clicked => { root.pin-lock-now(); } }
                    // il PIN si toglie solo confermandolo
                    Btn { label: @tr("Remove PIN"); clicked => { root.pin-remove(); } }
                }
                if root.pin-set && root.pin-unlocked: Tabs {
                    options: [@tr("Channels"), @tr("Movies"), @tr("Series")];
                    current <=> root.lock-kind;
                }
                if root.pin-set && root.pin-unlocked && root.lock-shown.length == 0 && root.lock-kind != 0: Text {
                    text: @tr("No categories here in the source in use.");
                    color: Theme.faint;
                    font-size: 13px * Theme.text-scale;
                }
                // a larghezza limitata in un suo HorizontalLayout, se no limita tutta la colonna
                if root.pin-set && root.pin-unlocked: HorizontalLayout {
                  alignment: start;
                  lock-fl := Flickable {
                    // poche centinaia di categorie: un `for` basta
                    height: min(lock-list.preferred-height, 300px);
                    width: 620px;
                    content-height: lock-list.preferred-height;
                    lock-list := VerticalLayout {
                        x: 0;
                        width: lock-fl.width;
                        spacing: 6px;
                        for c[i] in root.lock-shown: lr := Rectangle {
                            height: 48px;
                            property <bool> focused: tg.focused;
                            changed focused => {
                                if (!self.focused) {
                                    return;
                                }
                                if (self.y + lock-fl.content-y < 0px) {
                                    lock-fl.content-y = -self.y;
                                } else if (self.y + self.height + lock-fl.content-y > lock-fl.height) {
                                    lock-fl.content-y = lock-fl.height - self.y - self.height;
                                }
                            }
                            Sq { r: 18px; fill: c.locked ? #ffffff1c : Theme.glass; }
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 16px;
                                spacing: 10px;
                                if c.locked: VerticalLayout {
                                    alignment: center;
                                    Icon { commands: Icons.lock; width: 16px; height: 16px; }
                                }
                                Text {
                                    text: Texts.category(c);
                                    color: Theme.ink;
                                    font-size: 15px * Theme.text-scale;
                                    font-weight: c.locked ? 700 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.count;
                                    color: Theme.faint;
                                    font-size: 12px * Theme.text-scale;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    tg := Toggle {
                                        on: c.locked;
                                        toggled(v) => { root.toggle-lock(root.lock-kind, i, v); }
                                    }
                                }
                            }
                        }
                    }
                  }
                }
                Rectangle { height: 10px; }
                Text { text: @tr("Your category"); color: Theme.ink; font-size: 16px * Theme.text-scale; font-weight: 600; }
                Text {
                    text: root.pin-set
                        ? @tr("Put the channels you want in it with the lock button under the channel, in Live. It is always locked by the PIN, and so are its channels.")
                        : @tr("Put the channels you want in it with the lock button under the channel, in Live. Set a PIN to lock it.");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    wrap: word-wrap;
                }
                if !root.pin-set || root.pin-unlocked: HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 320px;
                        height: cf.preferred-height;
                        cf := Field {
                            width: parent.width;
                            label: @tr("Name");
                            placeholder: @tr("My channels");
                            value <=> root.custom-name;
                            edited(v) => { root.setting-changed("custom_name", v); }
                        }
                    }
                }
            }
        }
        // navigazione: la modalità a sinistra, i tasti di quella modalità a destra
        if root.section == 5: HorizontalLayout {
            spacing: 20px;
            alignment: start;
            Panel {
                width: 440px;
                VerticalLayout {
                    padding: 20px;
                alignment: start;
                spacing: 12px;
                Title { text: @tr("How you move around Sintonia"); }
                ChoiceList {
                    options: [@tr("Mouse and keyboard"), @tr("Remote control")];
                    details: [@tr("Click with the mouse."), @tr("Arrows, OK and Back. Bigger buttons.")];
                    current: Nav.mode;
                    picked(i) => {
                        let first = i == 1 && Nav.mode != 1 && !root.remote-taught;
                        Nav.mode = i;
                        root.setting-changed("navigation", i == 1 ? "remote" : "mouse");
                        // la prima volta con il telecomando: gli si insegnano subito i tasti
                        if (first) { root.teach(); }
                    }
                }
                SwitchRow {
                    label: @tr("The background follows the mouse");
                    detail: @tr("It stays still while you watch a video.");
                    on <=> root.bg-motion;
                    toggled(v) => { root.setting-changed("bg_motion", v ? "1" : "0"); }
                }
                SwitchRow {
                    label: @tr("Volume keys control Sintonia");
                    detail: @tr("Remote and multimedia keyboard. Off: they change the Windows volume.");
                    on <=> root.media-volume;
                    toggled(v) => { root.setting-changed("media_volume", v ? "1" : "0"); }
                }
                Rectangle { height: 4px; }
                Text {
                    text: @tr("In the player: ↑ ↓ change channel, OK opens the channel list, ← → reach the buttons. Movies and episodes: ← → skip 10 seconds, OK pauses, ↓ shows the buttons.");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("To type (an address, a search) you need the keyboard: the one on the back of the remote, if it has one, or the Windows on-screen keyboard.");
                    color: Theme.faint;
                    font-size: 13px * Theme.text-scale;
                    wrap: word-wrap;
                }
                }
            }
            Panel {
                width: 440px;
                VerticalLayout {
                    padding: 20px;
                    alignment: start;
                    spacing: 8px;
                    Title { text: Nav.mode == 1 ? @tr("Keys for the remote control") : @tr("Keys for mouse and keyboard"); }
                    Text {
                        text: @tr("Last key pressed: {}", Keys.last != "" ? Keys.last : "—");
                        color: Theme.needle;
                        font-size: 13px * Theme.text-scale;
                        font-weight: 600;
                    }
                    Text {
                        text: @tr("Press Change, then the key. Back or Esc cancels. Arrows, OK, Back, Play/Pause and the volume keys have a fixed job and can't be chosen.");
                        color: Theme.dim;
                        font-size: 13px * Theme.text-scale;
                        wrap: word-wrap;
                    }
                    // aspetta il tasto: li prende tutti finché non arriva quello buono
                    cap := FocusScope {
                        height: 0px;
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        focus-lost => { root.capturing = -1; }
                        key-pressed(event) => {
                            if (root.capturing < 0) { return reject; }
                            if (event.text == Key.Escape) {
                                root.captured(root.capturing);
                                return accept;
                            }
                            // i tasti per muoversi e quelli che da soli non fanno niente non si assegnano
                            if (event.text == "" || event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Control
                                || event.text == Key.ControlR || event.text == Key.Alt || event.text == Key.AltGr
                                || event.text == Key.Meta || event.text == Key.MetaR || event.text == Key.UpArrow
                                || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow
                                || event.text == Key.Return || event.text == Key.Tab || event.text == Key.Backtab
                                || event.text == Key.Backspace || event.text == Key.CapsLock) {
                                return accept;
                            }
                            Keys.set-key(root.capturing, event.text);
                            root.captured(root.capturing);
                            accept
                        }
                    }
                    keys-fl := Flickable {
                        vertical-stretch: 1;
                        content-height: keys-list.preferred-height;
                        keys-list := VerticalLayout {
                            x: 0;
                            width: keys-fl.width;
                            spacing: 6px;
                            for name[i] in [@tr("Full screen"), @tr("Mini player"), @tr("Mute"), @tr("Volume up"), @tr("Volume down"), @tr("Favorite (in Live)"), @tr("Open the Guide"), @tr("Go to the Home"), @tr("Back"), @tr("Search"), @tr("Next channel"), @tr("Previous channel"), @tr("Open the Settings"), @tr("Last channel watched")]: kr := Rectangle {
                                height: 44px * Theme.grow;
                                // con le frecce la riga del pulsante attivo resta in vista
                                property <bool> focused: cb.focused;
                                changed focused => {
                                    if (!self.focused) {
                                        return;
                                    }
                                    if (self.y + keys-fl.content-y < 0px) {
                                        keys-fl.content-y = -self.y;
                                    } else if (self.y + self.height + keys-fl.content-y > keys-fl.height) {
                                        keys-fl.content-y = keys-fl.height - self.y - self.height;
                                    }
                                }
                                property <int> tick: root.refocus-tick;
                                changed tick => {
                                    if (root.refocus-row == i) {
                                        cb.focus();
                                    }
                                }
                                Sq {
                                    r: 18px;
                                    fill: root.capturing == i ? #ffffff26 : Theme.glass;
                                    stroke: root.capturing == i ? Theme.needle : transparent;
                                    stroke-width: 2px;
                                }
                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    Text {
                                        text: name;
                                        color: Theme.ink;
                                        font-size: 15px * Theme.text-scale;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.capturing == i ? @tr("Press a key…") : (Keys.labels[i] != "" ? Keys.labels[i] : "—");
                                        max-width: 150px;
                                        overflow: elide;
                                        color: root.capturing == i ? Theme.needle : Theme.ink;
                                        font-size: 15px * Theme.text-scale;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        cb := Btn {
                                            label: @tr("Change");
                                            height: 34px * Theme.grow;
                                            clicked => {
                                                root.capturing = i;
                                                cap.focus();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 4px; }
                    // i due pulsanti uno sotto l'altro: con i testi grandi in fila non ci stanno
                    if Nav.tv: HorizontalLayout {
                        alignment: start;
                        Btn {
                            label: @tr("Guided learning");
                            primary: true;
                            clicked => { root.teach(); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn { label: @tr("Restore the default keys"); clicked => { Keys.reset(); } }
                    }
                }
            }
        }
    }
}

// «Insegna il telecomando»: chiede un tasto alla volta e lo assegna all'azione. OK salta il passo,
// Indietro (Esc) chiude; al primo passo, quello di Indietro, Esc vuol dire che il telecomando ha già
// il suo tasto Indietro.
component TeachDialog inherits Rectangle {
    callback done();
    // azione (posizione in Keys) e nome di ogni passo
    property <[int]> actions: [8, 7, 6, 0, 9, 10, 11, 13, 12, 1, 5];
    property <[string]> names: [@tr("Back"), @tr("Go to the Home"), @tr("Open the Guide"), @tr("Full screen"), @tr("Search"),
        @tr("Next channel"), @tr("Previous channel"), @tr("Last channel watched"), @tr("Open the Settings"),
        @tr("Mini player"), @tr("Favorite (in Live)")];
    property <int> step;
    // l'ultimo tasto registrato, per conferma
    property <string> learned;
    function next() {
        if (root.step + 1 >= root.actions.length) {
            root.finish();
        } else {
            root.step += 1;
        }
    }
    function finish() {
        Keys.capturing = false;
        root.done();
    }
    init => {
        Keys.capturing = true;
        fs.focus();
    }
    background: #000000c8;
    TouchArea { }
    fs := FocusScope {
        // nei campi dietro non arriva niente: la procedura si prende tutti i tasti
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.learned = "";
                root.next();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.actions[root.step] == 8) {
                    // il telecomando ha già Indietro: niente tasto in più
                    Keys.set-key(8, "");
                    root.learned = "";
                    root.next();
                } else {
                    root.finish();
                }
                return accept;
            }
            if (event.text == "" || event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Control
                || event.text == Key.ControlR || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR || event.text == Key.UpArrow
                || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.Tab || event.text == Key.Backtab || event.text == " ") {
                return accept;
            }
            Keys.set-key(root.actions[root.step], event.text);
            root.learned = root.names[root.step];
            root.next();
            accept
        }
    }
    Rectangle {
        width: 560px;
        height: box.preferred-height;
        Sq { r: 30px; fill: Theme.panel; stroke: #ffffff22; stroke-width: 1px; }
        box := VerticalLayout {
            padding: 34px;
            spacing: 14px;
            Text {
                text: @tr("Guided learning");
                color: Theme.ink;
                font-size: 22px * Theme.text-scale;
                font-weight: 700;
            }
            Text {
                text: @tr("Step {} of {}", root.step + 1, root.actions.length);
                color: Theme.dim;
                font-size: 13px * Theme.text-scale;
            }
            Rectangle { height: 6px; }
            Text {
                text: root.actions[root.step] == 8
                    ? @tr("Press the key you want to use to go back. If your remote control has its own Back key, press it.")
                    : @tr("Press the key you want to use for:");
                color: Theme.dim;
                font-size: 15px * Theme.text-scale;
                wrap: word-wrap;
            }
            Text {
                text: root.names[root.step];
                color: Theme.ink;
                font-size: 32px * Theme.text-scale;
                font-weight: 700;
            }
            if root.learned != "": Text {
                text: @tr("Saved: {}", root.learned);
                color: Theme.ok;
                font-size: 13px * Theme.text-scale;
            }
            Rectangle { height: 6px; }
            Text {
                text: @tr("OK skips this step · Back ends · The arrows, OK, Play/Pause and the volume keys keep their job.");
                color: Theme.faint;
                font-size: 12px * Theme.text-scale;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn {
                    label: @tr("Skip");
                    clicked => {
                        root.learned = "";
                        root.next();
                        fs.focus();
                    }
                }
                Btn { label: @tr("Done"); primary: true; clicked => { root.finish(); } }
            }
        }
    }
}

// Richiesta del PIN: copre tutta la finestra (anche il player)
component PinDialog inherits Rectangle {
    in property <bool> error;
    // 0 aprire le categorie bloccate, 1 togliere il PIN
    in property <int> reason;
    callback submit(string);
    callback cancel();
    // cresce quando il fuoco deve tornare qui
    in property <int> focus-tick;
    property <string> pin;
    changed error => {
        if (root.error) { root.pin = ""; }
    }
    // tasti delle cifre sullo schermo (telecomando): 1-9, 0, cancella, conferma
    property <[string]> keys: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "C", "OK"];
    property <int> kc;
    function grab() {
        if (Nav.tv) { pad.focus(); } else { ti.focus(); }
    }
    init => { root.grab(); }
    changed focus-tick => { root.grab(); }
    background: #000000c0;
    // i clic fuori dal riquadro non arrivano alle pagine sotto
    TouchArea { clicked => { root.cancel(); } }
    Rectangle {
        width: 400px;
        height: box.preferred-height;
        Sq { r: 30px; fill: Theme.panel; }
        TouchArea {}
        box := VerticalLayout {
            padding: 30px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Icon { commands: Icons.lock; width: 22px; height: 22px; }
                Text {
                    text: root.reason == 1 ? @tr("Remove PIN") : @tr("Locked category");
                    color: Theme.ink;
                    font-size: 20px * Theme.text-scale;
                    font-weight: 700;
                }
            }
            Text {
                text: root.reason == 1
                    ? @tr("Enter the PIN to confirm: nothing will be locked any more.")
                    : @tr("Enter the PIN to see the locked categories until Sintonia is closed.");
                color: Theme.dim;
                font-size: 13px * Theme.text-scale;
                wrap: word-wrap;
            }
            Rectangle {
                height: 52px;
                Sq {
                    r: 26px;
                    fill: Theme.glass;
                    stroke: root.error ? Theme.live : Theme.ink;
                    stroke-width: 2px;
                }
                ti := TextInput {
                    x: 22px;
                    width: parent.width - 44px;
                    height: parent.height;
                    text <=> root.pin;
                    color: Theme.ink;
                    font-size: 22px * Theme.text-scale;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    single-line: true;
                    input-type: InputType.password;
                    // con il telecomando si scrive con i tasti qui sotto
                    enabled: !Nav.tv;
                    accepted => { root.submit(root.pin); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.cancel();
                            return accept;
                        }
                        reject
                    }
                }
            }
            // il riquadro tiene tutti i tasti: con il telecomando non si esce per sbaglio
            pad := FocusScope {
                visible: Nav.tv;
                height: Nav.tv ? 104px : 0px;
                focus-on-click: false;
                key-pressed(event) => {
                    if (event.text == "0" || event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4"
                        || event.text == "5" || event.text == "6" || event.text == "7" || event.text == "8" || event.text == "9") {
                        root.pin += event.text;
                        return accept;
                    }
                    if (event.text == Key.LeftArrow) { root.kc = max(0, root.kc - 1); }
                    if (event.text == Key.RightArrow) { root.kc = min(11, root.kc + 1); }
                    if (event.text == Key.UpArrow && root.kc >= 6) { root.kc -= 6; }
                    if (event.text == Key.DownArrow && root.kc < 6) { root.kc += 6; }
                    if (event.text == Key.Backspace || event.text == Key.Delete) { root.pin = ""; }
                    if (event.text == Key.Escape) { root.cancel(); }
                    if (event.text == Key.Return || event.text == " ") {
                        if (root.kc < 10) {
                            root.pin += root.keys[root.kc];
                        } else if (root.kc == 10) {
                            root.pin = "";
                        } else {
                            root.submit(root.pin);
                        }
                    }
                    accept
                }
                for k[i] in root.keys: Rectangle {
                    x: Math.mod(i, 6) * 56px;
                    y: floor(i / 6) * 56px;
                    width: 48px;
                    height: 48px;
                    Sq {
                        r: 16px;
                        fill: i == 11 ? Theme.ink : (kta.has-hover ? #ffffff30 : Theme.glass);
                        stroke: pad.has-focus && i == root.kc ? Theme.needle : transparent;
                        stroke-width: 3px;
                    }
                    Text {
                        text: k;
                        color: i == 11 ? Theme.bg : Theme.ink;
                        font-size: 18px * Theme.text-scale;
                        font-weight: 600;
                    }
                    kta := TouchArea {
                        clicked => {
                            root.kc = i;
                            if (i < 10) {
                                root.pin += k;
                            } else if (i == 10) {
                                root.pin = "";
                            } else {
                                root.submit(root.pin);
                            }
                        }
                    }
                }
            }
            if root.error: Text {
                text: @tr("Wrong PIN.");
                color: Theme.live;
                font-size: 14px * Theme.text-scale;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn { label: @tr("Cancel"); clicked => { root.cancel(); } }
                Btn {
                    label: root.reason == 1 ? @tr("Remove PIN") : @tr("Unlock");
                    primary: true;
                    danger: root.reason == 1;
                    clicked => { root.submit(root.pin); }
                }
            }
        }
    }
}

// ───────────── Player con elenco canali (clic destro) ─────────────

component TrackRow inherits Rectangle {
    in property <TrackItem> t;
    // evidenziata con le frecce
    in property <bool> active;
    callback clicked;
    height: 40px * Theme.grow;
    Sq {
        r: 14px;
        fill: root.t.selected ? #ffffff26 : (ta.has-hover ? #ffffff14 : transparent);
        stroke: root.active ? Theme.ink : transparent;
        stroke-width: 2px;
    }
    Text {
        x: 16px;
        text: root.t.label;
        color: Theme.ink;
        font-size: 14px * Theme.text-scale;
        font-weight: root.t.selected ? 700 : 400;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PlayerScreen inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <int> category;
    in property <string> search;
    in property <ChannelItem> c;
    in property <[TrackItem]> audio-tracks;
    in property <[TrackItem]> sub-tracks;
    in property <bool> any-sub-selected;
    // 0 automatico, 1 16:9, 2 4:3, 3 riempi
    in property <int> aspect;
    in-out property <int> cursor;
    // film o episodio: barra di avanzamento al posto del numero del canale, niente elenco canali
    in property <bool> on-demand;
    in property <int> position;
    in property <int> duration;
    in property <bool> paused;
    // prossimo episodio: secondi al via (-1: nessuno) ed etichetta
    in property <int> next-countdown: -1;
    in property <string> next-label;
    // cresce quando il fuoco deve tornare al video
    in property <int> focus-tick;
    changed focus-tick => { fs.focus(); }
    callback toggle-pause();
    callback seek(int);
    callback seek-to(float);
    callback play-next();
    callback cancel-next();
    callback back();
    callback home();
    callback pip();
    callback toggle-fullscreen();
    in property <bool> fullscreen;
    callback zap(int);
    callback tune(string);
    callback play(int);
    callback pick-category(int);
    callback load-tracks();
    callback select-audio(int);
    callback select-sub(int);
    callback set-aspect(int);
    property <bool> overlay: true;
    property <bool> drawer: false;
    // il numero del canale che si sta digitando
    property <string> digits;
    tune-timer := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.digits != "") {
                root.tune(root.digits);
                root.digits = "";
                root.show-overlay();
            }
        }
    }
    // i nomi delle proporzioni, nell'ordine di `aspect`
    property <[string]> aspect-names: [@tr("Auto"), "16:9", "4:3", @tr("Fill the screen")];
    // il puntatore sparisce insieme alle informazioni (Rust lo nasconde anche col mouse fermo)
    callback cursor-hidden(bool);
    // con il telecomando il puntatore compare solo se il mouse si muove davvero, e sparisce al
    // primo tasto; con il mouse va e viene con le informazioni
    property <bool> pointer-active;
    property <int> mouse-moves: Nav.mouse-count;
    changed mouse-moves => { root.pointer-active = true; }
    property <int> keys-for-pointer: Nav.key-count;
    changed keys-for-pointer => { root.pointer-active = false; }
    property <bool> hide-cursor: Nav.tv ? !root.pointer-active || (!root.overlay && !root.drawer)
        : (!root.overlay && !root.drawer);
    changed hide-cursor => { root.cursor-hidden(self.hide-cursor); }
    background: #000000;

    // Le informazioni sul video spariscono dopo qualche secondo senza movimenti del mouse o tasti;
    // restano finché il puntatore è sopra i pulsanti o l'elenco canali è aperto.
    property <int> video-state: Video.state;
    changed video-state => {
        // in onda: le informazioni restano altri 5 secondi da adesso
        if (Nav.tv && self.video-state == 2 && root.overlay) { root.show-overlay(); }
    }
    // con il telecomando, sui pulsanti, ogni tasto fa ripartire il tempo (10 secondi invece di 5)
    property <int> keys-pressed: Nav.key-count;
    changed keys-pressed => {
        if (Nav.tv && root.controls-focused) { root.show-overlay(); }
    }
    changed controls-focused => {
        if (Nav.tv && self.controls-focused) { root.show-overlay(); }
    }
    hide-timer := Timer {
        interval: Nav.tv && root.controls-focused ? 10s : 5s;
        running: false;
        triggered => {
            self.stop();
            // con il telecomando le informazioni restano finché il canale carica: i 5 secondi
            // partono quando è in onda
            let loading = Nav.tv && !root.on-demand
                && (Video.state == 1 || Video.state == 3 || Video.state == 5);
            // con il telecomando un pulsante con il fuoco non tiene le informazioni: dopo 10 secondi
            // senza tasti si torna al video
            let held = root.controls-focused && !Nav.tv;
            if (root.drawer || root.controls-hovered || held || root.paused || loading) {
                self.start();
            } else {
                root.overlay = false;
                if (Nav.tv && root.controls-focused) { fs.focus(); }
            }
        }
    }
    function show-overlay() {
        root.overlay = true;
        // `restart()` funziona solo con il timer già avviato: stop + start lo riparte da zero
        hide-timer.stop();
        hide-timer.start();
    }
    property <bool> controls-hovered: back-btn.hovered || home-btn.hovered || pip-btn.hovered
        || audio-btn.hovered || sub-btn.hovered || aspect-btn.hovered || seek-ta.has-hover
        || rew-btn.hovered || pause-btn.hovered || fwd-btn.hovered || fs-btn.hovered
        || mute-btn.hovered || mute-btn.dragging;
    // con il telecomando un pulsante ha il fuoco: le informazioni restano
    property <bool> controls-focused: back-btn.focused || home-btn.focused || pip-btn.focused
        || audio-btn.focused || sub-btn.focused || aspect-btn.focused || rew-btn.focused
        || pause-btn.focused || fwd-btn.focused || fs-btn.focused || mute-btn.focused;

    function toggle-drawer() {
        root.drawer = !root.drawer;
        if (root.drawer) {
            dl.center();
        }
    }
    function move(delta: int) {
        root.cursor = max(0, min(root.channels.length - 1, root.cursor + delta));
        dl.ensure-visible();
    }
    init => {
        fs.focus();
        root.show-overlay();
        root.cursor-hidden(root.hide-cursor);
    }

    fs := FocusScope {
        key-pressed(event) => {
            // telecomando: ↓ (film ed episodi) e ← → (canali) portano ai pulsanti
            if (Nav.tv && !root.drawer) {
                if (root.on-demand && (event.text == Key.DownArrow || event.text == Key.UpArrow)) {
                    root.show-overlay();
                    pause-btn.focus();
                    return accept;
                }
                if (!root.on-demand && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                    root.show-overlay();
                    // il fuoco lo sposta Rust, al pulsante seguente o precedente
                    return reject;
                }
            }
            if (Nav.tv && root.drawer) {
                if (event.text == Key.LeftArrow) {
                    dcats.focus();
                    return accept;
                }
                if (event.text == Key.RightArrow) { return accept; }
            }
            if (root.on-demand) {
                if (event.text == Key.LeftArrow) { root.seek(-10); root.show-overlay(); return accept; }
                if (event.text == Key.RightArrow) { root.seek(10); root.show-overlay(); return accept; }
                if (event.text == Key.DownArrow) { root.seek(-60); root.show-overlay(); return accept; }
                if (event.text == Key.UpArrow) { root.seek(60); root.show-overlay(); return accept; }
                if (event.text == " " || event.text == Key.Return) {
                    root.toggle-pause();
                    root.show-overlay();
                    return accept;
                }
            }
            if (event.text == Key.UpArrow) {
                if (root.drawer) { root.move(-1); } else { root.zap(-1); root.show-overlay(); }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.drawer) { root.move(1); } else { root.zap(1); root.show-overlay(); }
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.drawer) {
                    root.play(root.cursor);
                    // con il telecomando la scelta chiude l'elenco, come sulla TV
                    if (Nav.tv) {
                        root.drawer = false;
                        root.show-overlay();
                    }
                } else {
                    root.toggle-drawer();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                // con il telecomando il video è la TV: Indietro chiude solo l'elenco
                if (root.drawer) { root.drawer = false; } else if (!Nav.tv) { root.back(); }
                return accept;
            }
            // telecomando, canali: i numeri scelgono il canale, come sulla TV
            if (Nav.tv && !root.on-demand && !root.drawer
                && (event.text == "0" || event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4"
                    || event.text == "5" || event.text == "6" || event.text == "7" || event.text == "8" || event.text == "9")) {
                if (root.digits.character-count < 5) { root.digits += event.text; }
                // `restart()` vale solo con il timer avviato: stop + start lo riparte da zero
                tune-timer.stop();
                tune-timer.start();
                return accept;
            }
            if (Keys.is(1, event.text)) {
                root.pip();
                return accept;
            }
            if (Keys.is(0, event.text)) {
                root.toggle-fullscreen();
                return accept;
            }
            if (Keys.is(2, event.text)) {
                Video.toggle-mute();
                root.show-overlay();
                return accept;
            }
            if (Keys.is(3, event.text) || Keys.is(4, event.text)) {
                Video.set-volume(max(0, min(100, Video.volume + (Keys.is(3, event.text) ? 5 : -5))));
                root.show-overlay();
                return accept;
            }
            if (event.text == " ") {
                if (root.overlay) { root.overlay = false; } else { root.show-overlay(); }
                return accept;
            }
            reject
        }
    }

    // il video; sotto, il segnaposto finché non arriva il primo fotogramma
    Rectangle {
        background: @linear-gradient(160deg, root.c.tint.darker(0.45) 0%, #05060f 80%);
    }
    if !Video.ready && Texts.status(Video.state, Video.attempt) == "": Text {
        text: root.c.num;
        color: #ffffff14;
        font-size: 300px;
        font-weight: 200;
    }
    VideoView { }
    if Texts.status(Video.state, Video.attempt) != "": StatusPill { }
    TouchArea {
        // senza informazioni a video sparisce anche il puntatore
        mouse-cursor: root.hide-cursor ? MouseCursor.none : MouseCursor.default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.show-overlay();
            }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up && !root.on-demand) {
                root.toggle-drawer();
                fs.focus();
            }
        }
        clicked => {
            if (root.drawer) {
                root.drawer = false;
            } else if (root.overlay) {
                root.overlay = false;
            } else {
                root.show-overlay();
            }
            fs.focus();
        }
        double-clicked => { root.toggle-fullscreen(); }
    }

    // raccoglie i tasti dei comandi a video: Indietro e ↑ tornano al video, ← → passano da un
    // pulsante all'altro
    ctl := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.UpArrow) {
                fs.focus();
                root.show-overlay();
                return accept;
            }
            if (event.text == Key.DownArrow) { return accept; }
            reject
        }

        // in alto a sinistra: indietro e home (non cliccabili quando sono nascosti)
        HorizontalLayout {
            x: 36px;
            y: 28px;
            spacing: 10px;
            // con il telecomando resta solo Home (Indietro sul video non chiude il player)
            opacity: root.overlay && !root.drawer ? 1 : 0;
            visible: self.opacity > 0.01 || (root.overlay && !root.drawer);
            animate opacity { duration: 250ms; }
            back-btn := IconBtn {
                visible: !Nav.tv;
                width: Nav.tv ? 0px : self.size;
                icon: Icons.back;
                clicked => { root.back(); }
            }
            home-btn := IconBtn { icon: Icons.home; clicked => { root.home(); } }
        }

        // in alto a destra: schermo intero (entra / esci)
        fs-btn := IconBtn {
            x: parent.width - self.width - 36px;
            y: 28px;
            icon: root.fullscreen ? Icons.shrink : Icons.expand;
            opacity: root.overlay && !root.drawer ? 1 : 0;
            visible: self.opacity > 0.01 || (root.overlay && !root.drawer);
            animate opacity { duration: 250ms; }
            clicked => { root.toggle-fullscreen(); }
        }

        // barra in basso (più alta quando c'è la guida)
        Rectangle {
            y: parent.height - self.height;
            height: !root.on-demand && root.c.now-title != "" ? 260px * Theme.grow : 190px * Theme.grow;
            opacity: root.overlay ? 1 : 0;
            visible: self.opacity > 0.01 || root.overlay;
            animate opacity { duration: 250ms; }
            background: @linear-gradient(180deg, #00000000 0%, #000000b0 45%, #000000e0 100%);
            // barra di avanzamento (film ed episodi), cliccabile per saltare
            if root.on-demand: Rectangle {
                x: 40px;
                y: 54px;
                width: parent.width - 80px;
                height: 22px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: seek-ta.has-hover ? 6px : 4px;
                    Sq { r: 3px; fill: #ffffff33; }
                    Sq {
                        x: 0px;
                        width: root.duration > 0 ? max(6px, parent.width * root.position / root.duration) : 0px;
                        height: parent.height;
                        r: 3px;
                        fill: Theme.needle;
                    }
                }
            }
            seek-ta := TouchArea {
                x: 40px;
                y: 54px;
                width: parent.width - 80px;
                height: 22px;
                enabled: root.on-demand && root.duration > 0;
                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { root.seek-to(self.mouse-x / self.width); }
            }
            HorizontalLayout {
                padding: 40px;
                padding-bottom: 30px;
                spacing: 24px;
                alignment: stretch;
                if !root.on-demand: Text {
                    text: root.c.num;
                    color: Theme.ink;
                    font-size: 56px * Theme.text-scale;
                    font-weight: 200;
                    vertical-alignment: bottom;
                }
                VerticalLayout {
                    alignment: end;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.on-demand
                            ? Texts.clock(root.position) + (root.duration > 0 ? " / " + Texts.clock(root.duration) : "")
                            : "● " + @tr("On air");
                        color: root.on-demand ? Theme.dim : Theme.live;
                        font-size: 13px * Theme.text-scale;
                        font-weight: 600;
                    }
                    Text {
                        text: root.c.name;
                        color: Theme.ink;
                        font-size: 22px * Theme.text-scale;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.on-demand || root.c.now-title == "": Text {
                        text: root.c.group;
                        color: Theme.dim;
                        font-size: 13px * Theme.text-scale;
                    }
                    if !root.on-demand && root.c.now-title != "": NowNext {
                        c: root.c;
                        bar-width: 360px;
                        title-size: 15px;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    HorizontalLayout {
                        spacing: 10px;
                        rew-btn := IconBtn {
                            visible: root.on-demand;
                            width: root.on-demand ? 38px : 0px;
                            icon: Icons.rewind;
                            size: 38px;
                            clicked => { root.seek(-10); }
                        }
                        pause-btn := IconBtn {
                            visible: root.on-demand;
                            width: root.on-demand ? 38px : 0px;
                            icon: root.paused ? Icons.play : Icons.pause;
                            size: 38px;
                            clicked => { root.toggle-pause(); }
                        }
                        fwd-btn := IconBtn {
                            visible: root.on-demand;
                            width: root.on-demand ? 38px : 0px;
                            icon: Icons.forward;
                            size: 38px;
                            clicked => { root.seek(10); }
                        }
                        mute-btn := VolumeBtn { }
                        pip-btn := IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                        audio-btn := Btn {
                            label: @tr("Audio");
                            clicked => {
                                root.load-tracks();
                                audio-popup.show();
                            }
                        }
                        sub-btn := Btn {
                            label: @tr("Subtitles");
                            clicked => {
                                root.load-tracks();
                                sub-popup.show();
                            }
                        }
                        aspect-btn := IconBtn {
                            icon: Icons.aspect;
                            size: 38px;
                            clicked => { aspect-popup.show(); }
                        }
                    }
                }
            }
        }

        // il numero del canale che si sta digitando (telecomando)
    if root.digits != "": Rectangle {
        x: parent.width - self.width - 40px;
        y: 30px;
        width: dt.preferred-width + 48px;
        height: 84px;
        Sq { r: 24px; fill: #000000c0; }
        dt := Text {
            text: root.digits;
            color: Theme.ink;
            font-size: 56px * Theme.text-scale;
            font-weight: 300;
        }
    }

    // prossimo episodio, con il conto alla rovescia
        if root.next-countdown >= 0: Rectangle {
            x: parent.width - self.width - 40px;
            y: parent.height - self.height - 200px;
            width: 360px;
            height: 150px;
            Sq { r: 26px; fill: #14151cf0; stroke: #ffffff22; stroke-width: 1px; }
            VerticalLayout {
                padding: 20px;
                spacing: 6px;
                Text {
                    text: @tr("Next episode");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                }
                Text {
                    text: root.next-label;
                    color: Theme.ink;
                    font-size: 17px * Theme.text-scale;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: @tr("Starts in {} s", root.next-countdown);
                    color: Theme.needle;
                    font-size: 13px * Theme.text-scale;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn { label: @tr("Watch now"); primary: true; clicked => { root.play-next(); } }
                    Btn { label: @tr("Cancel"); clicked => { root.cancel-next(); } }
                }
            }
        }

        audio-popup := PopupWindow {
            x: root.width - 470px;
            y: root.height - 110px - self.height;
            width: 300px;
            height: max(1, root.audio-tracks.length) * 44px + 56px;
            Sq { r: 22px; fill: #14151cf4; stroke: #ffffff22; stroke-width: 1px; }
            apk := FocusScope {
                property <int> kc;
                init => { self.focus(); }
                // nei popup i tasti non arrivano alla finestra: si segnala qui che il fuoco c'è
                capture-key-pressed(event) => {
                    Nav.key-seen = true;
                    reject
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) { self.kc = max(0, self.kc - 1); return accept; }
                    if (event.text == Key.DownArrow) { self.kc = min(root.audio-tracks.length - 1, self.kc + 1); return accept; }
                    if (event.text == Key.Return || event.text == " ") {
                        if (root.audio-tracks.length > 0) { root.select-audio(root.audio-tracks[self.kc].id); }
                        audio-popup.close();
                        return accept;
                    }
                    reject
                }
            }
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: @tr("Audio");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    height: 28px;
                    vertical-alignment: center;
                }
                if root.audio-tracks.length == 0: Text {
                    text: @tr("Only one audio track");
                    color: Theme.faint;
                    font-size: 14px * Theme.text-scale;
                    height: 40px;
                    vertical-alignment: center;
                }
                for t[i] in root.audio-tracks: TrackRow {
                    t: t;
                    active: Nav.tv && apk.has-focus && i == apk.kc;
                    clicked => { root.select-audio(t.id); }
                }
            }
        }
        sub-popup := PopupWindow {
            x: root.width - 370px;
            y: root.height - 110px - self.height;
            width: 300px;
            height: (root.sub-tracks.length + 1) * 44px + 56px;
            Sq { r: 22px; fill: #14151cf4; stroke: #ffffff22; stroke-width: 1px; }
            // 0 è «No», poi le tracce
            spk := FocusScope {
                property <int> kc;
                init => { self.focus(); }
                capture-key-pressed(event) => {
                    Nav.key-seen = true;
                    reject
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) { self.kc = max(0, self.kc - 1); return accept; }
                    if (event.text == Key.DownArrow) { self.kc = min(root.sub-tracks.length, self.kc + 1); return accept; }
                    if (event.text == Key.Return || event.text == " ") {
                        root.select-sub(self.kc == 0 ? -1 : root.sub-tracks[self.kc - 1].id);
                        sub-popup.close();
                        return accept;
                    }
                    reject
                }
            }
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: @tr("Subtitles");
                    color: Theme.dim;
                    font-size: 13px * Theme.text-scale;
                    height: 28px;
                    vertical-alignment: center;
                }
                TrackRow {
                    t: { id: -1, label: @tr("Off"), selected: !(root.sub-tracks.length > 0 && root.any-sub-selected) };
                    active: Nav.tv && spk.has-focus && spk.kc == 0;
                    clicked => { root.select-sub(-1); }
                }
                for t[i] in root.sub-tracks: TrackRow {
                    t: t;
                    active: Nav.tv && spk.has-focus && spk.kc == i + 1;
                    clicked => { root.select-sub(t.id); }
                }
            }
        }

        aspect-popup := PopupWindow {
        x: root.width - 340px;
        y: root.height - 110px - self.height;
        width: 300px;
        height: root.aspect-names.length * 44px + 56px;
        Sq { r: 22px; fill: #14151cf4; stroke: #ffffff22; stroke-width: 1px; }
        xpk := FocusScope {
            property <int> kc: root.aspect;
            init => { self.focus(); }
            capture-key-pressed(event) => {
                Nav.key-seen = true;
                reject
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { self.kc = max(0, self.kc - 1); return accept; }
                if (event.text == Key.DownArrow) { self.kc = min(root.aspect-names.length - 1, self.kc + 1); return accept; }
                if (event.text == Key.Return || event.text == " ") {
                    root.set-aspect(self.kc);
                    aspect-popup.close();
                    return accept;
                }
                reject
            }
        }
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text {
                text: @tr("Aspect ratio");
                color: Theme.dim;
                font-size: 13px * Theme.text-scale;
                height: 28px;
                vertical-alignment: center;
            }
            for n[i] in root.aspect-names: TrackRow {
                t: { id: i, label: n, selected: i == root.aspect };
                active: Nav.tv && xpk.has-focus && i == xpk.kc;
                clicked => { root.set-aspect(i); }
            }
        }
    }

    // l'elenco canali che scorre da sinistra, con le categorie
        Rectangle {
            x: root.drawer ? 16px : -self.width - 30px;
            y: 16px;
            width: 760px;
            height: parent.height - 32px;
            animate x { duration: 240ms; easing: ease-out; }
            Sq {
                r: 36px;
                fill: #14151cf4;
                stroke: #ffffff22;
                stroke-width: 1px;
            }
            TouchArea { }
            VerticalLayout {
                padding-top: 26px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Title { text: @tr("Channels"); }
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;
                    dcats := CategoryList {
                        width: 220px;
                        model: root.categories;
                        current: root.category;
                        searching: root.search != "";
                        picked(i) => {
                            root.pick-category(i);
                            fs.focus();
                        }
                    }
                    dl := ChannelList {
                        horizontal-stretch: 1;
                        model: root.channels;
                        cursor <=> root.cursor;
                        playing-id: root.c.id;
                        focused: !Nav.tv || fs.has-focus;
                        clicked(i) => {
                            root.cursor = i;
                            root.play(i);
                            fs.focus();
                        }
                        activated(i) => { root.play(i); }
                    }
                }
                Text {
                    text: @tr("↑ ↓ browse   ·   Enter watch   ·   Esc close");
                    color: Theme.faint;
                    font-size: 12px * Theme.text-scale;
                    horizontal-alignment: center;
                    height: 44px;
                }
            }
        }
    }
}

// ───────────── Mini player: finestra a parte, sopra le altre applicazioni ─────────────

export component PipWindow inherits Window {
    in property <string> num;
    in property <string> name;
    in property <color> tint: #3b82f6;
    callback expand();
    callback dismiss();
    callback moved(length, length);
    // ridimensionamento con una maniglia d'angolo: alla pressione l'angolo (0 alto-sinistra,
    // 1 alto-destra, 2 basso-sinistra, 3 basso-destra) e il mouse nella finestra, poi solo il
    // mouse; Rust mantiene le proporzioni 16:9
    callback resize-start(int, length, length);
    callback resize(length, length);
    // rotellina: positivo ingrandisce
    callback resize-step(float);
    title: "Sintonia mini player";
    icon: @image-url("../../../assets/logo/sintonia-logo-64.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 360px;
    preferred-height: 203px;
    min-width: 240px;
    min-height: 135px;
    default-font-family: "Bahnschrift";

    // comandi visibili solo con il mouse sopra il mini player
    property <bool> controls: area.has-hover || expand-btn.hovered || close-btn.hovered || mute-btn.hovered
        || h0.has-hover || h1.has-hover || h2.has-hover || h3.has-hover;

    Sq { r: 24px; fill: @linear-gradient(145deg, root.tint.darker(0.2) 0%, #090a10 90%); }
    Sq { r: 24px; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    if !Video.ready && Texts.status(Video.state, Video.attempt) == "": Text {
        text: root.name;
        color: #ffffff22;
        font-size: min(40px, root.width / 9);
        font-weight: 800;
    }
    VideoView { r: 24px; }
    Sq {
        r: 24px;
        fill: @linear-gradient(180deg, #00000000 50%, #000000b0 100%);
        opacity: root.controls ? 1 : 0;
        animate opacity { duration: 200ms; }
    }
    if Texts.status(Video.state, Video.attempt) != "": StatusPill { small: true; }
    area := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        double-clicked => { root.expand(); }
        scroll-event(e) => {
            root.resize-step(e.delta-y / 1px);
            accept
        }
    }
    Rectangle {
        x: 16px;
        y: 14px;
        height: 26px;
        width: min(pl.preferred-width + 32px, root.width - 160px);
        opacity: root.controls ? 1 : 0;
        animate opacity { duration: 200ms; }
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        pl := Text {
            x: 24px;
            width: parent.width - 32px;
            text: root.num + " · " + root.name;
            color: Theme.ink;
            font-size: 12px * Theme.text-scale;
            font-weight: 600;
            overflow: elide;
        }
    }
    HorizontalLayout {
        x: root.width - 132px;
        y: 10px;
        width: 120px;
        spacing: 6px;
        alignment: end;
        opacity: root.controls ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; }
        mute-btn := IconBtn {
            icon: Video.muted ? Icons.muted : Icons.sound;
            size: 34px;
            clicked => { Video.toggle-mute(); }
        }
        expand-btn := IconBtn { icon: Icons.expand; size: 34px; clicked => { root.expand(); } }
        close-btn := IconBtn { icon: Icons.close; size: 34px; clicked => { root.dismiss(); } }
    }

    // maniglie d'angolo (invisibili, con il cursore di ridimensionamento)
    h0 := TouchArea {
        x: 0px;
        y: 0px;
        width: 16px;
        height: 16px;
        mouse-cursor: MouseCursor.nw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resize-start(0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => { root.resize(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
    h1 := TouchArea {
        x: root.width - 16px;
        y: 0px;
        width: 16px;
        height: 16px;
        mouse-cursor: MouseCursor.ne-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resize-start(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => { root.resize(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
    h2 := TouchArea {
        x: 0px;
        y: root.height - 16px;
        width: 16px;
        height: 16px;
        mouse-cursor: MouseCursor.sw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resize-start(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => { root.resize(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
    h3 := TouchArea {
        x: root.width - 16px;
        y: root.height - 16px;
        width: 16px;
        height: 16px;
        mouse-cursor: MouseCursor.se-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resize-start(3, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => { root.resize(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
}

// ───────────── Finestra principale ─────────────

export component MainWindow inherits Window {
    title: "Sintonia";
    icon: @image-url("../../../assets/logo/sintonia-logo-64.png");
    preferred-width: 1320px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 700px;
    background: Theme.bg;
    default-font-family: "Bahnschrift";

    in-out property <int> page <=> Theme.page;
    in-out property <bool> playing: false;
    in property <string> clock;
    // la finestra è a schermo intero
    in property <bool> fullscreen;
    // nel player: il puntatore va nascosto (o rimostrato)
    callback cursor-hidden(bool);

    // canali della sorgente in uso, già filtrati per categoria o ricerca
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <[CategoryItem]> top-categories;
    in property <int> category: 0;
    in-out property <string> search;
    // riga evidenziata nell'elenco
    in-out property <int> cursor: 0;
    // il canale in onda
    in property <ChannelItem> current;
    in property <bool> has-current;
    in property <bool> no-source: true;
    // Home: Riprendi e Preferiti
    in property <[HomeItem]> resume;
    in property <[HomeItem]> home-favorites;

    // Film e serie
    in property <bool> media-available;
    in property <int> media-mode;
    in property <[PosterItem]> media-items;
    in property <[CategoryItem]> media-categories;
    in property <int> media-category;
    in-out property <int> media-cursor;
    in property <int> media-detail;
    in property <DetailInfo> media-info;
    in property <[string]> media-seasons;
    in-out property <int> media-season;
    in property <[EpisodeItem]> media-episodes;
    in-out property <int> media-episode-cursor;
    property <int> media-focus-tick;

    // Guida
    in property <[GuideRow]> guide-rows;
    in property <[DayItem]> guide-days;
    in property <int> guide-day: 1;
    in property <int> guide-now-min: -1;
    in property <int> guide-state;
    in property <string> guide-error;
    in-out property <int> guide-cursor;
    in property <int> guide-scroll-tick;
    property <int> guide-focus-tick;

    // impostazioni
    in property <[SourceItem]> sources;
    in property <bool> working;
    in property <SourceStatus> source-status;
    in property <int> language;
    in-out property <bool> reconnect: true;
    in-out property <bool> fullscreen-start;
    in-out property <bool> live-preview: true;
    in-out property <bool> update-check: true;
    in-out property <bool> bg-motion: true;
    in-out property <bool> media-volume: true;
    in property <string> update-version;
    callback open-update();
    callback dismiss-update();
    in-out property <string> user-agent;
    in-out property <string> picked-file;
    in-out property <int> settings-section: 0;
    in property <int> form-reset;
    in property <int> playlist-interval;
    in property <int> epg-interval;
    in property <bool> pin-set;
    in property <bool> pin-unlocked;
    in property <int> pin-message;
    in property <[CategoryItem]> lock-live;
    in property <[CategoryItem]> lock-movies;
    in property <[CategoryItem]> lock-series;
    in-out property <string> custom-name;
    in property <int> top-offset: 2;
    callback toggle-custom-channel(int);
    // richiesta del PIN aperta, e PIN sbagliato
    in property <bool> pin-prompt;
    in property <bool> pin-error;
    in property <int> pin-reason;
    callback set-interval(int, int);
    callback pin-create(string, string);
    callback pin-remove();
    callback pin-lock-now();
    callback pin-unlock();
    callback toggle-lock(int, int, bool);
    callback pin-submit(string);
    callback pin-cancel();

    // player
    in property <[TrackItem]> audio-tracks;
    in property <[TrackItem]> sub-tracks;
    in property <bool> any-sub-selected;
    in property <int> aspect;
    in property <bool> on-demand;
    in property <int> position;
    in property <int> duration;
    in property <bool> paused;
    in property <int> next-countdown: -1;
    in property <string> next-label;
    property <int> live-focus-tick;
    property <int> home-focus-tick;
    property <int> settings-focus-tick;
    property <int> player-focus-tick;
    property <int> dock-focus-tick;
    property <int> pin-focus-tick;
    property <int> search-focus-tick;
    // «Insegna il telecomando» aperto, e già fatto una volta
    property <bool> teach-open;
    in-out property <bool> remote-taught;
    // il livello del volume a video: si accende quando cambia, si spegne dopo 2 secondi; dopo
    // l'avvio (il volume salvato non deve mostrarlo)
    property <bool> osd-shown;
    property <bool> osd-armed;
    property <int> osd-volume: Video.volume;
    property <bool> osd-muted: Video.muted;
    function show-osd() {
        if (!root.osd-armed) { return; }
        root.osd-shown = true;
        osd-timer.stop();
        osd-timer.start();
    }
    changed osd-volume => { root.show-osd(); }
    changed osd-muted => { root.show-osd(); }
    osd-timer := Timer {
        interval: 2s;
        running: false;
        triggered => {
            self.running = false;
            root.osd-shown = false;
        }
    }
    Timer {
        interval: 3s;
        running: !root.osd-armed;
        triggered => { root.osd-armed = true; }
    }

    // c'è un riquadro video sullo schermo (Home, Live o player)
    out property <bool> video-visible: root.playing || (root.page <= 1 && !root.no-source);

    callback play-index(int);
    callback cursor-moved(int);
    callback zap(int);
    // telecomando: il canale con quel numero, e quello guardato prima
    callback tune(string);
    callback last-channel();
    callback pick-category(int);
    callback search-edited(string);
    callback request-pip(int);
    callback close-pip();
    callback toggle-fullscreen();
    callback verify-source(int, string, string, string, string, string, string);
    callback save-source(int, string, string, string, string, string, string);
    callback guide-opened();
    callback guide-pick-day(int);
    callback guide-watch(int);
    callback guide-refresh();
    callback toggle-fav-channel(int);
    callback open-resume(int);
    callback open-favorite(int);
    callback media-pick-mode(int);
    callback media-pick-category(int);
    callback media-open(int);
    callback media-back();
    callback media-play(bool);
    callback media-resume-series();
    callback media-play-episode(int);
    callback media-toggle-fav();
    callback media-pick-season(int);
    callback toggle-pause();
    callback seek(int);
    callback seek-to(float);
    callback play-next();
    callback cancel-next();
    callback pick-file();
    callback activate-source(int);
    callback refresh-source(int);
    callback delete-source(int);
    callback set-source-epg(int, string);
    callback set-language(int);
    callback setting-changed(string, string);
    callback load-tracks();
    callback select-audio(int);
    callback select-sub(int);
    callback set-aspect(int);
    callback playing-changed(bool);
    changed playing => { root.playing-changed(root.playing); }
    changed page => {
        root.page-changed(root.page);
        if (root.page == 2) { root.guide-opened(); }
    }
    // cresce quando gli elenchi devono mostrare al centro quello che si sta guardando
    in property <int> reveal-tick;
    callback page-changed(int);

    // tasto Home del telecomando
    // con il telecomando lo stesso tasto apre il menu dal video e lo richiude
    public function go-home() {
        if (Nav.tv && !root.playing && root.has-current) {
            root.watch-current();
            return;
        }
        root.playing = false;
        root.page = 0;
    }
    // Sfondo: il colore della sezione cambia piano; con il mouse lo sfondo si sposta verso il
    // puntatore. Lo spostamento lo fa un timer che avvicina la posizione a quella voluta e si
    // ferma quando ci è arrivato: fluido, e a mouse fermo non lavora più.
    property <color> bg-tint: Theme.base;
    animate bg-tint { duration: 700ms; easing: ease-in-out; }
    property <bool> bg-follow: root.bg-motion && !root.playing && !Nav.tv && bg-area.has-hover;
    property <length> bg-tx: root.bg-follow ? (bg-area.mouse-x - root.width / 2) * 0.22 : 0px;
    property <length> bg-ty: root.bg-follow ? (bg-area.mouse-y - root.height / 2) * 0.22 : 0px;
    property <length> bg-x;
    property <length> bg-y;
    Timer {
        interval: 16ms;
        running: !root.playing && (abs(root.bg-tx - root.bg-x) > 0.5px || abs(root.bg-ty - root.bg-y) > 0.5px);
        triggered => {
            root.bg-x += (root.bg-tx - root.bg-x) * 0.14;
            root.bg-y += (root.bg-ty - root.bg-y) * 0.14;
            if (abs(root.bg-tx - root.bg-x) <= 0.5px && abs(root.bg-ty - root.bg-y) <= 0.5px) {
                root.bg-x = root.bg-tx;
                root.bg-y = root.bg-ty;
            }
        }
    }

    // apre il player sul canale in onda
    public function watch-current() {
        if (root.has-current) {
            root.close-pip();
            root.playing = true;
        }
    }
    function open-settings-sources() {
        root.settings-section = 0;
        root.page = 4;
    }
    // il fuoco va all'elemento principale della pagina aperta
    function enter-page() {
        root.home-focus-tick += 1;
        root.live-focus-tick += 1;
        root.guide-focus-tick += 1;
        root.media-focus-tick += 1;
        root.settings-focus-tick += 1;
    }
    // Rust: con il telecomando un tasto non è arrivato a nessun elemento (il fuoco si era perso,
    // per esempio sul pulsante di una riga appena tolta). Il fuoco torna in un posto sicuro:
    // il PIN, il video o il menu in basso.
    public function recover-focus() {
        if (root.pin-prompt) {
            root.pin-focus-tick += 1;
        } else if (root.playing) {
            root.player-focus-tick += 1;
        } else {
            root.dock-focus-tick += 1;
        }
    }

    // Telecomando: le frecce che nessun elemento usa spostano il fuoco al seguente (→ ↓) o al
    // precedente (← ↑). Raccoglie solo i tasti: non prende mai il fuoco.
    nav := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            Nav.key-seen = true;
            Nav.key-count += 1;
            reject
        }
        key-pressed(event) => {
            if (Keys.is(0, event.text)) {
                root.toggle-fullscreen();
                return accept;
            }
            if (Keys.is(1, event.text) && root.has-current) {
                root.request-pip(-1);
                root.playing = false;
                return accept;
            }
            if (Keys.is(2, event.text)) {
                Video.toggle-mute();
                return accept;
            }
            if (Keys.is(3, event.text) || Keys.is(4, event.text)) {
                Video.set-volume(max(0, min(100, Video.volume + (Keys.is(3, event.text) ? 5 : -5))));
                return accept;
            }
            if (Keys.is(6, event.text)) {
                root.playing = false;
                root.page = 2;
                return accept;
            }
            if (Keys.is(7, event.text)) {
                root.go-home();
                return accept;
            }
            if (Keys.is(8, event.text)) {
                Keys.back();
                return accept;
            }
            if (Keys.is(9, event.text)) {
                root.playing = false;
                root.search-focus-tick += 1;
                return accept;
            }
            if (Keys.is(13, event.text)) {
                root.last-channel();
                return accept;
            }
            if (Keys.is(12, event.text)) {
                root.playing = false;
                root.page = 4;
                return accept;
            }
            if ((Keys.is(10, event.text) || Keys.is(11, event.text)) && root.playing) {
                root.zap(Keys.is(10, event.text) ? 1 : -1);
                return accept;
            }
            if (!Nav.tv) { return reject; }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                Nav.step(false);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                Nav.step(true);
                return accept;
            }
            reject
        }

        // segue il mouse per lo sfondo (le pagine sopra ricevono i clic come prima)
        bg-area := TouchArea {
            enabled: !root.playing;
            // lo sfondo prende il colore della sezione, passando piano dall'uno all'altro
            if !root.playing: Backdrop {
                tint: root.bg-tint;
                dx: root.bg-x;
                dy: root.bg-y;
            }

            // Indietro (con il telecomando): da una pagina al menu in basso, dal menu alla Home
            if !root.playing: FocusScope {
                focus-on-tab-navigation: false;
                focus-on-click: false;
                key-pressed(event) => {
                    if (!Nav.tv || event.text != Key.Escape) { return reject; }
                    // come una TV: da una pagina al menu in basso, dal menu al video
                    if (!dock.focused) {
                        dock.focus();
                    } else if (root.has-current) {
                        root.watch-current();
                    } else if (root.page != 0) {
                        root.page = 0;
                    }
                    accept
                }
                VerticalLayout {
                    TopBar {
                        focus-tick: root.search-focus-tick;
                        page <=> root.page;
                        clock: root.clock;
                        search <=> root.search;
                        fullscreen: root.fullscreen;
                        update-version: root.update-version;
                        open-update => { root.open-update(); }
                        dismiss-update => { root.dismiss-update(); }
                        toggle-fullscreen => { root.toggle-fullscreen(); }
                        search-edited(text) => {
                            root.search-edited(text);
                            // la ricerca vale per la pagina in cui si è (Guida, Film e serie), altrimenti Live
                            if (text != "" && root.page != 2 && root.page != 3) { root.page = 1; }
                        }
                        search-done => { root.enter-page(); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        if root.page == 0: HomeScreen {
                            hero: root.current;
                            has-hero: root.has-current;
                            no-source: root.no-source;
                            categories: root.top-categories;
                            top-offset: root.top-offset;
                            resume: root.resume;
                            favorites: root.home-favorites;
                            focus-tick: root.home-focus-tick;
                            play => { root.watch-current(); }
                            pip => { root.request-pip(-1); }
                            open-category(i) => {
                                root.pick-category(i);
                                root.page = 1;
                            }
                            open-resume(i) => { root.open-resume(i); }
                            open-favorite(i) => { root.open-favorite(i); }
                            add-source => { root.open-settings-sources(); }
                        }
                        if root.page == 1: LiveScreen {
                            focus-tick: root.live-focus-tick;
                            reveal-tick: root.reveal-tick;
                            channels: root.channels;
                            categories: root.categories;
                            category: root.category;
                            search: root.search;
                            cursor <=> root.cursor;
                            playing-id: root.has-current ? root.current.id : -1;
                            no-source: root.no-source;
                            play(i) => {
                                root.close-pip();
                                root.play-index(i);
                                root.playing = true;
                            }
                            pip(i) => { root.request-pip(i); }
                            pick-category(i) => { root.pick-category(i); }
                            cursor-moved(i) => { root.cursor-moved(i); }
                            toggle-fav(i) => { root.toggle-fav-channel(i); }
                            toggle-custom(i) => { root.toggle-custom-channel(i); }
                            add-source => { root.open-settings-sources(); }
                        }
                        if root.page == 2: GuideScreen {
                            rows: root.guide-rows;
                            categories: root.categories;
                            category: root.category;
                            search: root.search;
                            days: root.guide-days;
                            day: root.guide-day;
                            now-min: root.guide-now-min;
                            state: root.guide-state;
                            error: root.guide-error;
                            no-source: root.no-source;
                            cursor <=> root.guide-cursor;
                            focus-tick: root.guide-focus-tick;
                            scroll-tick: root.guide-scroll-tick;
                            pick-day(i) => { root.guide-pick-day(i); }
                            pick-category(i) => { root.pick-category(i); }
                            watch(i) => {
                                root.close-pip();
                                root.guide-watch(i);
                                root.playing = true;
                            }
                            refresh => { root.guide-refresh(); }
                            add-source => { root.open-settings-sources(); }
                        }
                        if root.page == 3: MediaScreen {
                            available: root.media-available;
                            mode: root.media-mode;
                            items: root.media-items;
                            categories: root.media-categories;
                            category: root.media-category;
                            search: root.search;
                            cursor <=> root.media-cursor;
                            detail: root.media-detail;
                            info: root.media-info;
                            seasons: root.media-seasons;
                            season <=> root.media-season;
                            episodes: root.media-episodes;
                            episode-cursor <=> root.media-episode-cursor;
                            focus-tick: root.media-focus-tick;
                            reveal-tick: root.reveal-tick;
                            pick-mode(m) => { root.media-pick-mode(m); }
                            pick-category(i) => { root.media-pick-category(i); }
                            open(i) => { root.media-open(i); }
                            back => { root.media-back(); }
                            play(from-start) => {
                                root.close-pip();
                                root.media-play(from-start);
                                root.playing = true;
                            }
                            resume-series => {
                                root.close-pip();
                                root.media-resume-series();
                                root.playing = true;
                            }
                            play-episode(i) => {
                                root.close-pip();
                                root.media-play-episode(i);
                                root.playing = true;
                            }
                            toggle-fav => { root.media-toggle-fav(); }
                            pick-season(i) => { root.media-pick-season(i); }
                            add-source => { root.open-settings-sources(); }
                        }
                        if root.page == 4: SettingsScreen {
                            section <=> root.settings-section;
                            focus-tick: root.settings-focus-tick;
                            remote-taught: root.remote-taught;
                            teach => {
                                root.teach-open = true;
                                root.setting-changed("remote_taught", "1");
                            }
                            sources: root.sources;
                            working: root.working;
                            status: root.source-status;
                            language: root.language;
                            reconnect <=> root.reconnect;
                            fullscreen-start <=> root.fullscreen-start;
                            live-preview <=> root.live-preview;
                            update-check <=> root.update-check;
                    bg-motion <=> root.bg-motion;
                media-volume <=> root.media-volume;
                            user-agent <=> root.user-agent;
                            playlist-interval: root.playlist-interval;
                            epg-interval: root.epg-interval;
                            pin-set: root.pin-set;
                            pin-unlocked: root.pin-unlocked;
                            pin-message: root.pin-message;
                            lock-live: root.lock-live;
                            lock-movies: root.lock-movies;
                            lock-series: root.lock-series;
                            custom-name <=> root.custom-name;
                            set-interval(k, i) => { root.set-interval(k, i); }
                            pin-create(a, b) => { root.pin-create(a, b); }
                            pin-remove => { root.pin-remove(); }
                            pin-lock-now => { root.pin-lock-now(); }
                            pin-unlock => { root.pin-unlock(); }
                            toggle-lock(k, i, v) => { root.toggle-lock(k, i, v); }
                            picked-file <=> root.picked-file;
                            form-reset: root.form-reset;
                            verify(k, n, l, u, p, a, g) => { root.verify-source(k, n, l, u, p, a, g); }
                            save(k, n, l, u, p, a, g) => { root.save-source(k, n, l, u, p, a, g); }
                            pick-file => { root.pick-file(); }
                            activate-source(id) => { root.activate-source(id); }
                            refresh-source(id) => { root.refresh-source(id); }
                            delete-source(id) => { root.delete-source(id); }
                            set-source-epg(id, url) => { root.set-source-epg(id, url); }
                            set-language(i) => { root.set-language(i); }
                            setting-changed(k, v) => { root.setting-changed(k, v); }
                        }
                    }
                    dock := Dock {
                        current <=> root.page;
                        labels: [@tr("Home"), @tr("Live"), @tr("Guide"), @tr("Movies & series")];
                        focus-tick: root.dock-focus-tick;
                        enter => { root.enter-page(); }
                    }
                }
            }
        }

        if root.playing: PlayerScreen {
            channels: root.channels;
            categories: root.categories;
            category: root.category;
            search: root.search;
            c: root.current;
            cursor <=> root.cursor;
            audio-tracks: root.audio-tracks;
            sub-tracks: root.sub-tracks;
            any-sub-selected: root.any-sub-selected;
            aspect: root.aspect;
            on-demand: root.on-demand;
            position: root.position;
            duration: root.duration;
            paused: root.paused;
            next-countdown: root.next-countdown;
            next-label: root.next-label;
            focus-tick: root.player-focus-tick;
            // la pagina sotto il player non cambia mentre si guarda: chiudendolo si torna lì
            back => {
                root.playing = false;
            }
            home => {
                root.playing = false;
                root.page = 0;
            }
            pip => {
                root.request-pip(-1);
                root.playing = false;
            }
            toggle-pause => { root.toggle-pause(); }
            seek(s) => { root.seek(s); }
            seek-to(f) => { root.seek-to(f); }
            play-next => { root.play-next(); }
            cancel-next => { root.cancel-next(); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            fullscreen: root.fullscreen;
            zap(d) => { root.zap(d); }
            tune(n) => { root.tune(n); }
            play(i) => { root.play-index(i); }
            pick-category(i) => { root.pick-category(i); }
            load-tracks => { root.load-tracks(); }
            select-audio(id) => { root.select-audio(id); }
            select-sub(id) => { root.select-sub(id); }
            set-aspect(i) => { root.set-aspect(i); }
            cursor-hidden(h) => { root.cursor-hidden(h); }
        }

        // il livello del volume a video quando cambia (tasti, telecomando, barra, muto)
        if root.osd-shown: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.12;
            width: 340px;
            height: 64px;
            Sq { r: 32px; fill: #000000c8; stroke: #ffffff22; stroke-width: 1px; }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 24px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        commands: Video.muted || Video.volume == 0 ? Icons.muted : Icons.sound;
                        width: 26px;
                        height: 26px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 6px;
                        Sq { r: 3px; fill: #ffffff2a; }
                        Sq {
                            x: 0px;
                            width: Video.muted ? 0px : parent.width * Video.volume / 100;
                            height: parent.height;
                            r: 3px;
                            fill: Theme.needle;
                        }
                    }
                }
                Text {
                    width: 46px;
                    text: Video.muted ? @tr("Mute") : Video.volume;
                    color: Theme.ink;
                    font-size: 18px * Theme.text-scale;
                    font-weight: 600;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        if root.teach-open: TeachDialog {
            done => {
                root.teach-open = false;
                root.remote-taught = true;
                root.settings-focus-tick += 1;
            }
        }

        if root.pin-prompt: PinDialog {
            error: root.pin-error;
            reason: root.pin-reason;
            focus-tick: root.pin-focus-tick;
            submit(p) => { root.pin-submit(p); }
            cancel => { root.pin-cancel(); }
        }
    }
}
