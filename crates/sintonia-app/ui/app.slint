// Sintonia: interfaccia (partita dalla bozza grafica v3 approvata).
// M0: dati ancora finti, nessun canale reale; il video arriva da libmpv attraverso il global `Video`.
// Le stringhe sono ancora in `T` (italiano/inglese): passano a @tr() e ai file .po in M1.

global Theme {
    in-out property <int> page: 0;
    out property <color> bg: #0e0f14;
    out property <color> panel: #1b1c26;
    out property <color> glass: #ffffff14;
    out property <color> ink: #ffffff;
    out property <color> dim: #b4b6c6;
    out property <color> faint: #7d8094;
    out property <color> live: #ff5d7a;
    // un colore per sezione: Home, Live, Guida, Film e serie, Impostazioni
    public pure function cat(i: int) -> color {
        return i == 0 ? #6D5BB1 : (i == 1 ? #677C2F : (i == 2 ? #A06135 : (i == 3 ? #525C62 : #7C6969)));
    }
    out property <color> base: cat(page);
    out property <color> needle: base.brighter(0.9);
}

global T {
    in-out property <int> lang: 0;
    pure function pick(it: string, en: string) -> string { return lang == 0 ? it : en; }

    out property <string> search: pick("Cerca canali, film, serie", "Search channels, movies, series");
    out property <[string]> nav: lang == 0 ? ["Home", "Live", "Guida", "Film e serie"] : ["Home", "Live", "Guide", "Movies & series"];
    out property <string> on-now: pick("In onda ora sui tuoi preferiti", "On now from your favorites");
    out property <string> channel: pick("canale", "channel");
    out property <string> watch: pick("Guarda", "Watch");
    out property <string> resume: pick("Riprendi", "Continue watching");
    out property <string> favorites: pick("Preferiti", "Favorites");
    out property <string> next-at: pick("Dopo, alle", "Next, at");
    out property <string> live: pick("In diretta", "Live");
    out property <[string]> cats: lang == 0 ? ["Tutti", "Preferiti", "Sport", "Cinema", "Notizie", "Bambini"] : ["All", "Favorites", "Sports", "Cinema", "News", "Kids"];
    out property <string> add-fav: pick("Aggiungi ai preferiti", "Add to favorites");
    out property <string> in-favs: pick("Tra i preferiti", "In favorites");
    out property <[string]> days: lang == 0 ? ["Ieri", "Oggi", "Domani", "Lun 19", "Mar 20"] : ["Yesterday", "Today", "Tomorrow", "Mon 19", "Tue 20"];
    out property <[string]> kinds: lang == 0 ? ["Film", "Serie"] : ["Movies", "Series"];
    out property <string> audio: pick("Audio", "Audio");
    out property <string> subtitles: pick("Sottotitoli", "Subtitles");
    out property <string> hint-video: pick("Clic destro sul video: elenco canali  ·  P: mini player  ·  F: schermo intero", "Right-click the video: channel list  ·  P: mini player  ·  F: full screen");
    // stato del video (Video.state)
    out property <string> st-loading: pick("Collegamento al canale…", "Connecting to the channel…");
    out property <string> st-buffering: pick("In attesa del segnale…", "Waiting for the signal…");
    out property <string> st-error: pick("Il canale non risponde", "The channel is not responding");
    public pure function status(state: int) -> string {
        return state == 1 ? st-loading : (state == 3 ? st-buffering : (state == 4 ? st-error : ""));
    }
    out property <string> channels-title: pick("Canali", "Channels");
    out property <string> hint-list: pick("↑ ↓ scorri   ·   Invio guarda   ·   Esc chiudi", "↑ ↓ browse   ·   Enter watch   ·   Esc close");
    // impostazioni
    out property <[string]> set-nav: lang == 0 ? ["Sorgenti", "Lingua", "Riproduzione"] : ["Sources", "Language", "Playback"];
    out property <string> your-sources: pick("Le tue sorgenti", "Your sources");
    out property <string> in-use: pick("In uso", "In use");
    out property <string> no-channels: pick("Sintonia non fornisce canali: aggiungi la tua playlist o il tuo account.", "Sintonia does not provide channels: add your own playlist or account.");
    out property <string> add-source: pick("Aggiungi una sorgente", "Add a source");
    out property <[string]> kinds-src: lang == 0 ? ["Link M3U", "Xtream Codes", "File"] : ["M3U link", "Xtream Codes", "File"];
    out property <string> f-name: pick("Nome", "Name");
    out property <string> f-playlist: pick("Indirizzo della playlist", "Playlist address");
    out property <string> f-server: pick("Server", "Server");
    out property <string> f-user: pick("Utente", "Username");
    out property <string> f-user-ph: pick("nome utente", "username");
    out property <string> f-pass: pick("Password", "Password");
    out property <string> f-file: pick("File", "File");
    out property <string> f-file-ph: pick("Scegli un file .m3u o .m3u8", "Choose an .m3u or .m3u8 file");
    out property <string> f-epg: pick("Guida dei programmi (facoltativa)", "Program guide (optional)");
    out property <string> f-epg-ph: pick("automatica dal server", "automatic from the server");
    out property <string> verify: pick("Verifica", "Verify");
    out property <string> save: pick("Salva", "Save");
    out property <string> lang-title: pick("Lingua dell'interfaccia", "Interface language");
    out property <string> lang-note: pick("Cambia subito, senza riavviare.", "Changes immediately, no restart needed.");
    out property <string> play-title: pick("Riproduzione", "Playback");
    out property <string> reconnect: pick("Riconnessione automatica", "Reconnect automatically");
    out property <string> reconnect-d: pick("Se lo stream cade, riprova con attese crescenti.", "If the stream drops, retry with growing delays.");
    out property <string> fullscreen: pick("Avvia a schermo intero", "Start in full screen");
    out property <string> fullscreen-d: pick("Il player si apre a tutto schermo.", "The player opens full screen.");
    out property <string> epg-start: pick("Aggiorna la guida all'avvio", "Refresh the guide at startup");
    out property <string> epg-start-d: pick("Scarica la guida dei programmi quando apri Sintonia.", "Downloads the program guide when you open Sintonia.");
    out property <string> useragent: pick("User-agent personalizzato", "Custom user-agent");
    out property <string> useragent-ph: pick("lascia vuoto per quello predefinito", "leave empty for the default");

    public pure function resume-sub(kind: int, mins: int, detail: string) -> string {
        return kind == 0 ? detail + " · " + pick("in diretta", "live")
            : (kind == 1 ? pick("Film", "Movie") + " · " + mins + pick(" minuti rimasti", " min left")
            : detail + " · " + mins + pick(" minuti rimasti", " min left"));
    }
}

export struct Channel {
    num: string,
    name: string,
    tint: color,
    now: string,
    start: string,
    end: string,
    progress: float,
    next: string,
    next-time: string,
    desc: string,
    hd: bool,
    fav: bool,
}
export struct Resume { title: string, kind: int, mins: int, detail: string, progress: float }
export struct Film { title: string, meta: string, rating: string, tint: color, progress: float }
export struct Program { title: string, start: int, dur: int }
export struct GuideRow { num: string, name: string, progs: [Program] }

// ───────────── Mattoncini ─────────────

// Rettangolo a super-ellisse: gli angoli sono curve continue (squircle), non archi di cerchio.
component Sq inherits Path {
    in property <length> r: 20px;
    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    property <float> p: min(root.r / 1px * 1.5, min(root.w, root.h) / 2);
    property <float> q: 0.25 * root.p;
    viewbox-width: root.w;
    viewbox-height: root.h;
    fill: transparent;
    commands: "M " + root.p + " 0 L " + (root.w - root.p) + " 0 C " + (root.w - root.q) + " 0 " + root.w + " " + root.q + " " + root.w + " " + root.p
        + " L " + root.w + " " + (root.h - root.p) + " C " + root.w + " " + (root.h - root.q) + " " + (root.w - root.q) + " " + root.h + " " + (root.w - root.p) + " " + root.h
        + " L " + root.p + " " + root.h + " C " + root.q + " " + root.h + " 0 " + (root.h - root.q) + " 0 " + (root.h - root.p)
        + " L 0 " + root.p + " C 0 " + root.q + " " + root.q + " 0 " + root.p + " 0 Z";
}

// ───────────── Video ─────────────

// Il video di libmpv. Rust disegna il fotogramma in una texture OpenGL grande quanto il riquadro
// (`w` × `h`), con gli angoli già ritagliati a super-ellisse di raggio `r`, e la passa in `frame`.
// Ogni finestra ha la sua istanza di questo global.
export global Video {
    in property <image> frame;
    // c'è un fotogramma del flusso corrente da mostrare
    in property <bool> ready;
    // 0 fermo, 1 collegamento, 2 in onda, 3 in attesa di dati, 4 errore
    in property <int> state;
    // scritte da `VideoView`, lette da Rust
    in-out property <length> w;
    in-out property <length> h;
    in-out property <length> r;
}

// Il riquadro in cui compare il video. Ce n'è al massimo uno visibile per finestra.
component VideoView inherits Rectangle {
    in property <length> r: 0px;
    init => {
        Video.w = self.width;
        Video.h = self.height;
        Video.r = self.r;
    }
    changed width => { Video.w = self.width; }
    changed height => { Video.h = self.height; }
    changed r => { Video.r = self.r; }
    if Video.ready: Image {
        width: 100%;
        height: 100%;
        source: Video.frame;
        image-fit: fill;
    }
}

component Icon inherits Path {
    in property <color> tint: Theme.ink;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

global Icons {
    out property <string> home: "M3 11 L12 4 L21 11 M5.5 9.5 V20 H18.5 V9.5";
    out property <string> back: "M15 5 L8 12 L15 19";
    out property <string> gear: "M5 12 A7 7 0 1 0 19 12 A7 7 0 1 0 5 12 M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 M19 12 L22 12 M16.95 7.05 L19.07 4.93 M12 5 L12 2 M7.05 7.05 L4.93 4.93 M5 12 L2 12 M7.05 16.95 L4.93 19.07 M12 19 L12 22 M16.95 16.95 L19.07 19.07";
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> expand: "M14 4 H20 V10 M20 4 L13 11 M10 20 H4 V14 M4 20 L11 13";
    out property <string> pip: "M3 5 H21 V19 H3 Z M12 12 H19 V17 H12 Z";
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <length> size: 44px;
    callback clicked;
    width: root.size;
    height: root.size;
    Sq { r: root.size / 2; fill: ta.has-hover ? #ffffff40 : #000000a0; }
    Icon {
        commands: root.icon;
        width: root.size * 0.46;
        height: root.size * 0.46;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Progress inherits Rectangle {
    in property <float> value;
    in property <color> tint: Theme.ink;
    height: 3px;
    Sq { r: 1.5px; fill: #ffffff24; }
    Sq {
        x: 0px;
        width: max(3px, parent.width * min(1.0, max(0.0, root.value)));
        height: parent.height;
        r: 1.5px;
        fill: root.tint;
    }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked;
    height: 38px;
    horizontal-stretch: 0;
    width: t.preferred-width + 40px;
    Sq {
        r: 19px;
        fill: root.primary ? (ta.has-hover ? #e6e0ff : Theme.ink) : (ta.has-hover ? #ffffff30 : Theme.glass);
    }
    t := Text {
        text: root.label;
        color: root.primary ? Theme.bg : Theme.ink;
        font-size: 14px;
        font-weight: 600;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Tabs inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> current;
    spacing: 8px;
    alignment: start;
    height: 36px;
    for o[i] in root.options: Rectangle {
        width: t.preferred-width + 32px;
        Sq { r: 18px; fill: i == root.current ? Theme.ink : (ta.has-hover ? #ffffff30 : Theme.glass); }
        t := Text {
            text: o;
            color: i == root.current ? Theme.bg : Theme.ink;
            font-size: 14px;
            font-weight: i == root.current ? 700 : 400;
        }
        ta := TouchArea { clicked => { root.current = i; } }
    }
}

component Title inherits Text {
    color: Theme.dim;
    font-size: 15px;
    font-weight: 600;
}

component Ring inherits Rectangle {
    in property <bool> on;
    in property <length> r: 22px;
    Sq {
        r: root.r;
        stroke: root.on ? Theme.ink : transparent;
        stroke-width: 3px;
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    width: 52px;
    height: 30px;
    Sq { r: 15px; fill: root.on ? Theme.base.brighter(0.4) : #ffffff2e; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Theme.ink;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea { clicked => { root.on = !root.on; } }
}

// ───────────── Barra in alto e fascia di lancio ─────────────

component TopBar inherits HorizontalLayout {
    in-out property <int> page;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 22px;
    height: 70px;
    spacing: 16px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: "Sintonia";
            color: Theme.ink;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 4px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.needle;
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    Rectangle {
        width: 300px;
        height: 40px;
        Sq { r: 20px; fill: Theme.glass; }
        Text {
            x: 18px;
            text: T.search;
            color: Theme.faint;
            font-size: 14px;
        }
    }
    Text {
        text: "21:14";
        color: Theme.ink;
        font-size: 26px;
        font-weight: 300;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 40px;
            height: 40px;
            Sq { r: 20px; fill: root.page == 4 ? Theme.cat(4) : (gta.has-hover ? #ffffff30 : Theme.glass); }
            Icon { commands: Icons.gear; width: 22px; height: 22px; }
            gta := TouchArea { clicked => { root.page = 4; } }
        }
    }
}

component Dock inherits Rectangle {
    in-out property <int> current;
    height: 88px;
    property <length> dw: 640px;
    property <length> sw: root.dw / 4;
    Rectangle {
        width: root.dw + 40px;
        height: 66px;
        y: parent.height - self.height - 14px;
        Sq {
            r: 33px;
            fill: #1b1c26ec;
            stroke: #ffffff1c;
            stroke-width: 1px;
        }
        for i in 51: Rectangle {
            x: 20px + i * root.dw / 50 - 0.5px;
            y: parent.height - self.height - 9px;
            width: 1px;
            height: Math.mod(i, 10) == 5 ? 7px : (Math.mod(i, 5) == 0 ? 4px : 2px);
            background: Theme.faint;
        }
        Rectangle {
            x: 20px + root.current * root.sw + root.sw / 2 - 11px;
            y: parent.height - 13px;
            width: 22px;
            height: 4px;
            border-radius: 2px;
            background: Theme.needle;
            opacity: root.current < 4 ? 1 : 0;
            animate x { duration: 260ms; easing: ease-out; }
        }
        for it[i] in T.nav: Rectangle {
            x: 20px + i * root.sw + 4px;
            y: 8px;
            width: root.sw - 8px;
            height: 38px;
            Sq {
                r: 19px;
                fill: root.current == i ? Theme.cat(i) : (ta.has-hover ? #ffffff14 : transparent);
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                if root.current != i: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.cat(i).brighter(0.7);
                    }
                }
                Text {
                    text: it;
                    color: root.current == i ? Theme.ink : Theme.dim;
                    font-size: 15px;
                    font-weight: root.current == i ? 700 : 400;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea { clicked => { root.current = i; } }
        }
    }
}

// ───────────── Riga canale, anteprima ─────────────

component ChannelLine inherits Rectangle {
    in property <Channel> c;
    in property <bool> active;
    in property <bool> playing;
    callback clicked;
    callback activated;
    height: 52px;
    Sq {
        r: 16px;
        fill: root.active ? #ffffff26 : (ta.has-hover ? #ffffff10 : transparent);
        stroke: root.active ? Theme.ink : transparent;
        stroke-width: 2px;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            text: root.c.num;
            width: 50px;
            color: root.playing ? Theme.needle : (root.active ? Theme.ink : Theme.faint);
            font-size: 22px;
            font-weight: 300;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.c.name;
                color: Theme.ink;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.c.now;
                color: Theme.dim;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 60px;
            Progress { value: root.c.progress; tint: root.active ? Theme.ink : Theme.faint; }
        }
        Text {
            text: root.c.fav ? "★" : "";
            width: 14px;
            color: Theme.needle;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
}

// Stato del video (collegamento, attesa, errore); senza x/y si centra nel genitore
component StatusPill inherits Rectangle {
    in property <bool> small;
    width: st.preferred-width + (root.small ? 36px : 48px);
    height: root.small ? 34px : 44px;
    Sq { r: parent.height / 2; fill: #000000b0; }
    st := Text {
        text: T.status(Video.state);
        color: Video.state == 4 ? Theme.live : Theme.ink;
        font-size: root.small ? 13px : 15px;
        font-weight: 600;
    }
}

// Anteprima del canale: il video vero quando c'è, altrimenti il segnaposto colorato
component Preview inherits Rectangle {
    in property <Channel> c;
    in property <bool> badge: true;
    in property <length> r: 22px;
    in property <bool> live-video: true;
    Sq { r: root.r; fill: @linear-gradient(145deg, root.c.tint.darker(0.2) 0%, #090a10 90%); }
    Sq { r: root.r; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    if !(root.live-video && (Video.ready || T.status(Video.state) != "")): Text {
        text: root.c.name;
        color: #ffffff22;
        font-size: 52px;
        font-weight: 800;
    }
    if root.live-video: VideoView { r: root.r; }
    Sq { r: root.r; fill: @linear-gradient(180deg, #00000000 55%, #000000b0 100%); }
    if root.live-video && T.status(Video.state) != "": StatusPill { small: true; }
    if root.badge: Rectangle {
        x: 16px;
        y: 16px;
        height: 26px;
        width: lt.preferred-width + 30px;
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        lt := Text {
            x: 24px;
            text: T.live + " · " + root.c.num;
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
        }
    }
    Text {
        x: 18px;
        y: parent.height - self.height - 16px;
        text: root.c.now;
        color: Theme.ink;
        font-size: 16px;
        font-weight: 600;
    }
}

// ───────────── Home ─────────────

component HomeScreen inherits Rectangle {
    in property <[Channel]> channels;
    in property <[Resume]> resume;
    // il canale in onda, mostrato nell'anteprima
    in property <int> current;
    callback play(int);
    callback pip(int);
    property <Channel> hero: root.channels[root.current];
    VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 6px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 34px;
            alignment: start;
            height: 262px;
            Rectangle {
                width: 466px;
                Preview { c: root.hero; }
                Ring { on: hta.has-hover; }
                hta := TouchArea { clicked => { root.play(root.current); } }
            }
            VerticalLayout {
                width: 440px;
                alignment: center;
                spacing: 6px;
                Text {
                    text: T.on-now;
                    color: Theme.dim;
                    font-size: 14px;
                }
                Text {
                    text: root.hero.name;
                    color: Theme.ink;
                    font-size: 36px;
                    font-weight: 700;
                }
                Text {
                    text: root.hero.now;
                    color: Theme.ink;
                    font-size: 18px;
                }
                Text {
                    text: root.hero.start + " – " + root.hero.end + "  ·  " + T.channel + " " + root.hero.num;
                    color: Theme.dim;
                    font-size: 13px;
                }
                Progress { value: root.hero.progress; width: 320px; }
                Text {
                    text: T.next-at + " " + root.hero.next-time + ": " + root.hero.next;
                    color: Theme.faint;
                    font-size: 13px;
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn { label: T.watch; primary: true; clicked => { root.play(root.current); } }
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(root.current); } }
                }
            }
        }
        Rectangle { height: 12px; }
        Title { text: T.resume; }
        HorizontalLayout {
            spacing: 18px;
            alignment: start;
            height: 132px;
            for r[i] in root.resume: Rectangle {
                width: 236px;
                Sq { r: 22px; fill: @linear-gradient(135deg, Theme.panel.brighter(0.25) 0%, Theme.panel 100%); }
                VerticalLayout {
                    padding: 18px;
                    alignment: end;
                    spacing: 4px;
                    Text {
                        text: r.title;
                        color: Theme.ink;
                        font-size: 17px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: T.resume-sub(r.kind, r.mins, r.detail);
                        color: Theme.dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Rectangle { height: 4px; }
                    Progress { value: r.progress; }
                }
                Ring { on: rta.has-hover; }
                rta := TouchArea { clicked => { root.play(i == 0 ? 1 : 5); } }
            }
        }
        Rectangle { height: 8px; }
        Title { text: T.favorites; }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            height: 84px;
            for idx in [0, 2, 5, 9, 6]: Rectangle {
                width: 168px;
                Sq { r: 22px; fill: Theme.glass; }
                HorizontalLayout {
                    padding-left: 18px;
                    spacing: 12px;
                    Text {
                        text: root.channels[idx].num;
                        color: Theme.faint;
                        font-size: 24px;
                        font-weight: 300;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.channels[idx].name;
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Ring { on: fta.has-hover; }
                fta := TouchArea { clicked => { root.play(idx); } }
            }
        }
    }
}

// ───────────── Live ─────────────

component LiveScreen inherits Rectangle {
    in property <[Channel]> channels;
    in-out property <int> selected;
    in-out property <int> category: 0;
    callback play();
    callback pip();
    property <Channel> cur: root.channels[root.selected];

    function ensure-visible() {
        if (root.selected * 52px + fl.content-y < 0px) {
            fl.content-y = -root.selected * 52px;
        } else if ((root.selected + 1) * 52px + fl.content-y > fl.height) {
            fl.content-y = fl.height - (root.selected + 1) * 52px;
        }
    }
    init => { fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.selected = max(0, root.selected - 1);
                root.ensure-visible();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.selected = min(root.channels.length - 1, root.selected + 1);
                root.ensure-visible();
                return accept;
            }
            if (event.text == Key.Return) {
                root.play();
                return accept;
            }
            reject
        }
        HorizontalLayout {
            padding-left: 44px;
            padding-right: 44px;
            padding-top: 8px;
            spacing: 44px;
            VerticalLayout {
                width: 520px;
                spacing: 10px;
                Tabs {
                    options: T.cats;
                    current <=> root.category;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    fl := Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: root.channels.length * 52px;
                        for c[i] in root.channels: ChannelLine {
                            y: i * 52px;
                            width: fl.width;
                            c: c;
                            active: i == root.selected;
                            clicked => {
                                root.selected = i;
                                fs.focus();
                            }
                            activated => {
                                root.selected = i;
                                root.play();
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 6px;
                Preview {
                    height: 250px;
                    c: root.cur;
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.cur.name;
                    color: Theme.ink;
                    font-size: 32px;
                    font-weight: 700;
                }
                Text {
                    text: root.cur.now;
                    color: Theme.ink;
                    font-size: 18px;
                }
                Text {
                    text: root.cur.start + " – " + root.cur.end + (root.cur.hd ? "  ·  HD" : "");
                    color: Theme.dim;
                    font-size: 13px;
                }
                Progress { value: root.cur.progress; }
                Text {
                    text: root.cur.desc;
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Text {
                    text: T.next-at + " " + root.cur.next-time + ": " + root.cur.next;
                    color: Theme.faint;
                    font-size: 13px;
                }
                Rectangle { height: 12px; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn { label: T.watch; primary: true; clicked => { root.play(); } }
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                    Btn { label: root.cur.fav ? T.in-favs : T.add-fav; }
                }
            }
        }
    }
}

// ───────────── Guida ─────────────

component GuideScreen inherits Rectangle {
    in property <[GuideRow]> rows;
    in-out property <int> day: 1;
    property <length> ppm: 4px;
    property <length> chan-w: 190px;
    property <length> head: 40px;
    property <length> row-h: 58px;
    property <int> now-min: 74;

    pure function hhmm(m: int) -> string {
        return (20 + Math.floor(m / 60)) + ":" + (Math.mod(m, 60) < 10 ? "0" : "") + Math.mod(m, 60);
    }

    VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 8px;
        spacing: 16px;
        Tabs {
            options: T.days;
            current <=> root.day;
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            for t[i] in ["20:00", "20:30", "21:00", "21:30", "22:00", "22:30"]: Text {
                x: root.chan-w + i * 30 * root.ppm + 6px;
                y: 8px;
                text: t;
                color: Theme.dim;
                font-size: 13px;
            }
            for row[r] in root.rows: Rectangle {
                y: root.head + r * root.row-h;
                height: root.row-h;
                HorizontalLayout {
                    x: 0px;
                    width: root.chan-w;
                    spacing: 12px;
                    Text {
                        text: row.num;
                        width: 44px;
                        color: Theme.faint;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.name;
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                for p in row.progs: Rectangle {
                    property <bool> on-air: p.start <= root.now-min && p.start + p.dur > root.now-min;
                    x: root.chan-w + p.start * root.ppm + 2px;
                    y: 6px;
                    width: p.dur * root.ppm - 4px;
                    height: root.row-h - 12px;
                    clip: true;
                    Sq {
                        r: 14px;
                        fill: on-air ? Theme.base.with-alpha(0.6) : (pta.has-hover ? #ffffff1c : Theme.glass);
                        stroke: on-air ? Theme.needle : transparent;
                        stroke-width: 1.5px;
                    }
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: p.title;
                            color: on-air ? Theme.ink : Theme.dim;
                            font-size: 13px;
                            font-weight: on-air ? 600 : 400;
                            overflow: elide;
                        }
                        Text {
                            text: root.hhmm(p.start);
                            color: on-air ? Theme.dim : Theme.faint;
                            font-size: 11px;
                        }
                    }
                    pta := TouchArea { }
                }
            }
            Rectangle {
                x: root.chan-w + root.now-min * root.ppm - 1px;
                width: 2px;
                background: Theme.needle;
            }
        }
    }
}

