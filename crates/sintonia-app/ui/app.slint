}

component PosterScreen inherits Rectangle {
    in property <[Film]> films;
    in property <[Film]> series;
    property <int> mode: 0;
    property <[Film]> items: root.mode == 0 ? root.films : root.series;
    property <length> pw: 160px;
    property <length> ph: 230px;
    property <length> gap: 24px;
    property <length> cell-h: root.ph + 44px;
    property <int> cols: max(1, Math.floor((fl.width + root.gap) / (root.pw + root.gap)));
    VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 8px;
        spacing: 18px;
        Tabs {
            options: T.kinds;
            current <=> root.mode;
        }
        fl := Flickable {
            content-height: Math.ceil(root.items.length / root.cols) * root.cell-h;
            for f[i] in root.items: Poster {
                x: Math.mod(i, root.cols) * (root.pw + root.gap);
                y: Math.floor(i / root.cols) * root.cell-h;
                f: f;
                pw: root.pw;
                ph: root.ph;
            }
        }
    }
}

