// Sintonia: interfaccia (dalla bozza grafica v3 approvata).
// Le stringhe sono in inglese con @tr(); le traduzioni stanno in lang/<lingua>/LC_MESSAGES/sintonia-app.po.
// I dati arrivano da Rust: qui non c'è nessun canale.

// ───────────── Dati ─────────────

export struct ChannelItem {
    id: int,
    num: string,
    name: string,
    group: string,
    logo: image,
    has-logo: bool,
    tint: color,
    radio: bool,
    drm: bool,
}

// kind: 0 tutti i canali, 1 categoria della playlist, 2 senza categoria
export struct CategoryItem { name: string, count: int, kind: int }

export struct SourceItem { id: int, name: string, detail: string, count: int, active: bool, file: bool }

export struct TrackItem { id: int, label: string, selected: bool }

// Esito di «Verifica» o «Salva».
// state: 0 niente, 1 in corso, 2 verificata, 3 salvata, 4 errore
// error: 1 risposta HTTP, 2 rete, 3 file, 4 nessun canale, 5 troppo grande, 6 archivio, 7 campi mancanti
export struct SourceStatus { state: int, channels: int, groups: int, skipped: int, error: int, http: int, detail: string }

global Theme {
    in-out property <int> page: 0;
    out property <color> bg: #0e0f14;
    out property <color> panel: #1b1c26;
    out property <color> glass: #ffffff14;
    out property <color> ink: #ffffff;
    out property <color> dim: #b4b6c6;
    out property <color> faint: #7d8094;
    out property <color> live: #ff5d7a;
    out property <color> ok: #8fd18a;
    // un colore per sezione: Home, Live, Guida, Film e serie, Impostazioni
    public pure function cat(i: int) -> color {
        return i == 0 ? #6D5BB1 : (i == 1 ? #677C2F : (i == 2 ? #A06135 : (i == 3 ? #525C62 : #7C6969)));
    }
    out property <color> base: cat(page);
    out property <color> needle: base.brighter(0.9);
}

// Il video di libmpv. Rust disegna il fotogramma in una texture OpenGL grande quanto il riquadro
// (`w` × `h`), con gli angoli già ritagliati a super-ellisse di raggio `r`, e la passa in `frame`.
// Ogni finestra ha la sua istanza di questo global.
export global Video {
    in property <image> frame;
    // c'è un fotogramma del flusso corrente da mostrare
    in property <bool> ready;
    // 0 fermo, 1 collegamento, 2 in onda, 3 in attesa di dati, 4 errore, 5 riconnessione
    in property <int> state;
    // tentativo di riconnessione in corso
    in property <int> attempt;
    // scritte da `VideoView`, lette da Rust
    in-out property <length> w;
    in-out property <length> h;
    in-out property <length> r;
}

global Texts {
    public pure function status(state: int, attempt: int) -> string {
        return state == 1 ? @tr("Connecting to the channel…")
            : (state == 3 ? @tr("Waiting for the signal…")
            : (state == 4 ? @tr("The channel is not responding")
            : (state == 5 ? @tr("Reconnecting ({})…", attempt) : "")));
    }
    public pure function category(c: CategoryItem) -> string {
        return c.kind == 0 ? @tr("All channels") : (c.kind == 2 ? @tr("No category") : c.name);
    }
    public pure function channels(n: int) -> string {
        return @tr("{n} channel" | "{n} channels" % n);
    }
    public pure function source-error(s: SourceStatus) -> string {
        return s.error == 1 ? @tr("The server answered with error {}.", s.http)
            : (s.error == 2 ? @tr("Can't reach the server: {}", s.detail)
            : (s.error == 3 ? @tr("Can't read the file: {}", s.detail)
            : (s.error == 4 ? @tr("No channels found in this playlist.")
            : (s.error == 5 ? @tr("The playlist is too large.")
            : (s.error == 7 ? @tr("Fill in the name and the address.")
            : @tr("Something went wrong: {}", s.detail))))));
    }
    public pure function source-result(s: SourceStatus) -> string {
        if (s.state == 1) {
            return @tr("Reading the playlist…");
        }
        if (s.state == 4) {
            return source-error(s);
        }
        if (s.state != 2 && s.state != 3) {
            return "";
        }
        let counts = @tr("{n} channel" | "{n} channels" % s.channels) + " · " + @tr("{n} category" | "{n} categories" % s.groups);
        let skipped = s.skipped > 0 ? " · " + @tr("{n} line skipped" | "{n} lines skipped" % s.skipped) : "";
        return (s.state == 3 ? @tr("Saved.") + " " : "") + counts + skipped;
    }
}

// ───────────── Mattoncini ─────────────

// Rettangolo a super-ellisse: gli angoli sono curve continue (squircle), non archi di cerchio.
// Le coordinate sono intere, in centesimi di pixel: convertendo un numero decimale in testo Slint
// usa il separatore della lingua (in italiano la virgola) e il percorso non sarebbe più valido.
component Sq inherits Path {
    in property <length> r: 20px;
    property <int> w: round(root.width / 1px * 100);
    property <int> h: round(root.height / 1px * 100);
    property <int> p: round(min(root.r / 1px * 150, min(root.w, root.h) / 2));
    property <int> q: round(root.p / 4);
    viewbox-width: root.w;
    viewbox-height: root.h;
    fill: transparent;
    commands: "M " + root.p + " 0 L " + (root.w - root.p) + " 0 C " + (root.w - root.q) + " 0 " + root.w + " " + root.q + " " + root.w + " " + root.p
        + " L " + root.w + " " + (root.h - root.p) + " C " + root.w + " " + (root.h - root.q) + " " + (root.w - root.q) + " " + root.h + " " + (root.w - root.p) + " " + root.h
        + " L " + root.p + " " + root.h + " C " + root.q + " " + root.h + " 0 " + (root.h - root.q) + " 0 " + (root.h - root.p)
        + " L 0 " + root.p + " C 0 " + root.q + " " + root.q + " 0 " + root.p + " 0 Z";
}

// Il riquadro in cui compare il video. Ce n'è al massimo uno visibile per finestra.
component VideoView inherits Rectangle {
    in property <length> r: 0px;
    init => {
        Video.w = self.width;
        Video.h = self.height;
        Video.r = self.r;
    }
    changed width => { Video.w = self.width; }
    changed height => { Video.h = self.height; }
    changed r => { Video.r = self.r; }
    if Video.ready: Image {
        width: 100%;
        height: 100%;
        source: Video.frame;
        image-fit: fill;
    }
}

component Icon inherits Path {
    in property <color> tint: Theme.ink;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

global Icons {
    out property <string> home: "M3 11 L12 4 L21 11 M5.5 9.5 V20 H18.5 V9.5";
    out property <string> back: "M15 5 L8 12 L15 19";
    out property <string> gear: "M5 12 A7 7 0 1 0 19 12 A7 7 0 1 0 5 12 M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 M19 12 L22 12 M16.95 7.05 L19.07 4.93 M12 5 L12 2 M7.05 7.05 L4.93 4.93 M5 12 L2 12 M7.05 16.95 L4.93 19.07 M12 19 L12 22 M16.95 16.95 L19.07 19.07";
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> expand: "M14 4 H20 V10 M20 4 L13 11 M10 20 H4 V14 M4 20 L11 13";
    out property <string> pip: "M3 5 H21 V19 H3 Z M12 12 H19 V17 H12 Z";
    out property <string> search: "M4 11 A7 7 0 1 0 18 11 A7 7 0 1 0 4 11 M16 16 L21 21";
    out property <string> guide: "M3 5 H21 M3 12 H21 M3 19 H21 M8 3 V21";
    out property <string> film: "M4 4 H20 V20 H4 Z M8 4 V20 M16 4 V20 M4 9 H8 M4 15 H8 M16 9 H20 M16 15 H20";
    out property <string> plus: "M12 5 V19 M5 12 H19";
    out property <string> refresh: "M20 11 A8 8 0 1 0 18 17 M20 5 V11 H14";
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <length> size: 44px;
    callback clicked;
    width: root.size;
    height: root.size;
    Sq { r: root.size / 2; fill: ta.has-hover ? #ffffff40 : #000000a0; }
    Icon {
        commands: root.icon;
        width: root.size * 0.46;
        height: root.size * 0.46;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    horizontal-stretch: 0;
    width: t.preferred-width + 40px;
    opacity: root.enabled ? 1 : 0.4;
    Sq {
        r: 19px;
        fill: root.danger ? (ta.has-hover ? Theme.live.brighter(0.2) : Theme.live)
            : root.primary ? (ta.has-hover ? #e6e0ff : Theme.ink) : (ta.has-hover ? #ffffff30 : Theme.glass);
    }
    t := Text {
        text: root.label;
        color: root.primary && !root.danger ? Theme.bg : Theme.ink;
        font-size: 14px;
        font-weight: 600;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Tabs inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> current;
    in property <int> disabled-from: 999;
    spacing: 8px;
    alignment: start;
    height: 36px;
    for o[i] in root.options: Rectangle {
        width: t.preferred-width + 32px;
        opacity: i >= root.disabled-from ? 0.45 : 1;
        Sq { r: 18px; fill: i == root.current ? Theme.ink : (ta.has-hover ? #ffffff30 : Theme.glass); }
        t := Text {
            text: o;
            color: i == root.current ? Theme.bg : Theme.ink;
            font-size: 14px;
            font-weight: i == root.current ? 700 : 400;
        }
        ta := TouchArea { clicked => { root.current = i; } }
    }
}

component Title inherits Text {
    color: Theme.dim;
    font-size: 15px;
    font-weight: 600;
}

component Ring inherits Rectangle {
    in property <bool> on;
    in property <length> r: 22px;
    Sq {
        r: root.r;
        stroke: root.on ? Theme.ink : transparent;
        stroke-width: 3px;
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 52px;
    height: 30px;
    Sq { r: 15px; fill: root.on ? Theme.base.brighter(0.4) : #ffffff2e; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Theme.ink;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Stato del video (collegamento, attesa, errore); senza x/y si centra nel genitore
component StatusPill inherits Rectangle {
    in property <bool> small;
    width: st.preferred-width + (root.small ? 36px : 48px);
    height: root.small ? 34px : 44px;
    Sq { r: parent.height / 2; fill: #000000b0; }
    st := Text {
        text: Texts.status(Video.state, Video.attempt);
        color: Video.state == 4 ? Theme.live : Theme.ink;
        font-size: root.small ? 13px : 15px;
        font-weight: 600;
    }
}

// Logo del canale, o le iniziali su un colore se manca
component Logo inherits Rectangle {
    in property <ChannelItem> c;
    in property <length> r: 10px;
    Sq { r: root.r; fill: root.c.has-logo ? #ffffff10 : root.c.tint.darker(0.3); }
    if root.c.has-logo: Image {
        x: parent.width * 0.1;
        y: parent.height * 0.1;
        width: parent.width * 0.8;
        height: parent.height * 0.8;
        source: root.c.logo;
        image-fit: contain;
    }
    if !root.c.has-logo: Text {
        text: root.c.name;
        width: parent.width - 6px;
        horizontal-alignment: center;
        overflow: elide;
        color: #ffffffc0;
        font-size: min(parent.height * 0.32, 14px);
        font-weight: 700;
    }
}

// Messaggio al centro di una pagina vuota
component EmptyState inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    callback act();
    alignment: center;
    spacing: 12px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 72px;
            height: 72px;
            Sq { r: 36px; fill: Theme.glass; }
            Icon { commands: root.icon; width: 32px; height: 32px; tint: Theme.dim; }
        }
    }
    Text {
        text: root.title;
        color: Theme.ink;
        font-size: 24px;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: root.body;
        color: Theme.dim;
        font-size: 15px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        Btn { label: root.action; primary: true; clicked => { root.act(); } }
    }
}

// ───────────── Barra in alto e fascia di lancio ─────────────

component TopBar inherits HorizontalLayout {
    in-out property <int> page;
    in property <string> clock;
    in-out property <string> search;
    callback search-edited(string);
    callback search-done();
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 22px;
    height: 70px;
    spacing: 16px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: "Sintonia";
            color: Theme.ink;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 4px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.needle;
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    Rectangle {
        width: 300px;
        height: 40px;
        Sq {
            r: 20px;
            fill: Theme.glass;
            stroke: si.has-focus ? Theme.ink : transparent;
            stroke-width: 2px;
        }
        Icon { x: 14px; commands: Icons.search; width: 16px; height: 16px; tint: Theme.faint; }
        // i tasti che la casella non usa (Esc, ↓) salgono a questo FocusScope
        FocusScope {
            x: 40px;
            width: parent.width - 54px;
            height: parent.height;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.search = "";
                    root.search-edited("");
                    root.search-done();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.search-done();
                    return accept;
                }
                reject
            }
            si := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.search;
                color: Theme.ink;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.search-edited(self.text); }
                accepted => { root.search-done(); }
            }
        }
        if root.search == "": Text {
            x: 40px;
            text: @tr("Search channels");
            color: Theme.faint;
            font-size: 14px;
        }
    }
    Text {
        text: root.clock;
        color: Theme.ink;
        font-size: 26px;
        font-weight: 300;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 40px;
            height: 40px;
            Sq { r: 20px; fill: root.page == 4 ? Theme.cat(4) : (gta.has-hover ? #ffffff30 : Theme.glass); }
            Icon { commands: Icons.gear; width: 22px; height: 22px; }
            gta := TouchArea { clicked => { root.page = 4; } }
        }
    }
}

component Dock inherits Rectangle {
    in-out property <int> current;
    in property <[string]> labels;
    height: 88px;
    property <length> dw: 640px;
    property <length> sw: root.dw / 4;
    Rectangle {
        width: root.dw + 40px;
        height: 66px;
        y: parent.height - self.height - 14px;
        Sq {
            r: 33px;
            fill: #1b1c26ec;
            stroke: #ffffff1c;
            stroke-width: 1px;
        }
        for i in 51: Rectangle {
            x: 20px + i * root.dw / 50 - 0.5px;
            y: parent.height - self.height - 9px;
            width: 1px;
            height: Math.mod(i, 10) == 5 ? 7px : (Math.mod(i, 5) == 0 ? 4px : 2px);
            background: Theme.faint;
        }
        Rectangle {
            x: 20px + root.current * root.sw + root.sw / 2 - 11px;
            y: parent.height - 13px;
            width: 22px;
            height: 4px;
            border-radius: 2px;
            background: Theme.needle;
            opacity: root.current < 4 ? 1 : 0;
            animate x { duration: 260ms; easing: ease-out; }
        }
        for it[i] in root.labels: Rectangle {
            x: 20px + i * root.sw + 4px;
            y: 8px;
            width: root.sw - 8px;
            height: 38px;
            Sq {
                r: 19px;
                fill: root.current == i ? Theme.cat(i) : (ta.has-hover ? #ffffff14 : transparent);
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                if root.current != i: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.cat(i).brighter(0.7);
                    }
                }
                Text {
                    text: it;
                    color: root.current == i ? Theme.ink : Theme.dim;
                    font-size: 15px;
                    font-weight: root.current == i ? 700 : 400;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea { clicked => { root.current = i; } }
        }
    }
}

// ───────────── Elenchi ─────────────

component ChannelLine inherits Rectangle {
    in property <ChannelItem> c;
    in property <bool> active;
    in property <bool> playing;
    callback clicked;
    callback activated;
    height: 52px;
    Sq {
        r: 16px;
        fill: root.active ? #ffffff26 : (ta.has-hover ? #ffffff10 : transparent);
        stroke: root.active ? Theme.ink : transparent;
        stroke-width: 2px;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            text: root.c.num;
            width: 46px;
            color: root.playing ? Theme.needle : (root.active ? Theme.ink : Theme.faint);
            font-size: 20px;
            font-weight: 300;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Logo { c: root.c; width: 48px; height: 32px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.c.name;
                color: Theme.ink;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.c.group;
                color: Theme.dim;
                font-size: 12px;
                overflow: elide;
            }
        }
        Text {
            text: root.playing ? "●" : "";
            width: 14px;
            color: Theme.live;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }
}

// Elenco virtualizzato: disegna solo le righe visibili, quindi regge decine di migliaia di canali.
component ChannelList inherits Rectangle {
    in property <[ChannelItem]> model;
    in-out property <int> cursor;
    in property <int> playing-id: -1;
    callback clicked(int);
    callback activated(int);
    property <length> row-h: 52px;
    property <int> count: root.model.length;
    clip: true;

    public function ensure-visible() {
        if (root.cursor * root.row-h + fl.content-y < 0px) {
            fl.content-y = -root.cursor * root.row-h;
        } else if ((root.cursor + 1) * root.row-h + fl.content-y > fl.height) {
            fl.content-y = fl.height - (root.cursor + 1) * root.row-h;
        }
    }
    public function to-top() {
        fl.content-y = 0px;
    }

    fl := Flickable {
        content-height: root.count * root.row-h;
        property <int> first: max(0, floor(-self.content-y / root.row-h));
        property <int> shown: min(root.count, ceil(self.height / root.row-h) + 1);
        for i in fl.shown: ChannelLine {
            property <int> index: fl.first + i;
            x: 0px;
            y: self.index * root.row-h;
            width: fl.width;
            visible: self.index < root.count;
            c: root.model[self.index];
            active: self.index == root.cursor;
            playing: root.model[self.index].id == root.playing-id;
            clicked => { root.clicked(self.index); }
            activated => { root.activated(self.index); }
        }
    }
}

// Colonna delle categorie (scelta B): poche centinaia di righe, un `for` basta
component CategoryList inherits Rectangle {
    in property <[CategoryItem]> model;
    in property <int> current;
    in property <bool> searching;
    callback picked(int);
    clip: true;
    property <length> row-h: 40px;
    Flickable {
        content-height: root.model.length * root.row-h;
        for c[i] in root.model: cr := Rectangle {
            x: 0px;
            y: i * root.row-h;
            width: parent.width;
            height: root.row-h - 4px;
            property <bool> on: i == root.current && !root.searching;
            Sq {
                r: 14px;
                fill: cr.on ? Theme.base : (cta.has-hover ? #ffffff10 : transparent);
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: Texts.category(c);
                    color: cr.on ? Theme.ink : Theme.dim;
                    font-size: 14px;
                    font-weight: cr.on ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: c.count;
                    color: cr.on ? Theme.ink : Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            cta := TouchArea { clicked => { root.picked(i); } }
        }
    }
}

// Anteprima del canale: il video vero quando c'è, altrimenti il segnaposto colorato
component Preview inherits Rectangle {
    in property <ChannelItem> c;
    in property <bool> badge: true;
    in property <length> r: 22px;
    in property <bool> live-video: true;
    Sq { r: root.r; fill: @linear-gradient(145deg, root.c.tint.darker(0.2) 0%, #090a10 90%); }
    Sq { r: root.r; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    if !(root.live-video && (Video.ready || Texts.status(Video.state, Video.attempt) != "")): Logo {
        c: root.c;
        width: min(parent.width * 0.4, 220px);
        height: self.width * 0.6;
        r: 16px;
    }
    if root.live-video: VideoView { r: root.r; }
    Sq { r: root.r; fill: @linear-gradient(180deg, #00000000 55%, #000000b0 100%); }
    if root.live-video && Texts.status(Video.state, Video.attempt) != "": StatusPill { small: true; }
    if root.badge: Rectangle {
        x: 16px;
        y: 16px;
        height: 26px;
        width: lt.preferred-width + 30px;
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        lt := Text {
            x: 24px;
            text: @tr("On air") + " · " + root.c.num;
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
        }
    }
    Text {
        x: 18px;
        y: parent.height - self.height - 16px;
        width: parent.width - 36px;
        text: root.c.name;
        color: Theme.ink;
        font-size: 16px;
        font-weight: 600;
        overflow: elide;
    }
}

// ───────────── Home ─────────────

component HomeScreen inherits Rectangle {
    in property <ChannelItem> hero;
    in property <bool> has-hero;
    in property <bool> no-source;
    in property <[CategoryItem]> categories;
    callback play();
    callback pip();
    // indice nella lista completa delle categorie (0 è «Tutti i canali»)
    callback open-category(int);
    callback add-source();

    if root.no-source: EmptyState {
        icon: Icons.plus;
        title: @tr("Welcome to Sintonia");
        body: @tr("Sintonia doesn't provide channels: add your own M3U playlist to start.");
        action: @tr("Add a playlist");
        act => { root.add-source(); }
    }
    if !root.no-source: VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 6px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 34px;
            alignment: start;
            height: 262px;
            Rectangle {
                width: 466px;
                Preview { c: root.hero; }
                Ring { on: hta.has-hover; }
                hta := TouchArea { clicked => { root.play(); } }
            }
            VerticalLayout {
                width: 440px;
                alignment: center;
                spacing: 6px;
                Text {
                    text: @tr("On now");
                    color: Theme.dim;
                    font-size: 14px;
                }
                Text {
                    text: root.hero.name;
                    color: Theme.ink;
                    font-size: 36px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.hero.group;
                    color: Theme.ink;
                    font-size: 18px;
                }
                Text {
                    text: @tr("Channel {}", root.hero.num);
                    color: Theme.dim;
                    font-size: 13px;
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn { label: @tr("Watch"); primary: true; clicked => { root.play(); } }
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                }
            }
        }
        Rectangle { height: 12px; }
        Title { text: @tr("Categories"); }
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            height: 84px;
            for c[i] in root.categories: Rectangle {
                width: 200px;
                Sq { r: 22px; fill: Theme.glass; }
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Texts.category(c);
                        color: Theme.ink;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: Texts.channels(c.count);
                        color: Theme.dim;
                        font-size: 12px;
                    }
                }
                Ring { on: fta.has-hover; }
                // le categorie della Home sono quelle della lista completa a partire dalla seconda
                fta := TouchArea { clicked => { root.open-category(i + 1); } }
            }
        }
    }
}

// ───────────── Live ─────────────

component LiveScreen inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <int> category;
    in property <string> search;
    in-out property <int> cursor;
    in property <int> playing-id;
    in property <bool> no-source;
    callback play(int);
    callback pip(int);
    callback pick-category(int);
    callback cursor-moved(int);
    callback add-source();
    // cambia quando la ricerca in alto passa il controllo all'elenco
    in property <int> focus-tick;
    property <ChannelItem> cur: root.channels[root.cursor];

    changed focus-tick => { fs.focus(); }
    function move(delta: int) {
        if (root.channels.length == 0) { return; }
        root.cursor = max(0, min(root.channels.length - 1, root.cursor + delta));
        list.ensure-visible();
        root.cursor-moved(root.cursor);
    }
    init => { fs.focus(); }
    changed category => { list.to-top(); }
    changed search => { list.to-top(); }

    if root.no-source: EmptyState {
        icon: Icons.plus;
        title: @tr("No playlist yet");
        body: @tr("Add your M3U playlist in Settings to see your channels here.");
        action: @tr("Add a playlist");
        act => { root.add-source(); }
    }
    fs := FocusScope {
        enabled: !root.no-source;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.move(-1); return accept; }
            if (event.text == Key.DownArrow) { root.move(1); return accept; }
            if (event.text == Key.PageUp) { root.move(-10); return accept; }
            if (event.text == Key.PageDown) { root.move(10); return accept; }
            if (event.text == Key.Return && root.channels.length > 0) { root.play(root.cursor); return accept; }
            reject
        }
        HorizontalLayout {
            visible: !root.no-source;
            padding-left: 44px;
            padding-right: 44px;
            padding-top: 8px;
            spacing: 24px;
            VerticalLayout {
                width: 230px;
                spacing: 10px;
                Title { text: @tr("Categories"); }
                CategoryList {
                    vertical-stretch: 1;
                    model: root.categories;
                    current: root.category;
                    searching: root.search != "";
                    picked(i) => {
                        root.pick-category(i);
                        fs.focus();
                    }
                }
            }
            VerticalLayout {
                width: 440px;
                spacing: 10px;
                Title {
                    text: root.search != "" ? @tr("Results for “{}”: {}", root.search, root.channels.length)
                        : Texts.channels(root.channels.length);
                }
                list := ChannelList {
                    vertical-stretch: 1;
                    model: root.channels;
                    cursor <=> root.cursor;
                    playing-id: root.playing-id;
                    clicked(i) => {
                        root.cursor = i;
                        root.cursor-moved(i);
                        fs.focus();
                    }
                    activated(i) => {
                        root.cursor = i;
                        root.play(i);
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 6px;
                if root.channels.length > 0: Preview {
                    height: 250px;
                    c: root.cur;
                    live-video: root.cur.id == root.playing-id;
                }
                if root.channels.length > 0: Rectangle { height: 10px; }
                if root.channels.length > 0: Text {
                    text: root.cur.name;
                    color: Theme.ink;
                    font-size: 30px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if root.channels.length > 0: Text {
                    text: root.cur.group;
                    color: Theme.dim;
                    font-size: 15px;
                }
                if root.cur.drm && root.channels.length > 0: Text {
                    text: @tr("This channel declares a DRM protection: it may not play.");
                    color: Theme.faint;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if root.channels.length > 0: Rectangle { height: 12px; }
                if root.channels.length > 0: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn { label: @tr("Watch"); primary: true; clicked => { root.play(root.cursor); } }
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(root.cursor); } }
                }
                if root.channels.length == 0 && root.search != "": Text {
                    text: @tr("No channels match your search.");
                    color: Theme.dim;
                    font-size: 15px;
                }
            }
        }
    }
}

// ───────────── Impostazioni ─────────────

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> value;
    callback edited(string);
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 13px;
        color: Theme.dim;
    }
    Rectangle {
        height: 44px;
        Sq {
            r: 22px;
            fill: Theme.glass;
            stroke: ti.has-focus ? Theme.ink : transparent;
            stroke-width: 2px;
        }
        ti := TextInput {
            x: 18px;
            width: parent.width - 36px;
            height: parent.height;
            text <=> root.value;
            color: Theme.ink;
            font-size: 15px;
            vertical-alignment: center;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            edited => { root.edited(self.text); }
        }
        if root.value == "": Text {
            x: 18px;
            text: root.placeholder;
            color: Theme.faint;
            font-size: 15px;
        }
    }
}

component SetRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 52px;
    Sq {
        r: 18px;
        fill: root.active ? #ffffff26 : (ta.has-hover ? #ffffff10 : transparent);
        stroke: root.active ? Theme.ink : transparent;
        stroke-width: 2px;
    }
    Text {
        x: 22px;
        text: root.label;
        color: root.active ? Theme.ink : Theme.dim;
        font-size: 16px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: left;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SourceRow inherits Rectangle {
    in property <SourceItem> s;
    in property <bool> working;
    callback activate();
    callback refresh();
    callback remove();
    property <bool> confirm: false;
    height: 104px;
    Sq {
        r: 20px;
        fill: root.s.active ? #ffffff1c : Theme.glass;
        stroke: root.s.active ? Theme.needle : transparent;
        stroke-width: 1.5px;
    }
    VerticalLayout {
        padding-left: 20px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.s.name;
                color: Theme.ink;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.s.active ? @tr("In use") : "";
                color: Theme.needle;
                font-size: 13px;
                font-weight: 700;
            }
        }
        Text {
            text: (root.s.file ? @tr("File") : @tr("M3U link")) + " · " + root.s.detail + " · " + Texts.channels(root.s.count);
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
        }
        Rectangle { height: 4px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.s.active: Btn {
                label: @tr("Use");
                height: 30px;
                enabled: !root.working;
                clicked => { root.activate(); }
            }
            Btn {
                label: @tr("Refresh");
                height: 30px;
                enabled: !root.working;
                clicked => { root.refresh(); }
            }
            Btn {
                label: root.confirm ? @tr("Confirm delete") : @tr("Delete");
                height: 30px;
                danger: root.confirm;
                enabled: !root.working;
                clicked => {
                    if (root.confirm) {
                        root.remove();
                        root.confirm = false;
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> on;
    callback toggled(bool);
    height: 66px;
    Sq { r: 22px; fill: Theme.glass; }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 16px;
                font-weight: 600;
            }
            Text {
                text: root.detail;
                color: Theme.dim;
                font-size: 12px;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on <=> root.on;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component SettingsScreen inherits Rectangle {
    in-out property <int> section: 0;
    in property <[SourceItem]> sources;
    in property <bool> working;
    in property <SourceStatus> status;
    in property <int> language;
    in-out property <bool> reconnect;
    in-out property <bool> fullscreen-start;
    in-out property <string> user-agent;
    in-out property <string> picked-file;
    callback verify(int, string, string, string);
    callback save(int, string, string, string);
    callback pick-file();
    callback activate-source(int);
    callback refresh-source(int);
    callback delete-source(int);
    callback set-language(int);
    callback setting-changed(string, string);

    // 0 link M3U, 1 file, 2 Xtream (arriva in M2)
    property <int> kind: 0;
    property <string> name;
    property <string> link;
    property <string> source-ua;

    HorizontalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 8px;
        spacing: 44px;
        VerticalLayout {
            width: 260px;
            alignment: start;
            spacing: 6px;
            for s[i] in [@tr("Sources"), @tr("Language"), @tr("Playback")]: SetRow {
                label: s;
                active: root.section == i;
                clicked => { root.section = i; }
            }
        }
        // sorgenti
        if root.section == 0: HorizontalLayout {
            spacing: 44px;
            VerticalLayout {
                width: 380px;
                spacing: 8px;
                Title { text: @tr("Your sources"); }
                Flickable {
                    vertical-stretch: 1;
                    content-height: root.sources.length * 112px;
                    for s[i] in root.sources: SourceRow {
                        x: 0px;
                        y: i * 112px;
                        width: parent.width;
                        s: s;
                        working: root.working;
                        activate => { root.activate-source(s.id); }
                        refresh => { root.refresh-source(s.id); }
                        remove => { root.delete-source(s.id); }
                    }
                }
                Text {
                    text: @tr("Sintonia doesn't provide channels: add your own playlist or account.");
                    color: Theme.faint;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { height: 12px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 14px;
                Title { text: @tr("Add a source"); }
                Tabs {
                    options: [@tr("M3U link"), @tr("File"), "Xtream Codes"];
                    current <=> root.kind;
                    disabled-from: 2;
                }
                if root.kind == 2: Text {
                    text: @tr("Xtream Codes accounts are coming in the next version.");
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                if root.kind < 2: Field { label: @tr("Name"); placeholder: @tr("My playlist"); value <=> root.name; }
                if root.kind == 0: Field {
                    label: @tr("Playlist address");
                    placeholder: "http://…/playlist.m3u8";
                    value <=> root.link;
                }
                if root.kind == 1: HorizontalLayout {
                    spacing: 10px;
                    Field {
                        label: @tr("File");
                        placeholder: @tr("Choose an .m3u or .m3u8 file");
                        value <=> root.picked-file;
                    }
                    VerticalLayout {
                        alignment: end;
                        Btn { label: @tr("Choose…"); height: 44px; clicked => { root.pick-file(); } }
                    }
                }
                if root.kind < 2: Field {
                    label: @tr("User-agent (optional)");
                    placeholder: @tr("only if your provider asks for one");
                    value <=> root.source-ua;
                }
                if root.kind < 2: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Btn {
                        label: @tr("Verify");
                        enabled: !root.working;
                        clicked => { root.verify(root.kind, root.name, root.kind == 0 ? root.link : root.picked-file, root.source-ua); }
                    }
                    Btn {
                        label: @tr("Save");
                        primary: true;
                        enabled: !root.working;
                        clicked => { root.save(root.kind, root.name, root.kind == 0 ? root.link : root.picked-file, root.source-ua); }
                    }
                }
                if root.kind < 2 && root.status.state != 0: Text {
                    text: Texts.source-result(root.status);
                    color: root.status.state == 4 ? Theme.live : (root.status.state == 1 ? Theme.dim : Theme.ok);
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
        // lingua
        if root.section == 1: VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 12px;
            Title { text: @tr("Interface language"); }
            for l[i] in ["Italiano", "English"]: Rectangle {
                height: 72px;
                max-width: 520px;
                Sq {
                    r: 24px;
                    fill: root.language == i ? #ffffff26 : Theme.glass;
                    stroke: root.language == i ? Theme.ink : transparent;
                    stroke-width: 2px;
                }
                Text {
                    x: 26px;
                    text: l;
                    color: Theme.ink;
                    font-size: 20px;
                    font-weight: root.language == i ? 700 : 400;
                    horizontal-alignment: left;
                }
                Text {
                    x: parent.width - self.width - 26px;
                    text: root.language == i ? "●" : "";
                    color: Theme.needle;
                    font-size: 18px;
                }
                TouchArea { clicked => { root.set-language(i); } }
            }
            Text {
                text: @tr("Changes immediately, no restart needed.");
                color: Theme.faint;
                font-size: 13px;
            }
        }
        // riproduzione
        if root.section == 2: VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 10px;
            Title { text: @tr("Playback"); }
            SwitchRow {
                label: @tr("Reconnect automatically");
                detail: @tr("If the stream drops, retry with growing delays.");
                on <=> root.reconnect;
                toggled(v) => { root.setting-changed("reconnect", v ? "1" : "0"); }
            }
            SwitchRow {
                label: @tr("Start in full screen");
                detail: @tr("The player opens full screen.");
                on <=> root.fullscreen-start;
                toggled(v) => { root.setting-changed("fullscreen_start", v ? "1" : "0"); }
            }
            Rectangle { height: 6px; }
            Field {
                label: @tr("Custom user-agent");
                placeholder: @tr("leave empty for the default");
                value <=> root.user-agent;
                edited(v) => { root.setting-changed("user_agent", v); }
            }
        }
    }
}

// ───────────── Player con elenco canali (clic destro) ─────────────

component TrackRow inherits Rectangle {
    in property <TrackItem> t;
    callback clicked;
    height: 40px;
    Sq { r: 14px; fill: root.t.selected ? #ffffff26 : (ta.has-hover ? #ffffff14 : transparent); }
    Text {
        x: 16px;
        text: root.t.label;
        color: Theme.ink;
        font-size: 14px;
        font-weight: root.t.selected ? 700 : 400;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PlayerScreen inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <int> category;
    in property <string> search;
    in property <ChannelItem> c;
    in property <[TrackItem]> audio-tracks;
    in property <[TrackItem]> sub-tracks;
    in property <bool> any-sub-selected;
    // 0 automatico, 1 16:9, 2 4:3, 3 riempi
    in property <int> aspect;
    in-out property <int> cursor;
    callback back();
    callback home();
    callback pip();
    callback toggle-fullscreen();
    callback zap(int);
    callback play(int);
    callback pick-category(int);
    callback load-tracks();
    callback select-audio(int);
    callback select-sub(int);
    callback cycle-aspect();
    property <bool> overlay: true;
    property <bool> drawer: false;
    background: #000000;

    function toggle-drawer() {
        root.drawer = !root.drawer;
        if (root.drawer) {
            dl.ensure-visible();
        }
    }
    function move(delta: int) {
        root.cursor = max(0, min(root.channels.length - 1, root.cursor + delta));
        dl.ensure-visible();
    }
    init => { fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                if (root.drawer) { root.move(-1); } else { root.zap(-1); root.overlay = true; }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.drawer) { root.move(1); } else { root.zap(1); root.overlay = true; }
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.drawer) { root.play(root.cursor); } else { root.toggle-drawer(); }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.drawer) { root.drawer = false; } else { root.back(); }
                return accept;
            }
            if (event.text == "p" || event.text == "P") {
                root.pip();
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == " ") {
                root.overlay = !root.overlay;
                return accept;
            }
            reject
        }
    }

    // il video; sotto, il segnaposto finché non arriva il primo fotogramma
    Rectangle {
        background: @linear-gradient(160deg, root.c.tint.darker(0.45) 0%, #05060f 80%);
    }
    if !Video.ready && Texts.status(Video.state, Video.attempt) == "": Text {
        text: root.c.num;
        color: #ffffff14;
        font-size: 300px;
        font-weight: 200;
    }
    VideoView { }
    if Texts.status(Video.state, Video.attempt) != "": StatusPill { }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.toggle-drawer();
                fs.focus();
            }
        }
        clicked => {
            if (root.drawer) { root.drawer = false; } else { root.overlay = !root.overlay; }
            fs.focus();
        }
        double-clicked => { root.toggle-fullscreen(); }
    }

    // in alto a sinistra: indietro e home
    HorizontalLayout {
        x: 36px;
        y: 28px;
        spacing: 10px;
        opacity: root.overlay && !root.drawer ? 1 : 0;
        animate opacity { duration: 200ms; }
        IconBtn { icon: Icons.back; clicked => { root.back(); } }
        IconBtn { icon: Icons.home; clicked => { root.home(); } }
    }
    Text {
        x: 36px;
        y: 88px;
        text: @tr("Right-click the video: channel list  ·  P: mini player  ·  F: full screen");
        color: #ffffff80;
        font-size: 13px;
        opacity: root.overlay && !root.drawer ? 1 : 0;
        animate opacity { duration: 200ms; }
    }

    // barra in basso
    Rectangle {
        y: parent.height - self.height;
        height: 190px;
        opacity: root.overlay ? 1 : 0;
        animate opacity { duration: 200ms; }
        background: @linear-gradient(180deg, #00000000 0%, #000000d0 100%);
        HorizontalLayout {
            padding: 40px;
            padding-bottom: 30px;
            spacing: 24px;
            alignment: stretch;
            Text {
                text: root.c.num;
                color: Theme.ink;
                font-size: 56px;
                font-weight: 200;
                vertical-alignment: bottom;
            }
            VerticalLayout {
                alignment: end;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "● " + @tr("On air");
                    color: Theme.live;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: root.c.name;
                    color: Theme.ink;
                    font-size: 22px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.c.group;
                    color: Theme.dim;
                    font-size: 13px;
                }
            }
            VerticalLayout {
                alignment: end;
                HorizontalLayout {
                    spacing: 10px;
                    IconBtn { icon: Icons.pip; size: 38px; clicked => { root.pip(); } }
                    Btn {
                        label: @tr("Audio");
                        clicked => {
                            root.load-tracks();
                            audio-popup.show();
                        }
                    }
                    Btn {
                        label: @tr("Subtitles");
                        clicked => {
                            root.load-tracks();
                            sub-popup.show();
                        }
                    }
                    Btn {
                        label: root.aspect == 1 ? "16:9" : (root.aspect == 2 ? "4:3" : (root.aspect == 3 ? @tr("Fill") : @tr("Auto")));
                        clicked => { root.cycle-aspect(); }
                    }
                }
            }
        }
    }

    audio-popup := PopupWindow {
        x: root.width - 470px;
        y: root.height - 110px - self.height;
        width: 300px;
        height: max(1, root.audio-tracks.length) * 44px + 56px;
        Sq { r: 22px; fill: #14151cf4; stroke: #ffffff22; stroke-width: 1px; }
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text {
                text: @tr("Audio");
                color: Theme.dim;
                font-size: 13px;
                height: 28px;
                vertical-alignment: center;
            }
            if root.audio-tracks.length == 0: Text {
                text: @tr("Only one audio track");
                color: Theme.faint;
                font-size: 14px;
                height: 40px;
                vertical-alignment: center;
            }
            for t in root.audio-tracks: TrackRow {
                t: t;
                clicked => { root.select-audio(t.id); }
            }
        }
    }
    sub-popup := PopupWindow {
        x: root.width - 370px;
        y: root.height - 110px - self.height;
        width: 300px;
        height: (root.sub-tracks.length + 1) * 44px + 56px;
        Sq { r: 22px; fill: #14151cf4; stroke: #ffffff22; stroke-width: 1px; }
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text {
                text: @tr("Subtitles");
                color: Theme.dim;
                font-size: 13px;
                height: 28px;
                vertical-alignment: center;
            }
            TrackRow {
                t: { id: -1, label: @tr("Off"), selected: !(root.sub-tracks.length > 0 && root.any-sub-selected) };
                clicked => { root.select-sub(-1); }
            }
            for t in root.sub-tracks: TrackRow {
                t: t;
                clicked => { root.select-sub(t.id); }
            }
        }
    }

    // l'elenco canali che scorre da sinistra, con le categorie
    Rectangle {
        x: root.drawer ? 16px : -self.width - 30px;
        y: 16px;
        width: 760px;
        height: parent.height - 32px;
        animate x { duration: 240ms; easing: ease-out; }
        Sq {
            r: 36px;
            fill: #14151cf4;
            stroke: #ffffff22;
            stroke-width: 1px;
        }
        TouchArea { }
        VerticalLayout {
            padding-top: 26px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            Title { text: @tr("Channels"); }
            HorizontalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                CategoryList {
                    width: 220px;
                    model: root.categories;
                    current: root.category;
                    searching: root.search != "";
                    picked(i) => {
                        root.pick-category(i);
                        fs.focus();
                    }
                }
                dl := ChannelList {
                    horizontal-stretch: 1;
                    model: root.channels;
                    cursor <=> root.cursor;
                    playing-id: root.c.id;
                    clicked(i) => {
                        root.cursor = i;
                        root.play(i);
                        fs.focus();
                    }
                    activated(i) => { root.play(i); }
                }
            }
            Text {
                text: @tr("↑ ↓ browse   ·   Enter watch   ·   Esc close");
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
                height: 44px;
            }
        }
    }
}

// ───────────── Mini player: finestra a parte, sopra le altre applicazioni ─────────────

export component PipWindow inherits Window {
    in property <string> num;
    in property <string> name;
    in property <color> tint: #3b82f6;
    callback expand();
    callback dismiss();
    callback moved(length, length);
    title: "Sintonia mini player";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 360px;
    preferred-height: 203px;
    min-width: 360px;
    max-width: 360px;
    min-height: 203px;
    max-height: 203px;
    default-font-family: "Bahnschrift";

    Sq { r: 24px; fill: @linear-gradient(145deg, root.tint.darker(0.2) 0%, #090a10 90%); }
    Sq { r: 24px; fill: @radial-gradient(circle, #ffffff1a 0%, transparent 70%); }
    if !Video.ready && Texts.status(Video.state, Video.attempt) == "": Text {
        text: root.name;
        color: #ffffff22;
        font-size: 40px;
        font-weight: 800;
    }
    VideoView { r: 24px; }
    Sq { r: 24px; fill: @linear-gradient(180deg, #00000000 50%, #000000b0 100%); }
    if Texts.status(Video.state, Video.attempt) != "": StatusPill { small: true; }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
    Rectangle {
        x: 16px;
        y: 14px;
        height: 26px;
        width: min(pl.preferred-width + 32px, root.width - 120px);
        Sq { r: 13px; fill: #000000a0; }
        Rectangle {
            x: 11px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.live;
        }
        pl := Text {
            x: 24px;
            width: parent.width - 32px;
            text: root.num + " · " + root.name;
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
        }
    }
    HorizontalLayout {
        x: root.width - 92px;
        y: 10px;
        width: 80px;
        spacing: 6px;
        alignment: end;
        IconBtn { icon: Icons.expand; size: 34px; clicked => { root.expand(); } }
        IconBtn { icon: Icons.close; size: 34px; clicked => { root.dismiss(); } }
    }
}

// ───────────── Finestra principale ─────────────

export component MainWindow inherits Window {
    title: "Sintonia";
    preferred-width: 1320px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 700px;
    background: Theme.bg;
    default-font-family: "Bahnschrift";

    in-out property <int> page <=> Theme.page;
    in-out property <bool> playing: false;
    in property <string> clock;

    // canali della sorgente in uso, già filtrati per categoria o ricerca
    in property <[ChannelItem]> channels;
    in property <[CategoryItem]> categories;
    in property <[CategoryItem]> top-categories;
    in property <int> category: 0;
    in-out property <string> search;
    // riga evidenziata nell'elenco
    in-out property <int> cursor: 0;
    // il canale in onda
    in property <ChannelItem> current;
    in property <bool> has-current;
    in property <bool> no-source: true;

    // impostazioni
    in property <[SourceItem]> sources;
    in property <bool> working;
    in property <SourceStatus> source-status;
    in property <int> language;
    in-out property <bool> reconnect: true;
    in-out property <bool> fullscreen-start;
    in-out property <string> user-agent;
    in-out property <string> picked-file;
    in-out property <int> settings-section: 0;

    // player
    in property <[TrackItem]> audio-tracks;
    in property <[TrackItem]> sub-tracks;
    in property <bool> any-sub-selected;
    in property <int> aspect;
    property <int> live-focus-tick;

    // c'è un riquadro video sullo schermo (Home, Live o player)
    out property <bool> video-visible: root.playing || (root.page <= 1 && !root.no-source);

    callback play-index(int);
    callback cursor-moved(int);
    callback zap(int);
    callback pick-category(int);
    callback search-edited(string);
    callback request-pip(int);
    callback close-pip();
    callback toggle-fullscreen();
    callback verify-source(int, string, string, string);
    callback save-source(int, string, string, string);
    callback pick-file();
    callback activate-source(int);
    callback refresh-source(int);
    callback delete-source(int);
    callback set-language(int);
    callback setting-changed(string, string);
    callback load-tracks();
    callback select-audio(int);
    callback select-sub(int);
    callback cycle-aspect();
    callback playing-changed(bool);
    changed playing => { root.playing-changed(root.playing); }

    // apre il player sul canale in onda
    public function watch-current() {
        if (root.has-current) {
            root.close-pip();
            root.playing = true;
        }
    }
    function open-settings-sources() {
        root.settings-section = 0;
        root.page = 4;
    }

    // il bagliore di sfondo prende il colore della sezione
    if !root.playing: Rectangle {
        x: root.width - 760px;
        y: -380px;
        width: 1100px;
        height: 800px;
        background: @radial-gradient(circle, Theme.base.with-alpha(0.5) 0%, transparent 46%);
    }
    if !root.playing: Rectangle {
        x: -300px;
        y: root.height - 380px;
        width: 900px;
        height: 700px;
        background: @radial-gradient(circle, Theme.base.with-alpha(0.28) 0%, transparent 46%);
    }

    if !root.playing: VerticalLayout {
        TopBar {
            page <=> root.page;
            clock: root.clock;
            search <=> root.search;
            search-edited(text) => {
                root.search-edited(text);
                if (text != "") { root.page = 1; }
            }
            search-done => { root.live-focus-tick += 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            if root.page == 0: HomeScreen {
                hero: root.current;
                has-hero: root.has-current;
                no-source: root.no-source;
                categories: root.top-categories;
                play => { root.watch-current(); }
                pip => { root.request-pip(-1); }
                open-category(i) => {
                    root.pick-category(i);
                    root.page = 1;
                }
                add-source => { root.open-settings-sources(); }
            }
            if root.page == 1: LiveScreen {
                focus-tick: root.live-focus-tick;
                channels: root.channels;
                categories: root.categories;
                category: root.category;
                search: root.search;
                cursor <=> root.cursor;
                playing-id: root.has-current ? root.current.id : -1;
                no-source: root.no-source;
                play(i) => {
                    root.close-pip();
                    root.play-index(i);
                    root.playing = true;
                }
                pip(i) => { root.request-pip(i); }
                pick-category(i) => { root.pick-category(i); }
                cursor-moved(i) => { root.cursor-moved(i); }
                add-source => { root.open-settings-sources(); }
            }
            if root.page == 2: EmptyState {
                icon: Icons.guide;
                title: @tr("Program guide");
                body: @tr("The TV guide is coming in a next version of Sintonia.");
            }
            if root.page == 3: EmptyState {
                icon: Icons.film;
                title: @tr("Movies & series");
                body: @tr("Movies and series arrive with Xtream Codes sources, in a next version.");
            }
            if root.page == 4: SettingsScreen {
                section <=> root.settings-section;
                sources: root.sources;
                working: root.working;
                status: root.source-status;
                language: root.language;
                reconnect <=> root.reconnect;
                fullscreen-start <=> root.fullscreen-start;
                user-agent <=> root.user-agent;
                picked-file <=> root.picked-file;
                verify(k, n, l, u) => { root.verify-source(k, n, l, u); }
                save(k, n, l, u) => { root.save-source(k, n, l, u); }
                pick-file => { root.pick-file(); }
                activate-source(id) => { root.activate-source(id); }
                refresh-source(id) => { root.refresh-source(id); }
                delete-source(id) => { root.delete-source(id); }
                set-language(i) => { root.set-language(i); }
                setting-changed(k, v) => { root.setting-changed(k, v); }
            }
        }
        Dock {
            current <=> root.page;
            labels: [@tr("Home"), @tr("Live"), @tr("Guide"), @tr("Movies & series")];
        }
    }

    if root.playing: PlayerScreen {
        channels: root.channels;
        categories: root.categories;
        category: root.category;
        search: root.search;
        c: root.current;
        cursor <=> root.cursor;
        audio-tracks: root.audio-tracks;
        sub-tracks: root.sub-tracks;
        any-sub-selected: root.any-sub-selected;
        aspect: root.aspect;
        back => {
            root.playing = false;
            root.page = 1;
        }
        home => {
            root.playing = false;
            root.page = 0;
        }
        pip => {
            root.request-pip(-1);
            root.playing = false;
            root.page = 1;
        }
        toggle-fullscreen => { root.toggle-fullscreen(); }
        zap(d) => { root.zap(d); }
        play(i) => { root.play-index(i); }
        pick-category(i) => { root.pick-category(i); }
        load-tracks => { root.load-tracks(); }
        select-audio(id) => { root.select-audio(id); }
        select-sub(id) => { root.select-sub(id); }
        cycle-aspect => { root.cycle-aspect(); }
    }
}
