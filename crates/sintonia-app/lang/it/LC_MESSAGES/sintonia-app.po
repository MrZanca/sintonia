msgstr "Nuovo PIN (da 4 a 8 cifre)"

msgid "Repeat the PIN"
msgstr "Ripeti il PIN"

msgid "Set PIN"
msgstr "Imposta il PIN"

msgid "The two PINs are different."
msgstr "I due PIN sono diversi."

msgid "The PIN must have 4 to 8 digits, numbers only."
msgstr "Il PIN deve avere da 4 a 8 cifre, solo numeri."

msgid "PIN set. Now choose the categories to lock."
msgstr "PIN impostato. Ora scegli le categorie da bloccare."

msgid "PIN removed: nothing is locked any more."
msgstr "PIN tolto: non è più bloccato niente."

msgid "Enter the PIN to choose the locked categories."
msgstr "Inserisci il PIN per scegliere le categorie bloccate."

msgid "Enter PIN"
msgstr "Inserisci il PIN"

msgid "Lock now"
msgstr "Blocca ora"

msgid "Remove PIN"
msgstr "Togli il PIN"

msgid "Enter the PIN to confirm: nothing will be locked any more."
